		@ 092, 003 GET oInfoAdic VAR cInfoAdic OF oFolder1:aDialogs[4] MULTILINE SIZE 435, 087 COLORS 0, 16777215  READONLY HSCROLL PIXEL
		@ 003, 003 SAY oSay9 PROMPT "Informações Fisco:" SIZE 050, 007 OF oFolder1:aDialogs[4] COLORS 0, 16777215 PIXEL
		@ 083, 003 SAY oSay10 PROMPT "Informações Adicionais:" SIZE 062, 007 OF oFolder1:aDialogs[4] COLORS 0, 16777215 PIXEL
		@ 006, 011 SAY oSay1 PROMPT "Número:" SIZE 047, 007 OF oDlg COLORS 0, 16777215 PIXEL
		@ 006, 124 SAY oSay2 PROMPT "Série:" SIZE 019, 007 OF oDlg COLORS 0, 16777215 PIXEL
		@ 003, 043 MSGET oNFNum VAR cNFNum SIZE 076, 010 OF oDlg COLORS 0, 16777215 READONLY PIXEL
