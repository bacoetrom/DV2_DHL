		@ 003, 309 MSGET oNFSaida VAR cNFSaida SIZE 060, 010 OF oDlg COLORS 0, 16777215 READONLY PIXEL
		@ 020, 011 SAY oSay5 PROMPT "Natureza da Operação:" SIZE 058, 007 OF oDlg COLORS 0, 16777215 PIXEL
		@ 017, 068 MSGET oNFNatOper VAR cNFNatOper SIZE 092, 010 OF oDlg COLORS 0, 16777215 READONLY PIXEL
		@ 020, 167 SAY oSay6 PROMPT "Tipo da nota:" SIZE 035, 007 OF oDlg COLORS 0, 16777215 PIXEL
		@ 017, 200 MSCOMBOBOX oNFTipo VAR nNFTipo ITEMS {"N=Nomal","B=Beneficiamento","D=Devolução"} SIZE 072, 010 OF oDlg COLORS 0, 16777215 PIXEL
		@ 020, 280 SAY oSay11 PROMPT "Tipo:" SIZE 018, 007 OF oDlg COLORS 0, 16777215 PIXEL
		@ 016, 293 MSCOMBOBOX oTipo VAR nTipo ITEMS aCF WHEN .F. SIZE 077, 010 OF oDlg COLORS 0, 16777215 PIXEL
		@ 020, 376 SAY oSay15 PROMPT "Ped.Compra:" SIZE 030, 007 OF oDlg COLORS 0, 16777215 PIXEL	// Paulo Romualdo - 13/02/12
		@ 017, 410 MSGET oPedCom VAR ::cPedCom SIZE 035, 010 OF oDlg COLORS 0, 16777215 PIXEL    	// Paulo Romualdo - 13/02/12
		@ 252, 000 MSPANEL oRodPainel SIZE 450, 031 OF oDlg COLORS 0, 16777215 RAISED
		@ 012, 406 BUTTON oButton1 PROMPT "Salvar" SIZE 037, 012 OF oRodPainel ACTION {|| iif(valSalvar(nNFTipo,nTipo,oMSNewGe1:aHeader,oMSNewGe1:aCols),(aadd(@aRet, {nNFTipo,nTipo}), oDlg:end()),.f.) } PIXEL
		@ 012, 366 BUTTON oButton2 PROMPT "Cancelar" SIZE 037, 012 OF oRodPainel ACTION {|| aadd(@aRet, {"E","E"}), oDlg:end()} PIXEL
		
		//Data da útlima atualização para controlar as versões liberadas
		@ 012, 011 SAY oSay1 PROMPT "Última atualização: "+::getDataRpo("TimpNfe.prw") SIZE 200, 007 FONT oFont16n OF oRodPainel COLORS 0, 16777215 PIXEL
		
		// Don't change the Align Order
		oRodPainel:Align := CONTROL_ALIGN_BOTTOM
		
		ACTIVATE MSDIALOG oDlg CENTERED
		SetKey(VK_F6, {||})
		SetKey(VK_F7, {||})
		/*Reinicializa as váriavies privadas*/
		oEmit4 		:= nil
		oIdent4		:= nil
		oDest4 		:= nil
		oInfAdic4 	:= nil
		oCobr4  	:= nil
		/************************************/
	else
		aadd(@aRet, {nNFTipo,nTipo})
		aColsIt := aClone(aItens)
		return {aRet, aColsIt}
	endIf
	
	//Libera memoria apos o uso
	oNfe		:= Nil
	oEmit4 		:= Nil
	oIdent4		:= Nil
	oDest4 		:= Nil
	oInfAdic4 	:= Nil
	oCobr4  	:= Nil
	bVldCodProtheus := Nil
	bFillPro        := Nil
	oDestAux 	:= Nil
	aCamposEdit := Nil
	oFont16n 	:= Nil
	
return {aRet,oMSNewGe1:aCols}


/*/{Protheus.doc} valSalvar
Ponto de Entrada para validações no botão Salvar

@type		Function
@author 	Julio Lisboa
@since 		05/10/2016
@return		lRet
/*/
Static Function valSalvar( cNFTipo , cTipo , aHeader , aCols )
	
	Local lRet		:= .F.
	Local lTudoOk	:= ExistBlock("IPTudoOK",,LFORCES3)
	
	Default cNFTipo	:= ""
	Default cTipo	:= ""
	Default aHeader	:= {}
	Default aCols	:= {}
	
	lRet	:= vldSalvar(cNFTipo,cTipo)
	
	If lRet
		If lTudoOk
			lRet		:= ExecBlock("IPTudoOK", .f., .f., { cNFTipo , cTipo , aHeader , aCols  } )
		EndIf
	EndIf
	
Return lRet

/**
* Validação do Código Protheus
*
* @author Victor Hugo
* @since 23/09/2013
*/
static function vldCodProtheus(oGd, aHeader)
	
	local lOk	   			:= .T.
	local cReadVar 			:= ReadVar()
	local cProduto 			:= &cReadVar
	local aAreaSB1 			:= SB1->(GetArea())
	local lUpdDescProduto	:= GetNewPar("ZZ_XMLDPRD",.T.)
	
	if Empty(cProduto)
		return .T.
	endIf
	
	cProduto := PadR(cProduto, Len(SB1->B1_COD))
	
	SB1->(dbSetOrder(1))
	if SB1->(dbSeek(xFilial("SB1")+cProduto))
		//Alterado por Thiago Meschiatti - TOTVS IP - 30/09/2016 - INICIO
		if ( MV_PAR03 == 2 )
			If Empty(Alltrim(SB1->B1_SEGUM))
				oGd:aCols[oGd:nAt, GdFieldPos("un", aHeader)] := SB1->B1_UM
			Else
				oGd:aCols[oGd:nAt, GdFieldPos("un", aHeader)] := SB1->B1_SEGUM
			Endif
		elseif ( MV_PAR03 == 3 )
			oGd:aCols[oGd:nAt, GdFieldPos("un", aHeader)] := SB1->B1_UM
		Endif
		
		//Alterado por Niemeyer - 22/12/2016
		If lUpdDescProduto
			oGd:aCols[oGd:nAt, GdFieldPos("Descr", aHeader)] := SB1->B1_DESC
		Endif
		oGd:oBrowse:refresh()
		//Alterado por Thiago Meschiatti - TOTVS IP - 30/09/2016 - FIM
	else
		lOk := .F.
		MsgBox("Produto não encontrado", "Atenção", "ALERT")
	endIf
	
	RestArea(aAreaSB1)
	
return lOk

method license() Class TImpNfe
	::setlLicens(.F.)
	
	// SE EMPRESA TESTE
	If AllTrim(SM0->M0_CODIGO)="99"
		::setlLicens(.T.)
	EndIf
	
	// SE CNPJ INCLUIDO
	If SubStr(AllTrim(SM0->M0_CGC),1,8)$"10208861;09485332;12100162;12100162;12100162;11916190;05869791;07404801;07404801;10567241;07247209;00003485;00003533;00004197;00017235;00043532;00110160;00110410;00112870;00112871;00114410;00215370;00334600;00500073;00512015;00512026;00980206;20775003;21394473;50037463;51203932;51204023;51204024;51204031;51204214;55883094;43588045;06971283;46253225;03716531;30876130;03837320;07263994;12648020;55299440;13938567;14034069;55299440;06931598;15367585"
		::setlLicens(.T.)
	EndIf
	
return self

method VerSB1(cFornece,cLoja,cProduto,cUm) Class TImpNfe
	
	Local cRet := Space(TamSx3("B1_COD")[1])
	Local nAux := 0
	Local cAux := 0
	Local aAreaSB1 := SB1->(GetArea())
	
	cAux := cProduto
	IF Len(cAux) > TamSX3("B1_COD")[1]
		nAux := (TamSX3("B1_COD")[1]) * (-1)
		cAux := substr(cProduto,nAux)
	EndIf
	
	::chkPergs()
	
	if MV_PAR01 != 2 // Se considera Somente Amarração Produto x Fornecedor nao busca do SB1
		cRet := Posicione("SB1",1,xFilial("SB1")+PADR(cAux,TamSX3("B1_COD")[1]),"B1_COD")
	endIf
	
	If !Empty(cRet)
		::setProd(PADR(cAux,TamSX3("B1_COD")[1]))
	Else
		IF !lFornece
			//cProduto := cProduto+Space(TamSx3("A7_CODCLI")[1] - Len(cProduto))
			cAux := cProduto
			IF Len(cAux) > TamSX3("A7_CODCLI")[1]
				nAux := (TamSX3("A7_CODCLI")[1]) * (-1)
				cAux := substr(cProduto,nAux)
			EndIf
			cQry:= " SELECT SA7.A7_PRODUTO " + CRLF
			cQry+= " FROM "+RetSqlName("SA7")+" SA7 " + CRLF
			cQry+= " WHERE " + CRLF
			cQry+= " SA7.A7_CODCLI = '"+PADR(cAux,TamSX3("A7_CODCLI")[1])+"' " + CRLF // 15
			cQry+= " AND SA7.A7_CLIENTE = '"+cFornece+"' " + CRLF
			cQry+= " AND SA7.A7_LOJA = '"+cLoja+"' " + CRLF
			cQry+= " AND SA7.A7_FILIAL = '" + xFilial("SA7") + "' " + CRLF
			cQry+= " AND SA7.D_E_L_E_T_ = '"+Space(1)+"'" + CRLF
			TcQuery cQry Alias "QRY" New
			
			If QRY->(!EOF())
				cRet     := QRY->A7_PRODUTO
				::setProd(PADR(cAux,TamSX3("A7_CODCLI")[1]))
			EndIf
			
			QRY->(dbCloseArea())
		Else
			//cProduto := cProduto+Space(TamSx3("A5_CODPRF")[1] - Len(cProduto))
			cAux := cProduto
			IF Len(cProduto) > TamSX3("A5_CODPRF")[1]
				nAux := (TamSX3("A5_CODPRF")[1]) * (-1)
				cAux := substr(cProduto,nAux)
			EndIf
			cQry:= " SELECT SA5.A5_PRODUTO,SA5.A5_UNID " + CRLF
			cQry+= " FROM "+RetSqlName("SA5")+" SA5 " + CRLF
			cQry+= " WHERE " + CRLF
			cQry+= " SA5.A5_CODPRF = '"+PADR(cAux,TamSX3("A5_CODPRF")[1])+"' " + CRLF // 20
			cQry+= " AND SA5.A5_FORNECE = '"+cFornece+"' " + CRLF
			cQry+= " AND SA5.A5_LOJA = '"+cLoja+"' " + CRLF
			cQry+= " AND SA5.A5_FILIAL = '" + xFilial("SA5") + "' " + CRLF
			cQry+= " AND SA5.D_E_L_E_T_ = '"+Space(1)+"'" + CRLF
			TcQuery cQry Alias "QRY" New
			
			If QRY->(!EOF())
				cRet     := QRY->A5_PRODUTO
				::setProd(PADR(cAux,TamSX3("A5_CODPRF")[1]))
				::setUmFor(QRY->A5_UNID)
			EndIf
			
			QRY->(dbCloseArea())
		EndIf
	Endif
	
	//Alterado por Thiago Meschiatti - TOTVS IP - 30/09/2016 - INICIO
	// Achou o produto e deve considerar a UM do Cadastro
	if !Empty(cRet) .and. MV_PAR03 == 2
		cUm := Posicione("SB1",1,xFilial("SB1")+PADR(cRet, TamSX3("B1_COD")[1]),"B1_SEGUM")
		if empty(cUm)
			cUm := Posicione("SB1",1,xFilial("SB1")+PADR(cRet, TamSX3("B1_COD")[1]),"B1_UM")
		endif
	elseif !Empty(cRet) .and. MV_PAR03 == 3
		cUm := Posicione("SB1",1,xFilial("SB1")+PADR(cRet, TamSX3("B1_COD")[1]),"B1_UM")
	endIf
	//Alterado por Thiago Meschiatti - TOTVS IP - 30/09/2016 - FIM
	
	RestArea(aAreaSB1)
	
Return(cRet)


//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Obtem numero do item quando na preenchido pelo usuario             ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method getItemPC(cNumPC, cProduto) Class TImpNfe
	Local 	cItem		:= ""
	Local 	cAliasSC7	:= GetNextAlias()
	
	BeginSql Alias cAliasSC7
		SELECT C7_ITEM
		FROM %Table:SC7% C7
		WHERE
		C7_FILENT	= %xFilial:SC7% AND
		C7_NUM 		= %Exp:cNumPC% AND
		C7_PRODUTO 	= %Exp:cProduto% AND
		C7.%NotDel%
	EndSql
	
	If (cAliasSC7)->(!Eof())
		cItem := (cAliasSC7)->C7_ITEM
	EndIf
	
	(cAliasSC7)->(dbCloseArea())
	
Return (cItem)

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Obtem numero do item quando na preenchido pelo usuario             ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method getLocalItemPC(cNumPC, cItem, cProduto) Class TImpNfe
	Local 	cLocal		:= ""
	Local 	cAliasSC7	:= GetNextAlias()

	BeginSql Alias cAliasSC7
		SELECT C7_LOCAL
		FROM %Table:SC7% C7
		WHERE
		C7_FILENT	= %xFilial:SC7% AND
		C7_NUM 		= %Exp:cNumPC% AND
		C7_ITEM		= %Exp:cItem% AND		
		C7_PRODUTO 	= %Exp:cProduto% AND
		C7.%NotDel%
	EndSql

	If (cAliasSC7)->(!Eof())
		cLocal := (cAliasSC7)->C7_LOCAL
	EndIf

	(cAliasSC7)->(dbCloseArea())

Return (cLocal)

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Apresenta Log com as divergencias                                   ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method showLog(aLog, cNumNFE, cSerNfe) Class TImpNfe
	
	Local 	oLog
	Local 	nCntLog		:= 1
	Local 	cDirLog		:= GetNewPar("ZZ_INFLDIR","\LOGXMLNFE\")
	local 	cArqLog		:= DTOS(dDataBase)+"_"+Subst(Time(),1,2) + Subst(Time(),4,2) + Subst(Time(),7,2)+"_"+AllTrim(cNumNFE)+"_"+AllTrim(cSerNfe)
	
	oLog := SCLogger():New(cDirLog,cArqLog )
	oLog:StartProcess()
	For nCntLog := 1 To Len(aLog)
		oLog:WriteStr(aLog[nCntLog]+CRLF,.F.,.F.)
	Next nCntLog
	oLog:EndProcess()
	
	if !(::lAuto)
		If MsgYesNo("Documento "+Alltrim(cNumNFE)+"/"+Alltrim(cSerNFE)+" NÃO foi Importado !" + CRLF +"Deseja visualizar divergências ?")
			oLog:ViewRpt()
		EndIf
	endif
	
Return

/*ÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±± Verifica se existe mais de um fornecedor com mesmo CNPJ da NFe e, se existir, é   	±±
±± exibida uma tela para selecionar o fornecedor desejado. Essa medida foi necessária 	±±
±± devido a perda de referência no cadastro de Produto x Fornecedor(SA5).				±±
Ù±±ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ*/
method ChkForCli(cCnpj,lFor) class TImpNFe
	Local aCampos    := {}
	Local aArea      := SA2->(GetArea())
	Local cCodForCli := ""
	Local cLoja      := ""
	Local cTitulo    := ""
	Local cUf        := ""
	Local cQuery     := ""
	Local cAlias     := GetNextAlias()
	Local oDlg		 := Nil
	
	If lFor
		cQuery += "	SELECT " + CRLF
		cQuery += "  	A2_COD, A2_LOJA, A2_NOME, A2_MSBLQL, A2_EST " + CRLF
		cQuery += " FROM " + CRLF
		cQuery += "  " + RetSqlTab("SA2") + CRLF
		cQuery += " WHERE " + CRLF
		cQuery += "  	1=1 " + CRLF		
		cQuery += "  	AND " + RetSqlFil("SA2") + CRLF
		cQuery += "   	AND A2_CGC = '" + cCnpj + "'" + CRLF
		cQuery += "   	AND A2_MSBLQL <> '1' " + CRLF
		cQuery += "  	AND " + RetSqlDel("SA2") + CRLF
		
		cTitulo := "Fornecedores com CNPJ: "  + Transform(cCnpj,"@R 99.999.999/9999-99")
	Else
		cQuery += " SELECT " + CRLF
		cQuery += "  	A1_COD, A1_LOJA, A1_NOME, A1_MSBLQL, A1_EST " + CRLF
		cQuery += " FROM " + CRLF
		cQuery += "  " + RetSqlTab("SA1") + CRLF
		cQuery += " WHERE " + CRLF
		cQuery += "  	1=1 " + CRLF		
		cQuery += "  	AND " + RetSqlFil("SA1") + CRLF
		cQuery += "   	AND A1_CGC = '" + cCnpj + "'" + CRLF
		cQuery += "   	AND A1_MSBLQL <> '1' " + CRLF
		cQuery += "  	AND " + RetSqlDel("SA1") + CRLF		
		
		cTitulo := "Clientes com CNPJ: "  + Transform(cCnpj,"@R 99.999.999/9999-99")
	EndIf
	
	TcQuery cQuery new Alias &cAlias
	
	DbSelectArea(cAlias)
	
	Count to nCount
	(cAlias)->(DbGoTop())
	If nCount > 1
		While (cAlias)->(!EOF())
			If lFor
				AADD(aCampos,{(cAlias)->A2_COD,(cAlias)->A2_LOJA,(cAlias)->A2_NOME,;
					IIF(AllTrim((cAlias)->A2_MSBLQL) == "1","Sim","Não"),(cAlias)->A2_EST})
			Else
				AADD(aCampos,{(cAlias)->A1_COD,(cAlias)->A1_LOJA,(cAlias)->A1_NOME,;
					IIF(AllTrim((cAlias)->A1_MSBLQL) == "1","Sim","Não"),(cAlias)->A1_EST})
			EndIf
			(cAlias)->(DbSkip())
		EndDo
		if ::lAuto
			cCodForCli := aCampos[1][1]
			cLoja      := aCampos[1][2]
			::setRazao(AllTrim(aCampos[1][3]))
			cUf        := aCampos[1][5]
		else
			Aviso(cTitulo,"Existe mais de um " + IIF(lFor,"fornecedor","cliente") + " com o CNPJ: " + Transform(cCnpj,"@R 99.999.999/9999-99") + CRLF +;
				"Por favor selecionar o fornecedor desejado na tela seguinte.",{"OK"},2 )
			
			DEFINE MSDIALOG oDlg FROM 0,0 TO 200,600 PIXEL TITLE cTitulo
			oBrowse := TCBrowse():New(01,01, 300, 90,,,,oDlg,,,,,{||},,,,,,,,,.T.,,.F.,,,)
			oBrowse:AddColumn(TCColumn():New("Código"		,{||IIF(Len(aCampos) > 0,aCampos[oBrowse:nAt][1],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
			oBrowse:AddColumn(TCColumn():New("Loja"			,{||IIF(Len(aCampos) > 0,aCampos[oBrowse:nAt][2],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
			oBrowse:AddColumn(TCColumn():New("R. Social"	,{||IIF(Len(aCampos) > 0,aCampos[oBrowse:nAt][3],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
			oBrowse:AddColumn(TCColumn():New("Bloqueado"	,{||IIF(Len(aCampos) > 0,aCampos[oBrowse:nAt][4],"" ) },"",,,"LEFT",,.F.,.F.,,,,,))
			// Seta o vetor a ser utilizado
			oBrowse:SetArray(aCampos)
			oBrowse:bLDblClick := {|| cCodForCli := aCampos[oBrowse:nAt][1],;
				cLoja      := aCampos[oBrowse:nAt][2],;
				::setRazao(AllTrim(aCampos[oBrowse:nAt][3])),;
				cUf        := aCampos[oBrowse:nAt][5],;
				oDlg:End()}
			ACTIVATE MSDIALOG oDlg CENTERED
		endif
	Else
		If (cAlias)->(!EOF())
			If lFor
				cCodForCli := (cAlias)->A2_COD
				cLoja      := (cAlias)->A2_LOJA
				cUf        := (cAlias)->A2_EST
				::setRazao(AllTrim((cAlias)->A2_NOME))
			Else
				cCodForCli := (cAlias)->A1_COD
				cLoja      := (cAlias)->A1_LOJA
				cUf        := (cAlias)->A1_EST
				::setRazao(AllTrim((cAlias)->A1_NOME))
			EndIf
			Return {cCodForCli,cLoja,cUf}
		Else
			// Se a query não retornar nenhum registro, retorna array vazio
			Return {}
		EndIf
	EndIf
	
	RestArea(aArea)
return {cCodForCli,cLoja,cUf}

/******************************************************************************
+-----------------------------------------------------------------------------+
| DATA:	01/10/2013					|   Módulo: Importador XML                 |
|-----------------------------------------------------------------------------|
|Rotina: VerSC7						| Analista: Yves Oliveira      		        |
|-----------------------------------------------------------------------------|
|Descrição: Verifica se existe item do pedido de compra                       |
+-----------------------------------------------------------------------------+
******************************************************************************/
method VerSC7(cNum,cItem,cProd) CLASS TIMPNFE
	Local cQuery     := ""
	Local cAlias     := GetNextAlias()
	Local lRet 		:= .F.
	
	cQuery += "SELECT COUNT(*) CONTADOR"               + CRLF
	cQuery += "  FROM " + RetSqlTab("SC7")             + CRLF
	cQuery += " WHERE D_E_L_E_T_ = ' '"                + CRLF
	cQuery += "   AND C7_FILIAL  = '" + xFilial("SC7") + "'"
	cQuery += "   AND C7_NUM     = '" + cNum  + "'"    + CRLF
	cQuery += "   AND C7_ITEM    = '" + cItem + "'"    + CRLF
	cQuery += "	AND C7_PRODUTO = '" + cProd + "'"    + CRLF
	cQuery += "	AND C7_QUJE < C7_QUANT " //apenas pedidos não atendidos totalmente
	
	TcQuery cQuery new Alias &cAlias
	
	DbSelectArea(cAlias)
	(cAlias)->(DbGoTop())
	If (cAlias)->CONTADOR == 1
		lRet := .T.
	EndIf
	(cAlias)->(DbCloseArea())
return lRet

/******************************************************************************
+-----------------------------------------------------------------------------+
| DATA:	11/10/2013					|   Módulo: Importador XML                 |
|-----------------------------------------------------------------------------|
|Rotina: FillCodPro  				| Analista: Yves Oliveira      		        |
|-----------------------------------------------------------------------------|
|Descrição: Preenche código do produto após selecionar o item do pedido.      |
+-----------------------------------------------------------------------------+
******************************************************************************/
METHOD FillCodPro(oMSNewGe1,aHeaderIt) CLASS TIMPNFE
	Local aArea   := GetArea()
	Local cCodPro := ""
	
	If Type("ItemPc") != "U" //quando digitado o número do item pedido
		cCodPro := Posicione("SC7",1,xFilial("SC7") + GdFieldGet("NumPc",oMSNewGe1:nAt) + ItemPc,"C7_PRODUTO")
	Elseif Type("NumPc") != "U" //quando digitado o número do pedido
		cCodPro	:= Posicione("SC7",1,xFilial("SC7") + NumPc + GdFieldGet("ItemPc",oMSNewGe1:nAt),"C7_PRODUTO")
	EndIf
	// Sempre substitui o código do produto Protheus para não quebrar regra de negócio de produto do pedido de compra
	// e futuramente dar baixa em item do pedido errado na classificação do documento de entrada.
	//If Empty(GdFieldGet("CodProt",oMSNewGe1:nAt)) .And. !Empty(cCodPro)
	GdFieldPut("CodProt",cCodPro,oMSNewGe1:nAt)
	//EndIf
	RestArea(aArea)
RETURN .T.

/******************************************************************************
+-----------------------------------------------------------------------------+
| DATA:	11/10/2013					|   Módulo: Importador XML                |
|-----------------------------------------------------------------------------|
|Rotina: GetPedidos  				| Analista: Yves Oliveira      		      |
|-----------------------------------------------------------------------------|
|Descrição: Preenche código do produto após selecionar o item do pedido.      |
+-----------------------------------------------------------------------------+
******************************************************************************/
METHOD GetPedidos(cCodFor,cLojFor,oMSNewGe1) CLASS TIMPNFE
	Local aArea   := GetArea()
	Local cQuery   := ""
	Local cAlias   := GetNextAlias()
	Local aPedidos := {}
	Local cTitulo  := "Selecionar Pedido de Compra <F6>"
	Local nCont    := 0
	Local cPedidos := ""
	Local aPedAux := {}
	Local nPosPed  := 0
	Local cCodPro  := GdFieldGet("CodProt",oMSNewGe1:nAt,.F.,oMSNewGe1:aHeader,oMSNewGe1:aCols)
	Local lToler   := FindFunction("MA103CkAIC") .And. MA103CkAIC(cCodFor,cLojFor,cCodPro)
	Local nI	   := 0
	// Desativando hotkey para não abrir mais de uma janela
	SetKey(VK_F6, {||})
	SetKey(VK_F7, {||})
	
	//Verificando os pedidos e itens já preenchidos
	For nCont := 1 To Len(oMSNewGe1:aCols)
		If !Empty(oMSNewGe1:aCols[nCont][10]) .And. !Empty(oMSNewGe1:aCols[nCont][11])
			nPosPed := aScan(aPedAux,{|X|X[1] == oMSNewGe1:aCols[nCont][10] .and. X[2] == oMSNewGe1:aCols[nCont][11]})
			If nPosPed == 0
				aAdd(aPedAux,{oMSNewGe1:aCols[nCont][10],oMSNewGe1:aCols[nCont][11],oMSNewGe1:aCols[nCont][6]})
			Else
				aPedAux[nPosPed,3] += oMSNewGe1:aCols[nCont][6]
			EndIf
		EndIf
	Next nCont
	
	cQuery := "SELECT C7_NUM,C7_ITEM,C7_PRODUTO,C7_DESCRI, C7_UM,C7_SEGUM,C7_QUANT "
	cQuery += " FROM "+RetSqlName("SC7") + " SC7 "
	cQuery += " WHERE "
	// INÍCIO MATHEUS ABRÃO 20/09/2016
	// ALTERADO FILTRO ABAIXO PARA CONSULTA NA FILIAL DE ENTREGA PARA A BUSCA DOS PEDIDOS
	// OCORRER IGUAL AO PADRÃO (INCLUSÃO DE PRÉ NOTA)
	//cQuery += "C7_FILIAL = '"+xFilial("SC7")+"' AND "
	cQuery += " C7_FILENT = '" + (xFilial("SC7")) + "' AND "
	// FIM MATHEUS ABRÃO 20/09/2016
	cQuery += " C7_FORNECE = '"+cCodFor+"' AND "
	cQuery += " C7_LOJA = '"+cLojFor+"' AND "
	//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
	//³ Filtra os Pedidos Bloqueados e Previstos.                ³
	//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
	cQuery += "C7_TPOP <> 'P' AND "
	If SuperGetMV("MV_RESTNFE") == "S"
		cQuery += "C7_CONAPRO <> 'B' AND "
	EndIf
	If !lToler
		cQuery += " SC7.C7_ENCER='"+Space(Len(SC7->C7_ENCER))+"' AND "
	EndIf
	//Se o produto estiver preenchido, filtra os pedidos do produto em questão
	If !Empty(cCodPro)
		cQuery += " SC7.C7_PRODUTO = '" + cCodPro + "' AND "
	EndIf
	cQuery += " SC7.C7_RESIDUO='"+Space(TamSx3("C7_RESIDUO")[1])+"' AND "
	cQuery += " SC7.D_E_L_E_T_ = ' ' "
	cQuery += " ORDER BY C7_NUM,C7_ITEM"
	cQuery := ChangeQuery(cQuery)
	
	TcQuery cQuery new Alias &cAlias
	
//	MemoWrite("TOTVSIPImportadorXMLGetPedidos1", cQuery)	//	Para depuração de cod.
	
	DbSelectArea(cAlias)
	(cAlias)->(DbGoTop())
	
	While (cAlias)->(!EOF())
		nPosPed := aScan(aPedAux,{|X|X[1] == (cAlias)->C7_NUM .and. X[2] == (cAlias)->C7_ITEM})
		If (	Empty(aPedAux)) .or.;
				(!Empty(aPedAux) .and. nPosPed > 0 .and. (cAlias)->C7_QUANT > aPedAux[nPosPed,3]) .or.;
				(!Empty(aPedAux) .and. nPosPed == 0)
			AADD(aPedidos,{(cAlias)->C7_NUM,(cAlias)->C7_ITEM,(cAlias)->C7_PRODUTO,(cAlias)->C7_DESCRI,;
				(cAlias)->C7_UM,(cAlias)->C7_SEGUM,(cAlias)->C7_QUANT})
		EndIf
		(cAlias)->(DbSkip())
	EndDo
	
	oDlgPed := Nil
	if !Empty(aPedidos)
		DEFINE MSDIALOG oDlgPed FROM 0,0 TO 200,600 PIXEL TITLE cTitulo
		oBrowse := TCBrowse():New(01,01, 300, 90,,,,oDlgPed,,,,,{||},,,,,,,,,.T.,,.F.,,,)
		oBrowse:AddColumn(TCColumn():New("Número PC"  ,{||IIF(Len(aPedidos) > 0,aPedidos[oBrowse:nAt][1],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
		oBrowse:AddColumn(TCColumn():New("Item"	 	  ,{||IIF(Len(aPedidos) > 0,aPedidos[oBrowse:nAt][2],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
		oBrowse:AddColumn(TCColumn():New("Produto"    ,{||IIF(Len(aPedidos) > 0,aPedidos[oBrowse:nAt][3],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
		oBrowse:AddColumn(TCColumn():New("Descrição"  ,{||IIF(Len(aPedidos) > 0,aPedidos[oBrowse:nAt][4],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
		oBrowse:AddColumn(TCColumn():New("Unidade"	  ,{||IIF(Len(aPedidos) > 0,aPedidos[oBrowse:nAt][5],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
		oBrowse:AddColumn(TCColumn():New("Segunda UM" ,{||IIF(Len(aPedidos) > 0,aPedidos[oBrowse:nAt][6],"" ) },"@!",,,"LEFT",,.F.,.F.,,,,,))
		oBrowse:AddColumn(TCColumn():New("Quantidade" ,{||IIF(Len(aPedidos) > 0,aPedidos[oBrowse:nAt][7],"" ) },PesqPict("SC7","C7_QUANT"),,,"LEFT",,.F.,.F.,,,,,))
		// Seta o vetor a ser utilizado
		oBrowse:SetArray(aPedidos)
		oBrowse:bLDblClick := {|| oMSNewGe1:aCols[oMSNewGe1:nAt][10] := aPedidos[oBrowse:nAt][1],;//Item
		oMSNewGe1:aCols[oMSNewGe1:nAt][11] := aPedidos[oBrowse:nAt][2],;//Pedido
		oMSNewGe1:aCols[oMSNewGe1:nAt][3]  := aPedidos[oBrowse:nAt][3],;//Cod.Produto		
		oMSNewGe1:oBrowse:Refresh(),;
			oDlgPed:End()}
		
		//oMSNewGe1:aCols[oMSNewGe1:nAt][5]  := aPedidos[oBrowse:nAt][5],;//UM //Retirado por Niemeyer - 01/09/2016 - Afetando conversão de 2UM
		
		ACTIVATE MSDIALOG oDlgPed CENTERED
	else
		MsgBox("Não existem pedidos a serem exibidos.", "Atenção", "ALERT")
	endIf
	
	// Reativando hotkey
	SetKey(VK_F6, {|| ::GetPedidos(cFornece,cLoja,oMSNewGe1) })
	SetKey(VK_F7, {|| ::ClearPC(@oMSNewGe1)})
	(cAlias)->(DbCloseArea())
	RestArea(aArea)
RETURN


/******************************************************************************
+-----------------------------------------------------------------------------+
| DATA:	11/10/2013					|   Módulo: Importador XML                |
|-----------------------------------------------------------------------------|
|Rotina: ClearPC     				| Analista: Yves Oliveira      		      |
|-----------------------------------------------------------------------------|
|Descrição: Limpa os pedidos de compra preenchidos						      |
+-----------------------------------------------------------------------------+
******************************************************************************/
METHOD ClearPC(oMSNewGe1) CLASS TIMPNFE
	oMSNewGe1:aCols[oMSNewGe1:nAt][10] := "" //NumPC
	oMSNewGe1:aCols[oMSNewGe1:nAt][11] := "" //ItemPc
RETURN

/**
* Verifica o Grupo de Perguntas
*
* @author Victor Hugo
* @since 23/09/2013
*/
method chkPergs() class TImpNfe
	
	Pergunte(::cPerg, .F.)
	
return


/**
* Retorna data do fonte no RPO
*
* @author Thiago Meschiatti
* @since 11/08/2015
*/
method getDataRpo(cFunc) class TImpNfe
	local cRet	:= ""
	
	if len(GetApoInfo(cFunc)) > 3
		if ValType(GetApoInfo(cFunc)[DATA_RPO]) == "D"
			cRet := alltrim(dtoc(GetApoInfo(cFunc)[DATA_RPO]))
		else
			cRet := alltrim(GetApoInfo(cFunc)[DATA_RPO])
		endif
	endif
	
return (cRet)

/**
* Retorna se o produto controla lote
*
* @author Gustavo Luiz
* @since 13/02/2019
*/
method isProdutLote(cCodProd) class TImpNfe
	
	local lIsProdlote	:= .F.
	local aArea 		:= getArea()
	local aAreaSB1 		:= SB1->(getArea())
	local cChaveSB1		:= ""
	
	cCodProd := padr(cCodProd, tamSx3("B1_COD")[1], "")
	cChaveSB1:= fwxFilial("SB1") + cCodProd
	
	SB1->(dbSetOrder(1))
	
	if SB1->(dbSeek(cChaveSB1))
		if SB1->B1_RASTRO = "L"
			lIsProdlote := .T.
		endif
	endIf
	
	restArea(aAreaSB1)
	restArea(aArea)
	
return lIsProdlote


/*/{Protheus.doc} vldSalvar
Função responsavel por validar a ação do botão "Salvar" da tela criada pelo method view2
@author Tiago Faria
@since 27/08/2014
@version 1.0
@param cNFTipo, caracter, variavel recebe o tipo da nota "N" = normal "B" = beneficiamento "F" = fornecedor
@param cTipo, caracter, variavel recebe o tipo "C" = cliente "F" = fornecedor
@return lRet, logico, se .t. continua com a gravação da nota, se .f. não grava a nota
/*/
Static Function vldSalvar(cNFTipo,cTipo)
	Local lRet := .t.
	
	If cNfTipo == "N" .and. cTipo == "C"
		MsgBox("Para o 'Tipo da nota:' NORMAL obrigatoriamente o 'Tipo:' deve ser FORNECEDOR","","ALERT")
		lRet := .f.
	EndIf
return lRet

/*
*	Função responsável pelo tratamento da data.
*/
static function trataData(cData)
	dData	:= STOD(STRTRAN(cData,"-",""))
return dData

/**
*	obtém a quantidade de rastros do SKU em processamento
**/
static function getQtdRastro(oDet, nI)
	
	local nQtdRastro := 0
	private oDetAux  := oDet
	
	if type("oDetAux[" + cValToChar(nI) + "]:_PROD:_RASTRO") == "O"
		nQtdRastro := 1
	elseIf type("oDetAux[" + cValToChar(nI) + "]:_PROD:_RASTRO") == "A"
		nQtdRastro := len(oDetAux[nI]:_PROD:_RASTRO)
	endif
	
	//Libera memoria apos o uso
	oDetAux := Nil
	
return nQtdRastro

/**
*	Obtém a data de validade e fabricação do rastro
**/
static function getDtValFabrRastro(aItem, aDet)
	
	local cCpoDtFabr	:= AllTrim(GetNewPar("ZZ_CPODTFA", ""))
	local nPosDFabric	:= Ascan(aItem,{|x| Upper(AllTrim(x[01]))==cCpoDtFabr})
	local nPosDValid	:= Ascan(aItem,{|x| Upper(AllTrim(x[01]))=="D1_DTVALID"})
	local lGetDtFab		:= .T.
	
	if ValType(aDet[14]) != "N"	
		aItem[nPosDValid][2]   := IIf(ValType(aDet[14]) = "D",aDet[14],CtoD(aDet[14]))
			If nPosDFabric > 0
				aItem[nPosDFabric][2]  := IIf(ValType(aDet[15]) = "D",aDet[15],CtoD(aDet[15]))
			EndIf
	else
		MsgInfo("Data de fabricação: Tipo de dado inválido. Em execução o tipo " + getTipoDado(aDet[14]) + ". Esperado o tipo DATA. Verifique!")
		lGetDtFab := .F.
	endIf
	
return lGetDtFab

/**
*	Obtém o indice do oDET. Depois do ajuste para considerar os rastros de uma mesma SKU, agora o tamanho do oDet
* pode ser diferente do aDet. Sendo assim, retorna o indice referente a primeira ocorrencia do aDet
**/
static function getIndDet(aDet, cProduto)
	
	local nScan			:= 0
	local nIndDet		:= 0
	
	nIndDet			:= aScan(aDet, {|x| allTrim(x) == allTrim(cProduto)})
	
return  nIndDet

/**
*	Aglutina o aDet quando mesmo produto
**/
static function aglutDet(aDet, aDetAglutin)
	
	local nI 		:= 0
	local nScan		:= 0
	local cProduto	:= ""
	
	for nI := 1 to len(aDet)
		
		cProduto := aDet[nI][3]
		
		nScan 	 := aScan(aDetAglutin, {|x| allTrim(x) == allTrim(cProduto)})
		
		if nScan == 0
			aAdd(aDetAglutin, cProduto)
		endIf
		
	next nI
	
return

/**
* appenda no array aDados as datas de validade e fabricação do rastro
**/
static function appendDtRastro(aDados, cDataLtVal, cDataLtFab)
	
	if len(aDados) >= 15
		if valtype(aDados[14]) = "D" .and. valtype(aDados[15]) = "D"
			aDados[14] := cValToChar(sTod(cDataLtVal))
			aDados[15] := cValToChar(sTod(cDataLtFab))
		endif
	else
		aAdd(aDados,	cValToChar(sTod(cDataLtVal)))
		aAdd(aDados,	cValToChar(sTod(cDataLtFab)))
	endif
	
return

/*
Retorna o tipo da variável
*/
Static Function fTypeVar(cVar)
Return Type(cVar)

/**
*	Função responsável pelo tratamento da data.
**/
static function formatDate(cData)
	
	local cNewDate  := ""
	local cDia		:= ""
	local cMes		:= ""
	local cAno		:= ""
	
	cAno := substr(cData, 1, 4)
	cMes := substr(cData, 6, 2)
	cDia := substr(cData, 9, 2)
	
	cNewDate := cAno + cMes + cDia
	
return cNewDate

/**
* retorna o tipo de dado da variável
**/
static function getTipoDado(xTipoDado)
	
	local cTipoDado := ""
	
	if ValType(xTipoDado) == "N"
		cTipoDado := "NUMÉRICO"
	endIf
	
return cTipoDado
