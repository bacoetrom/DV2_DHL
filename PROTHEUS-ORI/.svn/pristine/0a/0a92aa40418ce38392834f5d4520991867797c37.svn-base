	Data aCab		//Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	Data aItens		//Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	Data lModeSimula //Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	
	method new(cDirOri, cArqXML, lModeSimula) CONSTRUCTOR
