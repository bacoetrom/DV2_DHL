/*ÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ±±
±± Visualiza a nota a ser importada					                       ±±
Ù±±ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÁÄÄÄÄÄÄÁÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ*/
method view2(aCF,aitens,aTotal,aDup) Class TImpNfe
	Local oNF2    	:=  nil
	
	Local oEmit 	:= ::GetEmitente()
	Local oIdent	:= ::GetIdent()
	Local oDest 	:= ::GetDest()
	Local oInfAdic  := ::GetInfAdic()
	Local oCobr  	:= ::GetCobr()
	Local cMsg		:= "Informação não disponível"
	Local oButton1
	Local oButton2
	Local oDestCNPJ
	Local cDestCNPJ := ""//IIf(Type("oDest:_CNPJ") == "O", transform(oDest:_CNPJ:Text,PesqPict("SA1","A1_CGC")), transform(oDest:_CPF:Text,"@R 999.999.999-99" ))
	Local oDestRazao
	Local cDestRazao := ""
	Local oEmiCNPJ
	Local cEmiCNPJ := transform(::GetCNPJ(),PesqPict("SA1","A1_CGC") )
	Local oEmiRazao
	Local cEmiRazao := ::GetRazao()
	Local oFolder1
	Local oInfoAdic
	Local cInfoAdic := ""
	Local oInfoFisco
	Local cInfoFisco :=  ""
	Local oNFEmissao
	Local cNFEmissao
	Local oNFNatOper
	Local cNFNatOper := AllTrim(oIdent:_NATOP:Text)
	Local oNFNum
	Local cNFNum
	Local oNFSaida
	Local cNFSaida := ""
	Local oNFSer
	Local cNFSer := AllTrim(oIdent:_Serie:Text)
	Local oNFTipo
	Local nNFTipo := "N"
	Local oPedCom
	Local oRodPainel
	Local oSay1
	Local oSay10
	Local oSay11
	Local oSay12
	Local oSay13
	Local oSay14
	Local oSay15
	Local oSay2
	Local oSay3
	Local oSay4
	Local oSay5
	Local oSay6
	Local oSay7
	Local oSay8
	Local oSay9
	Local oTipo
	Local nTipo   := "F"
	Local aVetor  := {}
	Local aVetor2 := {}
	Local aVetor3 := {}
	Local aRet 	  := {}
	Local aColsIt := {}
	Local aHeaderIt := {}
	Local oMSNewGe1 := nil
	Local aButtons := {}
	Local cCpoDtFabr:= AllTrim(GetNewPar("ZZ_CPODTFA", ""))
	Static oDlg
	
	/*
	Essas variáveis foram declaradas para fazer a validação usando o type
	*/
	Private oNfe		:= ::getNfe()
	Private oEmit4 		:= oEmit
	Private oIdent4		:= oIdent
	Private oDest4 		:= oDest
	Private oInfAdic4 	:= oInfAdic
	Private oCobr4  	:= oCobr
	Private bVldCodProtheus := {|| vldCodProtheus(@oMSNewGe1, aHeaderIt) }
