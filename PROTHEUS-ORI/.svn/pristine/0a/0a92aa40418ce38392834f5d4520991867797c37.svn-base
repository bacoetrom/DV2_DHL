		oWBro3  := TWBrowse():New( 005, 003,447, 089,,{"Vencimento","Nr. Titulo","Valor"},{35,60,60,60,60,60,60},oFolder1:aDialogs[3],,,,,{||},,,,,,,.F.,,.T.,,.F.)	
