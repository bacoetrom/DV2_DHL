		oMSNewGe1 := MsNewGetDados():New( 043, 001, 152,447,GD_UPDATE, "AllwaysTrue", "AllwaysTrue", "", aCamposEdit ,, 999, "AllwaysTrue", "", "AllwaysTrue", oFolder1:aDialogs[1], aHeaderIt,@aColsIt)
