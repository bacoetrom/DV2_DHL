method new(cDirOri, cArqXML, lModeSimula) Class TImpNfe
	
	Local nPosFil							:= 0
	Local oIPLicense						:= nil
	Local nSequenceArtifact					:= 0
	Local cCodeArtifact						:= IMPORTADOR_DE_XML_CODE
	Local cExtensao							:= ""
	Local cNameArtifact						:= ""
	Local lOnlyTestCompany					:= .f.
	Local lNoCheckLicenseInTestCompany		:= .t.
	Local cMsg								:= ""
	Local cMsgError							:= ""
	Local lForceLicenseFile					:= .f.
	Local lRet								:= .f.	
	
	Local	bExecute	:=	{|| ::Execute()}
	
	private oImpNFeAux	:= NIL
	private cFiltArq	:= "*.xml"
	
	DEFAULT cArqXML 	:= ""
	default lModeSimula := .f. //Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	
	if type("aLogAuto") == "U"
		aLogAuto := {}
	endif
	
	::lAuto			:= GetRemoteType() == -1 //isBlind()	
	
	//Define os dados do Licenciamento internamente na classe IpLicense, buscando o licenciamento do cliente internamente ou em arquivo xml fornecido
	If ExistBlock("IPLicense",,LFORCES3)
		oIPLicense 	:= IPLicense():newIPLicense()
		oIPLicense:setLimitCheck(0)
		If oIPLicense:setInternalLicense( nSequenceArtifact , cCodeArtifact , cNameArtifact, lOnlyTestCompany, lNoCheckLicenseInTestCompany)
			If oIPLicense:checkLicense(@cMsgError,lForceLicenseFile)
				lRet := .T.
				If !( oIPLicense:isAlreadyChecked() )
					cMsg := "Uso Autorizado para o Artefato '" + oIPLicense:getCodeArtifact() + " - " + oIPLicense:getNameArtifact() + "' - CNPJ: " + oIPLicense:getCNPJCompany()
				Endif
			Else
				cMsg := "Uso Não Autorizado para o Artefato '" + oIPLicense:getCodeArtifact() + " - " + oIPLicense:getNameArtifact() + "' - CNPJ: " + oIPLicense:getCNPJCompany() + " - Motivo: " + cMsgError
			Endif
		Else
			cMsg := "Não Localizado o Artefato a ser Licenciado."
		Endif
	Else
		cMsg := "Objeto de Licenciamento da TOTVS IP não encontrado."
	Endif
	
	If !lRet
		::setSuccess(.f.)
		cMsg += " A conexão será encerrada."
		If IsBlind() .Or. ::lAuto
			aadd(aLogAuto, cMsg)
		Else
			MsgStop(cMsg,"TOTVS IP")
			u_IPLicenseView(oIPLicense)
		Endif
		return
	Else
		If !Empty(cMsg)
			aadd(aLogAuto, cMsg)
		Endif
	Endif
	
	::setCab({})					//Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	::setItens({})					//Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	::setModeSimula(lModeSimula)  //Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	
	::Filex 		:= Space(100)
	::Titulo 		:= "Selecione o arquivo"
	::Titulo2 		:= "Selecione uma pasta"
	::Extensao 		:= "Arquivos XML | *.xml"
	::Extensao2 	:= "Pasta com arquivos XML | *.xml"
	::cPedCom		:= Space(TamSx3("C7_NUM")[1])
	::cPerg			:= "TIMPNFE"
	::setSuccess(.f.)
	::chkPergs()
	
	// If abaixo corresponde a chamada do importador XML atraves da rotina de Gestão de XML
	// Nesse caso o controle de licença é feito pelo Gestão de XML
	If !Empty(cArqXML)
		::Filex := cDirOri + cArqXML
		Processa(bExecute,"Importando Documento ...")
	Else
		cExtensao			:= ::Extensao
		
		// Ponto de entrada para que seja possível informar um filtro para o nome do arquivo.
		// Caso seja utilizado, o botão "Por: Diretório", será desabilitado
		if existBlock("IPExtensao",,LFORCES3)
			cExtensao := execBlock("IPExtensao", .f., .f., cExtensao)
			if !empty(cExtensao) .and. valType(cExtensao) == "C" .and. cExtensao != ::Extensao
				::Extensao		:= cExtensao
				
				nPosFil		:= At("| ", cExtensao)
				If nPosFil > 0
					cFiltArq	:= SubStr( cExtensao , nPosFil + 2 , Len(cExtensao) )
				EndIf
			endIf
		endIf
		
		SetKey(VK_F12, {|| Pergunte(::cPerg, .T.) })
		
		@ 200,001 TO 455,335 DIALOG ::Dlg TITLE "Importacao - NFe"
		//@ 003,003 TO 125,168
		
		@ 010,015 SAY "Esta rotina ira Gerar Pre-Notas de Entrada a partir de um" PIXEL OF ::Dlg
		@ 020,015 SAY "Arquivo ou Diretório de Nota Fiscal Eletronica selecionado." PIXEL OF ::Dlg
		
		@ 040,015 SAY "Arquivo/Diretório XML da NFe" PIXEL OF ::Dlg
		@ 050,015 MSGET oGetFile VAR ::Filex SIZE 140,006 PIXEL OF ::Dlg
		
		@ 063,015 BUTTON "Por: Arquivo" 	SIZE 068,010						ACTION {|| ::Filex := cGetFile(::Extensao, ::Titulo,,  cDirOri,.t.,GETF_LOCALHARD + GETF_LOCALFLOPPY + GETF_NETWORKDRIVE )} PIXEL OF ::Dlg
		@ 063,085 BUTTON "Por: Diretório"	SIZE 068,010						ACTION {|| ::Filex := cGetFile(::Extensao2,::Titulo2,1,cDirOri,.f.,GETF_RETDIRECTORY+ GETF_LOCALHARD+GETF_NETWORKDRIVE,.f.,.f.)} PIXEL OF ::Dlg
		@ 110,080 BUTTON "Importar"			SIZE 035,012						ACTION Processa(bExecute, "Importando Documento ...")  PIXEL OF ::Dlg
		@ 110,120 BUTTON "Sair"				SIZE 035,012						ACTION Close(::Dlg) PIXEL OF ::Dlg
		
		ACTIVATE DIALOG ::Dlg CENTERED
		
		SetKey(VK_F12, {||})
		
	Endif
	
	//Libera memoria apos o uso
	oImpNFeAux	:= Nil
	cFiltArq	:= Nil
	
return self
//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Executa a importação		                                            ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method execute() Class TImpNfe
	Local aCF				:= {}
	Local aChkLayout		:= {}
	Local aLoadInfo			:= {}
	Local aArquivos			:= {}
	local nContador			:= 1
	local j					:= 0
	local lFolder			:= .F.
	
	Private sPasta			:= ""
	Private sNomeArquivo	:= ""
	Private cFornece		:= ""
	Private cLoja			:= ""
	Private cUF				:= ""
	Private lFornece		:= .T.
	
	oImpNFeAux := self
	
	// verifica se o caminho selecionado é um folder ou um arquivo
	if SUBSTR(::getFile(),len(::getFile()),1) == '\'
		
		//Filtra os arquivos do diretório
		aArquivos	:= Directory( ::getFile() + cFiltArq ) // cFiltArq := "*.xml"
		
		nContador 	:= Len(aArquivos)
		sPasta   	:= ::getFile()
		lFolder		:= .T.
	endif
	
	//Tratativa para quando não for localizado nenhum arquivo no diretório
	If nContador == 0
		if ::lAuto
			FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "Não foram localizados arquivos [" + cFiltArq + "] no diretório [" + ::getFile() + "]", 0, 0, {})
			aadd(aLogAuto, "A - Não foram localizados arquivos [" + cFiltArq + "] no diretório [" + ::getFile() + "]")
		Else
			Help("",1,"IMPXML","","A - Não foram localizados arquivos [" + cFiltArq + "] no diretório [" + ::getFile() + "]",4,1)
		EndIf
		Return
	EndIf
	
	for j := 1 to nContador
		If sPasta != ""
			::setFile(sPasta+aArquivos[j][1])
		endif
		// sNomeArquivo Recebe o nome do arquivo para ser informado no alerta
		sNomeArquivo := SUBSTR(::getFile(),(1+RAT("\",::getFile())),(len(::getFile()) - RAT(::getFile(),"\") ))
		If !::chkFile()
			if ::lAuto
				FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "Arquivo: "+ sNomeArquivo+" nao encontrado", 0, 0, {})
				aadd(aLogAuto, "A - Arquivo: "+ sNomeArquivo+" nao encontrado")
			else
				Help("",1,"IMPXML","","Arquivo: "+ sNomeArquivo+" nao encontrado",4,1)
			endif
			Return
		else
			::loadObject()
			aChkLayout := ::chkNFeLayout()
			If !aChkLayOut[2]
				aChkLayOut:= ::ChkCTELayOut()
			Endif
			if !achkLayout[1]
				if ::lAuto
					FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "Arquivo XML("+ sNomeArquivo +") não foi carregado!!", 0, 0, {})
					aadd(aLogAuto, "A - Arquivo XML("+ sNomeArquivo +") não foi carregado!!")
				else
					MsgBox("Arquivo XML("+ sNomeArquivo +") não foi carregado!!","","ALERT")
				endif
				Return()
			elseif !achkLayout[2]
				if ::lAuto
					FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "O Arquivo XML("+ sNomeArquivo +") possui NFe/CTe invalido!!", 0, 0, {})
					aadd(aLogAuto, "A - O Arquivo XML("+ sNomeArquivo +") possui NFe/CTe invalido!!")
				else
					MsgBox("O Arquivo XML("+ sNomeArquivo +") possui NFe/CTe invalido!!","","ALERT")
				endif
				Return()
			else
				aLoadInfo :=  ::loadInfo()
				if len(aloadInfo[2]) > 0
					
					aCF := ::view2(aloadInfo[1],aloadInfo[2],aloadInfo[3],aloadInfo[4])
					IF aCF[1,1,1]=="E"
						Return()
					else
						lLogImp := .f.
						::putNfe(aCF)
					EndIf
					if !::lAuto
						if lFolder
							::setFile(sPasta)
						endIf
					endIf
				else
					if ::lAuto
						FWLogMsg("ERROR", , "BusinessObject", funName(), "", "01", "Erro de importação do  arquivo!!", 0, 0, {})
						aadd(aLogAuto, "E - Erro de importação do  arquivo!!")
					else
						MsgBox("Não foi possível visualizar a nota!!","","ALERT")
					endif
					
					if !::lAuto
						if lFolder
							::setFile(sPasta)
						endIf
					endIf
					
					Return()
				endif
			endif
		
			//Libera memoria apos o uso
			::NFe := Nil
			if FWIsInCallStack("u_ExecImpXML")
				DelClassIntf()
			endIf
			
		endif
	next j
	
	//Libera memoria apos o uso
	sPasta			:= Nil
	sNomeArquivo	:= Nil
	cFornece		:= Nil
	cLoja			:= Nil
	cUF				:= Nil
	lFornece		:= Nil
	
return self

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Consiste o Arquivo		                                            ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method chkFile() Class TImpNfe
	
	Local cFile := ::getFile()
	Local lRet := .T.
	
	If !File(cFile)
		lRet := .F.
	EndIf
	
return lRet

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Criacao do Objeto oNFe                                              ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method loadObject() Class TImpNfe
	Local cFile 	:= ::getFile()
	Local cError 	:= ""
	Local cWarning 	:= ""
	
	If ":" $ cFile
		
		cTemp := cFile
		
		Do While "\" $ cTemp
			cTemp := Substr(cTemp,2)
		Enddo
		
		If !lIsDir("\XMLNFE")
			MontaDir("\XMLNFE")
		Endif
		
		cArqDest    :=	"\XMLNFE\" + cTemp
		
		__CopyFile( cFile , cArqDest )
		
		if	File( cArqDest )
			//Copy File &( cFile ) to &( cArqDest )
			cFile := cArqDest
		endif
		
	EndIf
	
	::NFe	:= XmlParserFile(cFile,"_",@cError,@cWarning)
	
return self


//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Verifica Layout  do XML para NFE                                    ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method chkNFELayout() Class TImpNfe
	Local oNfe 		:= ::getNfe()
	Local aRet		:= {}
	local cVersao	:= ""
	Private oNF2    	:=  oNfe
	Private oDet2   	:=  Nil
	Private oEmit2		:=  Nil
	Private oCobr2		:=  Nil
	
	aadd(aRet,.F.)
	aadd(aRet,.F.)
	If ValType(oNfe) <> Nil
		
		aRet[1] := .T.
		Begin Sequence
			
			if ExistBlock("IPNFEVLXML",,LFORCES3)
				if !u_IpNfeVlXml(oNfe)
					break
				endIf
			endIf
			
			If type("oNF2:_NFePROC:_Nfe:_InfNfe:_Emit") == "O"
				cVersao			:= oNfe:_NFeProc:_Nfe:_InfNfe:_VERSAO:TEXT
				::ChvNfe        := oNFe:_NFePROC:_Nfe:_InfNfe:_ID
				::Emitente  	:= oNFe:_NFePROC:_Nfe:_InfNfe:_Emit
				oEmit2			:= ::Emitente
				::Total         := oNFe:_NFePROC:_Nfe:_InfNfe:_Total
				::Dest	        := oNFe:_NFePROC:_Nfe:_InfNfe:_Dest
				::InfAdic       := IIF(type("oNF2:_NFePROC:_Nfe:_InfNfe:_InfAdic")=="O",oNFe:_NFePROC:_Nfe:_InfNfe:_InfAdic,NIL)
				::Ident     	:= oNFe:_NFePROC:_Nfe:_InfNfe:_IDE
				::Cobr     		:= IIF(type("oNF2:_NFePROC:_Nfe:_InfNfe:_Cobr")=="O",oNFe:_NFePROC:_Nfe:_InfNfe:_Cobr,NIL)
				if ::Cobr !=nil
					oCobr2 := ::Cobr
					If Type("oCobr2:_DUP")<>"U"
						::Cobr := IIF( TYPE("oCobr2:_DUP") == "A",::Cobr:_DUP,{::Cobr:_DUP})
					Else
						::Cobr := Nil
					EndIf
				endif
				::Det       	:= oNFe:_NFePROC:_Nfe:_InfNfe:_Det
				oDet2			:= ::Det
				::Det			:= IIF( TYPE("ODET2") == "A",::Det,{::Det})
				::CNPJ 			:= ::Emitente:_CNPJ:Text
				If Type("oEmit2:_XNOME") == "O"
					::RAZAO	:= ::Emitente:_XNOME:Text
					aRet[2] := .T.
				Else
					::RAZAO := ::Emitente:_NOME:Text
					aRet[2] := .T.
				EndIF
			elseIf type("oNF2:_InfNfe:_Emit") == "O"
				cVersao			:= oNfe:_InfNfe:_VERSAO:TEXT
				::ChvNfe        := oNFe:_InfNfe:_ID
				::Emitente  	:= oNFe:_InfNfe:_Emit
				::Total         := oNFe:_InfNfe:_Total
				oEmit2			:= ::Emitente
				::Dest	        := oNFe:_InfNfe:_Dest
				::InfAdic       := IIF(type("oNF2:_InfNfe:_InfAdic")=="O",oNFe:_InfNfe:_InfAdic,NIL)
				::Cobr     		:= IIF(type("oNF2:_InfNfe:_Cobr")=="O",oNFe:_InfNfe:_Cobr,NIL)
				if ::Cobr !=nil
					oCobr2 := ::Cobr
					If Type("oCobr2:_DUP")<>"U"
						::Cobr := IIF( TYPE("oCobr2:_DUP") == "A",::Cobr,{::Cobr})
					Else
						::Cobr := Nil
					EndIf
				endif
				::Ident     	:= oNFe:_InfNfe:_IDE
				::Det       	:= oNFe:_InfNfe:_Det
				oDet2			:= ::Det
				::Det			:= IIF( TYPE("ODET") == "A",::Det,{::Det})
				::CNPJ 			:= ::Emitente:_CNPJ:Text
				If type("oEmit2:_XNOME") == "O"
					cRAZAO 		:= oEmitente:_XNOME:Text
					aRet[2] 	:= .T.
				Else
					cRAZAO 		:= oEmitente:_NOME:Text
					aRet[2]		:= .T.
				EndIF
			elseif type("oNF2:_ENVINFE:_Nfe:_InfNfe:_Emit") == "O"
				cVersao			:= oNFe:_ENVINFE:_Nfe:_InfNfe:_VERSAO:TEXT
				::ChvNfe        := oNFe:_ENVINFE:_Nfe:_InfNfe:_ID
				::Emitente  	:= oNFe:_ENVINFE:_Nfe:_InfNfe:_Emit
				oEmit2			:= ::Emitente
				::Total         := oNFe:_ENVINFE:_Nfe:_InfNfe:_Total
				::Dest	        := oNFe:_ENVINFE:_Nfe:_InfNfe:_Dest
				::InfAdic       := IIF(type("oNF2:_ENVINFE:_Nfe:_InfNfe:_InfAdic")=="O",oNFe:_ENVINFE:_Nfe:_InfNfe:_InfAdic,NIL)
				::Ident     	:= oNFe:_ENVINFE:_Nfe:_InfNfe:_IDE
				::Cobr     		:= IIF(type("oNF2:_ENVINFE:_Nfe:_InfNfe:_Cobr")=="O",oNFe:_ENVINFE:_Nfe:_InfNfe:_Cobr,NIL)
				if ::Cobr !=nil
					oCobr2 := ::Cobr
					If Type("oCobr2:_DUP")<>"U"
						::Cobr := IIF( TYPE("oCobr2:_DUP") == "A",::Cobr:_DUP,{::Cobr:_DUP})
					Else
						::Cobr := Nil
					EndIf
				endif
				::Det       	:= oNFe:_ENVINFE:_Nfe:_InfNfe:_Det
				oDet2			:= ::Det
				::Det			:= IIF( TYPE("ODET2") == "A",::Det,{::Det})
				::CNPJ 			:= ::Emitente:_CNPJ:Text
				If Type("oEmit2:_XNOME") == "O"
					::RAZAO	:= ::Emitente:_XNOME:Text
					aRet[2] := .T.
				Else
					::RAZAO := ::Emitente:_NOME:Text
					aRet[2] := .T.
				EndIF
			ElseIf type("oNF2:_Nfe:_InfNfe:_Emit") == "O"
				cVersao			:= oNfe:_NFE:_InfNfe:_VERSAO:TEXT
				::ChvNfe        := oNFe:_Nfe:_InfNfe:_ID
				::Emitente  	:= oNFe:_Nfe:_InfNfe:_Emit
				oEmit2			:= ::Emitente
				::Total         := oNFe:_Nfe:_InfNfe:_Total
				::Dest	        := oNFe:_Nfe:_InfNfe:_Dest
				::InfAdic       := IIF(type("oNF2:_Nfe:_InfNfe:_InfAdic")=="O",oNFe:_Nfe:_InfNfe:_InfAdic,NIL)
				::Ident     	:= oNFe:_Nfe:_InfNfe:_IDE
				::Cobr     		:= IIF(type("oNF2:_Nfe:_InfNfe:_Cobr")=="O",oNFe:_Nfe:_InfNfe:_Cobr,NIL)
				if ::Cobr !=nil
					oCobr2 := ::Cobr
					If Type("oCobr2:_DUP")<>"U"
						::Cobr := IIF( TYPE("oCobr2:_DUP") == "A",::Cobr:_DUP,{::Cobr:_DUP})
					Else
						::Cobr := Nil
					EndIf
				endif
				::Det       	:= oNFe:_Nfe:_InfNfe:_Det
				oDet2			:= ::Det
				::Det			:= IIF( TYPE("ODET2") == "A",::Det,{::Det})
				::CNPJ 			:= ::Emitente:_CNPJ:Text
				If Type("oEmit2:_XNOME") == "O"
					::RAZAO	:= ::Emitente:_XNOME:Text
					aRet[2] := .T.
				Else
					::RAZAO := ::Emitente:_NOME:Text
					aRet[2] := .T.
				EndIF
			EndIF
			::setVersaoNf(cVersao)
		End Sequence
	endif
	
	oNF2    :=  Nil
	oDet2   :=  Nil
	oEmit2  :=  Nil
	oCobr2  :=  Nil
	
return aRet

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Verifica Layout  do XML para CTE                                    ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method chkCTELayout() Class TImpNfe
	Local oNfe 		:= ::getNfe()
	Local aRet		:= {}
	Private oNF2    	:=  oNfe
	Private oEmit2		:=  Nil
	
	aadd(aRet,.F.)
	aadd(aRet,.F.)
	
	If ValType(oNfe) <> Nil
		
		aRet[1] := .T.
		Begin Sequence
			
			if ExistBlock("IPCTEVLXML",,LFORCES3)
				if !u_IPCTEVLXML(oNfe)
					break
				endIf
			endIf
			
			If type("oNF2:_CTEPROC:_CTE:_InfCTE:_Emit") == "O"
				
				::ChvNfe        := oNFe:_CTEPROC:_CTE:_InfCTE:_ID
				::Emitente  	:= oNFe:_CTEPROC:_CTE:_InfCTE:_Emit
				oEmit2			:= ::Emitente
				::Total         := oNFe:_CTEPROC:_CTE:_InfCTE:_vPrest:_vTPrest
				::Dest	        := oNFe:_CTEPROC:_CTE:_InfCTE:_Dest
				::InfAdic       := IIF(type("oNF2:_CTEPROC:_CTE:_InfCTE:_InfAdic")=="O",oNFe:_CTEPROC:_CTE:_InfCTE:_InfAdic,NIL)
				::Ident     	:= oNFe:_CTEPROC:_CTE:_InfCTE:_IDE
				::CNPJ 			:= ::Emitente:_CNPJ:Text
				::SetDet(Nil)
				If Type("oEmit2:_XNOME") == "O"
					::RAZAO	:= ::Emitente:_XNOME:Text
					aRet[2] := .T.
				Else
					::RAZAO := ::Emitente:_NOME:Text
					aRet[2] := .T.
				EndIF
			Endif
			
		End Sequence
	endif
	
	//Libera memoria apos o uso
	oNF2    :=  Nil
	oEmit2  :=  Nil
	
return aRet

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//	Carrega informações na nota                                         ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method loadInfo() Class TImpNfe
	Local cCF  		:= ""
	Local aCF		:= {}
	Local oDet 		:= ::getDet()
	Local oEmitente := ::getEmitente()
	Local oTotal    := ::getTotal()
	Local oCobr	    := ::getCobr()
	Local cProdDesc := ""
	Local cCFOP     := ""
	Local nQuant    := 0
	Local nTotal    := 0
	Local nVlrUnit  := 0
	Local cProduto  := 0
	Local aItem     := {}
	Local aTotal    := {}
	Local aDup		:= {}
	Local aAux      := {}
	Local cProdSB1	:= ""
	Local cNCM		:= ""
	Local cLoteCTL	:= CriaVar("D1_LOTECTL")
	Local nDescItem := CriaVar("D1_DESC")
	Local nFretItem := CriaVar("D1_VALFRE")
	Local cPedCom   := ""
	Local cItPedCom := ""
	Local cMsg      := ""
	Local xDup      := ""
	Local xVenc     := ""
	Local cCnpjAux  := ""
	Local cCFOPBen	:= GetNewPar("ZZ_CFOPBEN", "")
	Local cCFOPDev	:= GetNewPar("ZZ_CFOPDEV", "")
	Local nI		:= 0
	Local aDados	:= {}
	Local nQtdItem	:= 1
	Local cDataLtFab:= ""
	Local cDataLtVal:= ""
	Local cUm		:= ""
	Local lIPNfeTagProd := ExistBlock("IPNFETAGPROD",,LFORCES3)
	Local lIPNfeProduto := ExistBlock("IPNFEPRODUTO",,LFORCES3)
	Local lIPNfeLote:= ExistBlock("IPNFELOTE",,LFORCES3) 
	Local lIPNfeRasSku := ExistBlock("IPNFERASSKU",,LFORCES3)
	Local lIPAddIte	:= ExistBlock("IPADDITE",,LFORCES3)
	Local lCNPJValido := .t.
	Local cCpoDtFabr:= AllTrim(GetNewPar("ZZ_CPODTFA", ""))
		
	private oDest   := ::GetDest()
	Private oXml	:= ::getNfe()
	Private oEmit3 	:= oEmitente
	Private oDetAux:= Nil
	//Private lFornece:= .T.
	Private lTeste  := GetNewPar("MV_ZZXMLT", .T.) //AMBIENTE DE TESTES
	
	If Upper(Type("oXml:_CTEPROC")) == "O"
		cCnpjAux :=	 IIf(Type("oXml:_CTEPROC:_CTE:_INFCTE:_REM:_CNPJ") == "O", oXml:_CTEPROC:_CTE:_INFCTE:_REM:_CNPJ:TEXT , oXml:_CTEPROC:_CTE:_INFCTE:_REM:_CPF:TEXT )
		cCnpjAux +=	 "|" + IIf(Type("oXml:_CTEPROC:_CTE:_INFCTE:_DEST:_CNPJ") == "O", oXml:_CTEPROC:_CTE:_INFCTE:_DEST:_CNPJ:TEXT, oXml:_CTEPROC:_CTE:_INFCTE:_DEST:_CPF:TEXT)
	Else
		if Upper(Type("oDest:_CNPJ")) == "O"
			cCnpjAux := oDest:_CNPJ:TEXT
		endIf
	EndIf
	
	//Ponto de Entrada para troca de CNPJ de destinatário da NFe
	//Julio Lisboa - FSW TOTVS IP Campinas - 19/08/2016
	If ExistBlock("IPDESTNFE",,LFORCES3)
		cCnpjAux	:= ExecBlock("IPDESTNFE",.F.,.F., { cCnpjAux } )
	EndIf
	
	//Validação para não permitir importar arquivos que não sejam do CNPJ da filial corrente
	//Em caso de CTe a validação deve ser feita no remetente e no destinatário
	If !(AllTrim(SM0->M0_CGC) $ AllTrim(cCnpjAux)) .AND. !lTeste
		lCNPJValido := .f.
		/*
		Ponto de entrada para validações adicionais do CNPJ do destinatário conforme necessidade.
		*/
		If ExistBlock("IPVLDCNPJ",,LFORCES3)
			lCNPJValido	:= ExecBlock("IPVLDCNPJ",.F.,.F., { cCnpjAux } )
			If ValType(lCNPJValido) != "L"
				lCNPJValido := .f.
			EndIf
		EndIf
		
		If !lCNPJValido
			if ::lAuto
				FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "O CNPJ " + cCnpjAux + " é diferente do CNPJ da filial corrente: " + SM0->M0_CGC, 0, 0, {})
				aadd(aLogAuto, "A - O CNPJ " + transform(cCnpjAux,PesqPict("SA1","A1_CGC") ) + " é diferente do CNPJ da filial corrente: " + transform(SM0->M0_CGC,PesqPict("SA1","A1_CGC") ))
			else
				cMsg := "O CNPJ " + transform(cCnpjAux,PesqPict("SA1","A1_CGC") )
				cMsg += " é diferente do CNPJ da filial corrente: " + transform(SM0->M0_CGC,PesqPict("SA1","A1_CGC") )
				MsgBox(cMsg,"","ALERT")
			endif
			Return ({"","","",""})
		EndIf
		
	EndIf
	
	if ::lAuto
		aadd(aLogAuto, "I - CNPJ Emissor: " + transform(::GetCNPJ(),PesqPict("SA1","A1_CGC") ))
	endif
	
	SA2->(dbSetOrder(3))
	If SA2->(dbSeek(xFilial("SA2")+::getCNPJ()))
		aAux := AClone(::ChkForCli(::getCNPJ(),.T.))
		If Len(aAux) > 0
			cFornece := aAux[1]
			cLoja	  := aAux[2]
			cUf      := aAux[3]
		EndIf
		
		If Empty(cFornece) .And. Empty(cLoja)
			cFornece := SA2->A2_COD
			cLoja	  := SA2->A2_LOJA
			cUf      := SA2->A2_EST
			::setRazao(AllTrim(SA2->A2_NOME))
		EndIf
		
		::setCodFor(cFornece)
		::setLojFor(cLoja)
		
		aadd(aCF,"F=Fornecedor")
		lFornece := .T.
	EndIf
	SA1->(dbSetOrder(3))
	If SA1->(dbSeek(xFilial("SA1")+::getCNPJ()))
		cFornece := ""
		cLoja    := ""
		aAux := AClone(::ChkForCli(::getCNPJ(),.F.))
		If Len(aAux) > 0
			cFornece := aAux[1]
			cLoja	  := aAux[2]
			cUf      := aAux[3]
		EndIf
		
		If Empty(cFornece) .And. Empty(cLoja)
			cFornece := SA1->A1_COD
			cLoja	  := SA1->A1_LOJA
			cUf      := SA1->A1_EST
			::setRazao(AllTrim(SA1->A1_NOME))
		EndIf
		
		::setCodCli(cFornece)
		::setLojCli(cLoja)
		
		if ::lAuto
			if empty(aCF)
				cCFOP := oDet[1]:_Prod:_CFOP:Text
				if (cCFOP $ cCFOPBen) .or. (cCFOP $ cCFOPDev)
					if (cCFOP $ cCFOPBen)
						::setTipoNf("B")
					else
						::setTipoNf("D")
					endif
				endif
			endif
		endif
		
		aadd(aCF,"C=Cliente")
		lFornece := .F.
	EndIf
	
	If Len(aCF) == 0
		if ::lAuto
			FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "Nao existe Fornecedor/Cliente para o CNPJ: "+transform(::GetCNPJ(),PesqPict("SA1","A1_CGC") ), 0, 0, {})
			aadd(aLogAuto, "A - Nao existe Fornecedor/Cliente para o CNPJ: " + transform(::GetCNPJ(),PesqPict("SA1","A1_CGC") ))
		else
			MsgBox("Nao existe Fornecedor/Cliente para o CNPJ:"+AllTrim(::getCNPJ()),"","ALERT")
		endif
		Return ({"","","",""})
	ElseIf Len(aCF) == 2
		/*****************************************************************
		**** Valida Fornecedor e Cliente cadastrado com o mesmo CNPJ *****
		*****************************************************************/
		aCF := {}
		if ::lAuto
			cCFOP := oDet[1]:_Prod:_CFOP:Text
			
			if (cCFOP $ cCFOPBen) .or. (cCFOP $ cCFOPDev)
				lFornece := .F.
				aadd(aCF,"C=Cliente")
				
				cFornece := ::getCodCli()
				cLoja	 := ::getLojCli()
				::setRazao(AllTrim(Posicione("SA1",1,xFilial("SA1") + cFornece + cLoja,"A1_NOME")))
				if (cCFOP $ cCFOPBen)
					::setTipoNf("B")
				else
					::setTipoNf("D")
				endif
			else
				lFornece := .T.
				aadd(aCF,"F=Fornecedor")
				
				cFornece := ::getCodFor()
				cLoja	 := ::getLojFor()
				::setRazao(AllTrim(Posicione("SA2",1,xFilial("SA2") + cFornece + cLoja,"A2_NOME")))
				::setTipoNf("N")
			endif
		else
			If MsgYesNo("Existe Fornecedor e Cliente Cadastrado para o CNPJ:"+AllTrim(::getCNPJ())+". Para importar considerando nota de fornecedor clique em SIM, caso deseje considerar nota de cliente clique em NAO") //Thiago
				lFornece := .T.
				aadd(aCF,"F=Fornecedor")
				
				cFornece := ::getCodFor()
				cLoja	 := ::getLojFor()
				::setRazao(AllTrim(Posicione("SA2",1,xFilial("SA2") + cFornece + cLoja,"A2_NOME")))
			Else
				lFornece := .F.
				aadd(aCF,"C=Cliente")
				
				cFornece := ::getCodCli()
				cLoja	 := ::getLojCli()
				::setRazao(AllTrim(Posicione("SA1",1,xFilial("SA1") + cFornece + cLoja,"A1_NOME")))
			Endif
		endif
	EndIf
	
	/*****************************************************************
	**** Se CTE executa codigo abaixo - Carlos Abreu - 05/08  ********
	*****************************************************************/
	If Valtype(oDet)=="U"
		cProduto  := GetMV("ZZ_CTEPROD")
		
		if !SB1->( dbseek(xfilial("SB1")+cProduto) )
			MSGALERT("Produto "+cProduto+ " não existe!")
			Return ({"","","",""})
		Endif
		
		cProdDesc := SB1->B1_DESC
		cUm       := Transform(SB1->B1_UM,PesqPict("SB1","B1_UM"))
		nQuant    := 1
		nVlrUnit  := Val(oTotal:Text)
		nTotal    := nVlrUnit
		
		/*
		Ponto de entrada para tratar amarração do codigo de produto/serviço por fornecedor.
		*/
		IF ExistBlock("IPCTEPRODUTO",,LFORCES3)
			aParam := {cProduto,cProdDesc}
			aParam := ExecBlock("IPCTEPRODUTO",.F.,.F.,aParam)
			If ( Len(aParam) >= 2 )
				cProdSB1	:= aParam[1]
				cProdDesc	:= aParam[2]
				cProduto    := cProdSB1
			EndIf
		Endif
		
		aAdd(aDados,	StrZero(1,TamSX3("D1_ITEM")[1]) )
		aAdd(aDados,	cProduto )
		aAdd(aDados,	cProduto )
		aAdd(aDados,	cProdDesc )
		aAdd(aDados,	PADR(cUM,TamSx3("B1_UM")[1]) )
		aAdd(aDados,	nQuant )
		aAdd(aDados,	nVlrUnit )
		aAdd(aDados,	nTotal )
		aAdd(aDados,	cCFOP )
		aAdd(aDados,	Space(TamSx3("D1_PEDIDO")[1]) )
		aAdd(aDados,	Space(TamSx3("D1_ITEMPC")[1]) )
		aAdd(aDados,	cNCM )
		aAdd(aDados,	cLoteCTL )
		
		If lIPAddIte
			aDados	:= ExecBlock( "IPADDITE" , .F. , .F. , { "CTE" , aDados , oDetAux , oDet } )
		EndIf
		
		//Incrementa a Linha de Deletado
		aAdd(aDados,	.F. )
		aAdd(aItem, 	aDados)
		aDados	:= {}
		
		/*****************************************************************
		**** Se NFE executa codigo abaixo - Carlos Abreu - 05/08  ********
		*****************************************************************/
	Else
		
		For nI:=1 to Len(oDet)		
			
			cProduto := upper(alltrim(oDet[nI]:_Prod:_cProd:Text))
			cProdSB1 := ::VerSB1(cFornece,cLoja,@cProduto,@cUm)			
			
			if self:isProdutLote(cProdSB1)
				nQtdRastro := getQtdRastro(oDet, nI)
			else
				nQtdRastro := 0
			endif	
				
			if nQtdRastro > 0
				for nJ := 1 to nQtdRastro
					lRazao		 := .F.
					// Consiste o Produto
					
					cProduto := upper(alltrim(oDet[nI]:_Prod:_cProd:Text)) // PADR(oDet[nI]:_Prod:_cProd:Text,TamSX3("B1_COD")[1])
					
					// PE para personalizar de qual TAG será obtido o código do produto incluído por Renato Castro em 26/02/13
					IF lIPNfeTagProd
						xRetPe := u_IPNFETAGPROD(oDet[nI],cFornece,cLoja)
						if (ValType(xRetPe) == "C")
							cProduto := xRetPe
						endIf
					EndIf
					
					If fTypeVar("oEmit3:_XNOME") == "O"
						cProdDesc 	:= PADR(oDet[nI]:_Prod:_xProd:Text,35)
					Else
						cProdDesc 	:= PADR(oDet[nI]:_Prod:_Prod:Text,35)
					EndIf
					
					cCFOP 		:= oDet[nI]:_Prod:_CFOP:Text
					nTotal		:= Val(oDet[nI]:_Prod:_vProd:Text)
					cNCM		:= oDet[nI]:_Prod:_NCM:Text
					
					::chkPergs()
					
					if MV_PAR02 == 1 // Tags de Comercialização
						cUM			:= Transform(oDet[nI]:_Prod:_uCom:Text, PesqPict("SB1", "B1_UM"))
						nQuant		:= Val(oDet[nI]:_Prod:_qCom:Text)
						nVlrUnit    := Val(oDet[nI]:_Prod:_vUnCom:Text)
					elseIf MV_PAR02 == 2 // Tags de Tributação
						cUM			:= Transform(oDet[nI]:_Prod:_uTrib:Text, PesqPict("SB1", "B1_UM"))
						nQuant		:= Val(oDet[nI]:_Prod:_qTrib:Text)
						nVlrUnit    := Val(oDet[nI]:_Prod:_vUnTrib:Text)
					endIf
					
					oDetAux := oDet[nI]:_Prod
					If fTypeVar("oDetAux:_VDESC") == "O"
						nDescItem   := Val(oDet[nI]:_Prod:_vDesc:Text)
					EndIf
					If fTypeVar("oDetAux:_VFRETE") == "O"
						nFretItem   := Val(oDet[nI]:_Prod:_vFrete:Text)
					EndIf
					
					::setProd(cProduto)
					cProdSB1 := ::VerSB1(cFornece,cLoja,@cProduto,@cUm)
					cProduto := ::getProd()
					
					//Procura Pedido de compra - Yves 01-10-2013
					If fTypeVar("oDetAux:_xPed") == "O" .And. fTypeVar("oDetAux:_nItemPed") == "O"
						cPedCom   := oDet[nI]:_Prod:_xPed:Text
						cItPedCom := STRZERO(Val(oDet[nI]:_Prod:_nItemPed:Text),TamSx3("D1_ITEMPC")[1])
						//Se não encontrar o item do pedido de compra, atribui vazio
						If !::VerSC7(cPedCom,cItPedCom,cProdSB1)
							cPedCom   := Space(TamSx3("D1_PEDIDO")[1])
							cItPedCom := Space(TamSx3("D1_ITEMPC")[1])
						EndIf
					Else
						cPedCom   := Space(TamSx3("D1_PEDIDO")[1])
						cItPedCom := Space(TamSx3("D1_ITEMPC")[1])
					EndIf
					
					//Verifica se considera a unidade de medida existente no cadastro Produto x Fornecedor
					If GetNewPar("ZZ_UMFOR",.F.) .And. lFornece
						cUm := IIF(!Empty(::getUmFor()),::getUmFor(),cUm)
					EndIf
					
					// Chamada do ponto de entrada IPNFEPRODUTO
					// Executado para cada item do XML, permitindo que seja alimentado o campo de
					// Codigo do produto Protheus e sua descrição.
					// Implementação feita dia 15/08/2012 - FSW IP Campinas
					IF lIPNfeProduto
						aParam := {cProduto,cProdDesc,cUm, cProdSB1}
						aParam := ExecBlock("IPNFEPRODUTO",.F.,.F.,aParam)
						
						If ( Len(aParam) >= 2 )
							cProdSB1	:= aParam[1]
							cProdDesc	:= aParam[2]
							If len(aParam) >= 3 .and. Valtype(aParam[3]) != "U"
								cUm			:= aParam[3]
							EndIf
						EndIf
					Endif
					
					// Chamada do ponto de entrada IPNFELOTE
					// Executado para cada item do XML, permitindo que seja alimentado o campo Lote
					// Implementação feita dia 31/07/2013 - FSW IP Campinas
					If lIPNfeLote
						cLoteCTL := ExecBlock("IPNFELOTE",.F.,.F.,{oEmitente,oDet[nI], nJ})
						If Empty(cLoteCTL)
							cLoteCTL := CriaVar("D1_LOTECTL")
						EndIf
					EndIf
					
					If fTypeVar("oDetAux:_RASTRO") == "O"
						nQuant := val(oDetAux:_RASTRO:_QLOTE:text)
						cDataLtFab	:= formatDate(oDetAux:_RASTRO:_DFAB:text)
						cDataLtVal  := formatDate(oDetAux:_RASTRO:_DVAL:text)
					ElseIf fTypeVar("oDetAux:_RASTRO") == "A"
						nQuant := val(oDetAux:_RASTRO[nJ]:_QLOTE:text)
						cDataLtFab := formatDate(oDetAux:_RASTRO[nJ]:_DFAB:text)
						cDataLtVal := formatDate(oDetAux:_RASTRO[nJ]:_DVAL:text)
					EndIf
					
					// Chamada do ponto de entrada IPNFERASSKU
					// Executado para cada item do XML, permitindo que seja atribuida a quantidade, data de fabricação e data de validade de cada lote do SKU
					// Implementação feita dia 11/09/2018 - FSW IP Campinas
					If lIPNfeRasSku
						aParam := ExecBlock("IPNFERASSKU",.F.,.F.,{oDet[nI], nJ})
						If ( Len(aParam) >= 3 )
							nQuant 		:= aParam[1]
							cDataLtFab	:= aParam[2]
							cDataLtVal	:= aParam[3]
						EndIf
					EndIf
					
					nTotal 		:= nQuant * nVlrUnit
					aAdd(aDados,	StrZero(nQtdItem,TamSX3("D1_ITEM")[1]) )
					aAdd(aDados,	cProduto )
					aAdd(aDados,	cProdSB1 )
					aAdd(aDados,	cProdDesc )
					aAdd(aDados,	PADR(cUM,TamSx3("B1_UM")[1]) )
					aAdd(aDados,	nQuant )
					aAdd(aDados,	nVlrUnit )
					aAdd(aDados,	nTotal )
					aAdd(aDados,	cCFOP )
					aAdd(aDados,	cPedCom )
					aAdd(aDados,	cItPedCom )
					aAdd(aDados,	cNCM )
					aAdd(aDados,	cLoteCTL )
					aAdd(aDados, 	CriaVar("D1_DTVALID", .F.) )
					If !Empty(cCpoDtFabr)
						aAdd(aDados, 	CriaVar(cCpoDtFabr, .F.) )
					Else
						aAdd(aDados, 	cTod("  /  /  ") )
					EndIf
					
					nQtdItem ++
					
					If lIPAddIte
						aDados	:= ExecBlock( "IPADDITE" , .F. , .F. , { "NFE" , aDados , oDetAux , oDet[nI] } )
					EndIf
					
					//TRATAMENTO DA DATA DE VALIDADE E DATA DE FABRICAÇÃO QUANDO O XML POSSUI RASTRO
					if self:isProdutLote(cProdSB1)
						appendDtRastro(aDados, cDataLtVal, cDataLtFab)
					endIf
					
					aAdd(aDados,	nDescItem )
					aAdd(aDados,	nFretItem )
					
					//Incrementa a Linha de Deletado
					aAdd(aDados,	.F. )
					aAdd(aItem, 	aDados)
					aDados	:= {}
					
					//AADD(aItem,{StrZero(nI,TamSX3("D1_ITEM")[1]),cProduto,cProdSB1,cProdDesc,PADR(cUM,TamSx3("B1_UM")[1]),nQuant,nVlrUnit/*Round(nTotal/nQuant,4)*/,nTotal,cCFOP,cPedCom,cItPedCom,cNCM,cLoteCTL,nDescItem,nFretItem,.F.})
					
				next nJ
			else
				lRazao:= .F.
				// Consiste o Produto
				
				cProduto := upper(alltrim(oDet[nI]:_Prod:_cProd:Text)) // PADR(oDet[nI]:_Prod:_cProd:Text,TamSX3("B1_COD")[1])
				
				// PE para personalizar de qual TAG será obtido o código do produto incluído por Renato Castro em 26/02/13
				IF lIPNfeTagProd
					xRetPe := u_IPNFETAGPROD(oDet[nI],cFornece,cLoja)
					if (ValType(xRetPe) == "C")
						cProduto := xRetPe
					endIf
				EndIf
				
				If fTypeVar("oEmit3:_XNOME") == "O"
					cProdDesc 	:= PADR(oDet[nI]:_Prod:_xProd:Text,35)
				Else
					cProdDesc 	:= PADR(oDet[nI]:_Prod:_Prod:Text,35)
				EndIf
				
				cCFOP 		:= oDet[nI]:_Prod:_CFOP:Text
				nTotal		:= Val(oDet[nI]:_Prod:_vProd:Text)
				cNCM		:= oDet[nI]:_Prod:_NCM:Text
				
				::chkPergs()
				
				if MV_PAR02 == 1 // Tags de Comercialização
					cUM			:= Transform(oDet[nI]:_Prod:_uCom:Text, PesqPict("SB1", "B1_UM"))
					nQuant		:= Val(oDet[nI]:_Prod:_qCom:Text)
					nVlrUnit    := Val(oDet[nI]:_Prod:_vUnCom:Text)
				elseIf MV_PAR02 == 2 // Tags de Tributação
					cUM			:= Transform(oDet[nI]:_Prod:_uTrib:Text, PesqPict("SB1", "B1_UM"))
					nQuant		:= Val(oDet[nI]:_Prod:_qTrib:Text)
					nVlrUnit    := Val(oDet[nI]:_Prod:_vUnTrib:Text)
				endIf
				
				oDetAux := oDet[nI]:_Prod
				If fTypeVar("oDetAux:_VDESC") == "O"
					nDescItem   := Val(oDet[nI]:_Prod:_vDesc:Text)
				EndIf
				If fTypeVar("oDetAux:_VFRETE") == "O"
					nFretItem   := Val(oDet[nI]:_Prod:_vFrete:Text)
				EndIf
				
				::setProd(cProduto)
				cProdSB1 := ::VerSB1(cFornece,cLoja,@cProduto,@cUm)
				cProduto := ::getProd()
				
				//Procura Pedido de compra - Yves 01-10-2013
				If fTypeVar("oDetAux:_xPed") == "O" .And. fTypeVar("oDetAux:_nItemPed") == "O"
					cPedCom   := oDet[nI]:_Prod:_xPed:Text
					cItPedCom := STRZERO(Val(oDet[nI]:_Prod:_nItemPed:Text),TamSx3("D1_ITEMPC")[1])
					//Se não encontrar o item do pedido de compra, atribui vazio
					If !::VerSC7(cPedCom,cItPedCom,cProdSB1)
						cPedCom   := Space(TamSx3("D1_PEDIDO")[1])
						cItPedCom := Space(TamSx3("D1_ITEMPC")[1])
					EndIf
				Else
					cPedCom   := Space(TamSx3("D1_PEDIDO")[1])
					cItPedCom := Space(TamSx3("D1_ITEMPC")[1])
				EndIf
				
				//Verifica se considera a unidade de medida existente no cadastro Produto x Fornecedor
				If GetNewPar("ZZ_UMFOR",.F.) .And. lFornece
					cUm := IIF(!Empty(::getUmFor()),::getUmFor(),cUm)
				EndIf
				
				// Chamada do ponto de entrada IPNFEPRODUTO
				// Executado para cada item do XML, permitindo que seja alimentado o campo de
				// Codigo do produto Protheus e sua descrição.
				// Implementação feita dia 15/08/2012 - FSW IP Campinas
				IF lIPNfeProduto
					aParam := {cProduto,cProdDesc,cUm, cProdSB1}
					aParam := ExecBlock("IPNFEPRODUTO",.F.,.F.,aParam)
					
					If ( Len(aParam) >= 2 )
						cProdSB1	:= aParam[1]
						cProdDesc	:= aParam[2]
						If len(aParam) >= 3 .and. Valtype(aParam[3]) != "U"
							cUm			:= aParam[3]
						EndIf
					EndIf
				Endif
				
				// Chamada do ponto de entrada IPNFELOTE
				// Executado para cada item do XML, permitindo que seja alimentado o campo Lote
				// Implementação feita dia 31/07/2013 - FSW IP Campinas
				If lIPNfeLote
					cLoteCTL := ExecBlock("IPNFELOTE",.F.,.F.,{oEmitente,oDet[nI], nil })
					If Empty(cLoteCTL)
						cLoteCTL := CriaVar("D1_LOTECTL")
					EndIf
				EndIf
				
				aAdd(aDados,	StrZero(nI,TamSX3("D1_ITEM")[1]) )
				aAdd(aDados,	cProduto )
				aAdd(aDados,	cProdSB1 )
				aAdd(aDados,	cProdDesc )
				aAdd(aDados,	PADR(cUM,TamSx3("B1_UM")[1]) )
				aAdd(aDados,	nQuant )
				aAdd(aDados,	nVlrUnit )
				aAdd(aDados,	nTotal )
				aAdd(aDados,	cCFOP )
				aAdd(aDados,	cPedCom )
				aAdd(aDados,	cItPedCom )
				aAdd(aDados,	cNCM )
				aAdd(aDados,	cLoteCTL )
				aAdd(aDados, 	CriaVar("D1_DTVALID", .F.) )
				If !Empty(cCpoDtFabr)
					aAdd(aDados, 	CriaVar(cCpoDtFabr, .F.) )
				Else
					aAdd(aDados, 	cTod("  /  /  ") )
				EndIf
				
				If lIPAddIte
					aDados	:= ExecBlock( "IPADDITE" , .F. , .F. , { "NFE" , aDados , oDetAux , oDet[nI] } )
				EndIf
				
				aAdd(aDados,	nDescItem )
				aAdd(aDados,	nFretItem )
				
				//Incrementa a Linha de Deletado
				aAdd(aDados,	.F. )
				aAdd(aItem, 	aDados)
				aDados	:= {}
				
				//AADD(aItem,{StrZero(nI,TamSX3("D1_ITEM")[1]),cProduto,cProdSB1,cProdDesc,PADR(cUM,TamSx3("B1_UM")[1]),nQuant,nVlrUnit/*Round(nTotal/nQuant,4)*/,nTotal,cCFOP,cPedCom,cItPedCom,cNCM,cLoteCTL,nDescItem,nFretItem,.F.})
				
			endIf
			
		Next nI
	Endif
	// Pega a Informação de Total
	If oTotal:RealName=="vTPrest"//CTE
		aadd(aTotal,oTotal:Text)
	Else  //NFE
		aadd(aTotal,{oTotal:_ICMSTOT:_VBC:text,;
			oTotal:_ICMSTOT:_VBCST:text,;
			oTotal:_ICMSTOT:_VCOFINS:text,;
			oTotal:_ICMSTOT:_VDESC:text,;
			oTotal:_ICMSTOT:_VFRETE:text,;
			oTotal:_ICMSTOT:_VICMS:text,;
			oTotal:_ICMSTOT:_VII:text,;
			oTotal:_ICMSTOT:_VIPI:text,;
			oTotal:_ICMSTOT:_VNF:text,;
			oTotal:_ICMSTOT:_VOUTRO:text,;
			oTotal:_ICMSTOT:_VPIS:text,;
			oTotal:_ICMSTOT:_VPROD:text,;
			oTotal:_ICMSTOT:_VSEG:text,;
			oTotal:_ICMSTOT:_VST:text })
	Endif
	
	// Pega Informações das Duplicatas
	if oCobr != Nil
		ni:=0
		for ni:= 1 to len(oCobr)
			oAux := oCobr[ni]
			xDup      := IIF( fTypeVar("oAux:_NDUP") == "O",oCobr[ni]:_NDUP:Text,"")
			xVenc     := IIF( fTypeVar("oAux:_DVENC") == "O",::ConvDate(oCobr[ni]:_DVENC:Text),"")
			
			//aadd(aDup,{::ConvDate(oCobr[ni]:_DVENC:Text),oCobr[ni]:_NDUP:Text,oCobr[ni]:_VDUP:Text })
			aadd(aDup,{xVenc,xDup,oCobr[ni]:_VDUP:Text })
		next ni
	else
		aadd(aDup,{"","",""})
	endif
	
	//Libera memoria apos o uso
	oDest   := Nil
	oXml	:= Nil
	oEmit3 	:= Nil
	oDetAux	:= Nil
	lTeste  := Nil
		
return({aCF,aItem,aTotal,aDup})


//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Grava a Nota fiscal
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method putNfe(aCF) Class TImpNfe
	
	Local 	cNumNFE  		:= ""
	Local 	cSerNfe  		:= ""
	Local 	dEmissao 		:= Nil
	Local 	oDet	   		:= ::getDet()
	Local 	oIdent   		:= ::getIdent()
	Local 	oChvNFE  		:= ::getChvNfe()
	Local   oTotal			:= ::getTotal()
	Local	oInfAdNf		:= ::getInfAdic()  //Thiago Meschiatti 10/10/2014
	Local 	cProduto 		:= ""
	Local 	aItens   		:= {}
	Local 	lExiste  		:= .F.
	Local 	nOldModulo		:= 5
	Local 	aDet			:= aCf[2]
	Local 	cNumPC        	:= ""
	Local   cItemPc			:= ""
	Local 	cPriUm			:= ""
	Local 	cSegUm			:= ""
	Local 	nPriQtd		:= 0
	Local 	nPriVlr		:= 0
	Local 	aLog		:= {}
	Local 	cTipoLog 	:= GetNewPar("ZZ_INFTLOG","1") 		// 1-Via Mensagem, 2-Via Relatorio
	Local 	cEspecie 	:= GetNewPar("MV_ZZESPEC","SPED") 	// Espécie do documento de entrada //Incluído por Renato Castro em 26/02/13
	Local 	cValUM		:= GetNewPar("MV_ZZVALUM","S") 		// Valida unidade de medida
	Local   cLoteCTL	:= ""
	Local	cRotErro	:= ""
	Local   aAux        := {} // Yves - 01/08/2013 - Array auxiliar para tratamento dos pontos de entrada IPNFECAB e IDNFEITEM
	Local 	nCount		:= 0
	Local	nI			:= 0
	Local 	cLocal		:= ""
	Local nIAux			:= 0
	Local aDetAglutin	:= {}
	Local lIPNfeGrv		:= ExistBlock("IPNFEGRV", .F.,LFORCES3)
	Local lIPNfeVldItem	:= ExistBlock("IPNFEVLDITEM", .F.,LFORCES3)
	Local lIPNfeItem	:= ExistBlock("IPNFEITEM", .F.,LFORCES3)
	Local lIPNfe1aUM	:= ExistBlock("IPNFE1AUM", .F.,LFORCES3)
	Local cFolderLog	:= GetNewPar("ZZ_INFLDIR","\logxmlnfe\")
	Local cCpoDtFabr	:= AllTrim(GetNewPar("ZZ_CPODTFA", ""))
	
	Private	oDetAux		:= ::getDet()
	Private aInfNFe		:= aCF	// Criado variavel do tipo private com todas as informacoes da NFe para ser utilizada no PE IPNFEFIM executado depois da inclusao da pre nota.
	Private oIdent5     := oIdent
	Private oNfe		:= ::getNfe()
	
	/*
	If Type("oNfe:_NFEPROC:_NFE:_INFNFE:_VERSAO") != "U"
		cVersaoNf := oNfe:_NFEPROC:_NFE:_INFNFE:_VERSAO:TEXT
		::setVersaoNf(cVersaoNf)
	else Type("oNfe:_NFE:_INFNFE:_VERSAO:TEXT") != "U"
		
	EndIf
	*/
	
	If ExistBlock("IPNFEESP",,LFORCES3) // P.E para definir a espécie do documento
		cEspecie := ExecBlock("IPNFEESP",.F.,.F.,cEspecie)
	EndIf
	
	if ::lAuto
		aadd(aLogAuto, "I - Iniciando inclusão Dados Protheus... ")
	endif
	
	IF aCF[1,1,2]=="F"
		SA2->(dbSetOrder(3))
		IF SA2->(dbSeek(xFilial("SA2")+::getCNPJ()))
			If Empty(cFornece)
				cFornece 	:= SA2->A2_COD
				cLoja	 	:= SA2->A2_LOJA
				cUF		 	:= SA2->A2_EST
			EndIf
		ELSE
			if ::lAuto
				FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "FORNECEDOR NAO ENCONTRADO - CNPJ: "+ ::getCNPJ(), 0, 0, {})
				aadd(aLogAuto, "A - FORNECEDOR NAO ENCONTRADO - CNPJ: "+ ::getCNPJ())
			else
				If cTipoLog == "1"
					ALERT("FORNECEDOR NAO ENCONTRADO")
					RETURN()
				Else
					aadd(aLog, "FORNECEDOR NAO ENCONTRADO")
				EndIf
			endif
		ENDIF
	Else
		SA1->(dbSetOrder(3))
		IF SA1->(dbSeek(xFilial("SA1")+::getCNPJ()))
			If Empty(cFornece)
				cFornece 	:= SA1->A1_COD
				cLoja	 	:= SA1->A1_LOJA
				cUF		 	:= SA1->A1_EST
			EndIf
		ELSE
			if ::lAuto
				FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "CLIENTE NAO ENCONTRADO - CNPJ: "+ ::getCNPJ(), 0, 0, {})
				aadd(aLogAuto, "A - CLIENTE NAO ENCONTRADO - CNPJ: "+ ::getCNPJ())
			else
				If cTipoLog == "1"
					ALERT("CLIENTE NAO ENCONTRADO")
					RETURN()
				Else
					aadd(aLog, "CLIENTE NAO ENCONTRADO")
				EndIf
			endif
		ENDIF
	EndIf
	
	//Tratameto da data de emissão para versão 2 e 3, como default versão 2.
	If Type("oIdent5:_nNF")=="O"   //NFE
		cNumNFE 	:= StrZero(Val(oIdent:_nNf:Text),TamSX3("F1_DOC")[1])
		If Substr(::getVersaoNf(),1,1) == '3' .OR. Substr(::getVersaoNf(),1,1) == '4'
			dEmissao    := CtoD(self :ConvDate(oIdent:_dHEmi:Text))
		ElseIf Substr(::getVersaoNf(),1,1) == '2'
			dEmissao    := CtoD(::ConvDate(oIdent:_dEmi:Text))
		Else
			dEmissao    := CtoD(::ConvDate(oIdent:_dEmi:Text))
			
		EndIf
	Else                                //CTE
		cNumNFE 	:= StrZero(Val(oIdent:_nCT:Text),TamSX3("F1_DOC")[1])
		dEmissao    := CtoD(::ConvDate(oIdent:_dHEmi:Text))
		cEspecie    := "CTE"
	Endif
	cSerNFE 	:= PADR(oIdent:_Serie:Text,TamSX3("F1_SERIE")[1])
	
	if ::lAuto
		aadd(aLogAuto, "I - Nota Fiscal : " + cNumNFE + "/" + cSerNfe )
		aadd(aLogAuto, "I - Data Emissão: " + dtoc(dEmissao) )
	endif
	
	SF1->(dbSetOrder(1))
	If SF1->(dbSeek(xFilial("SF1")+cNumNFE+cSerNFE+cFornece+cLoja))
		if ::lAuto
			aadd(aLogAuto, "A - Documento "+Alltrim(cNumNFE)+"/"+Alltrim(cSerNFE)+" ja existente para o Fornecedor "+Alltrim(cFornece)+"/"+Alltrim(cLoja))
		else
			MsgBox("Documento "+Alltrim(cNumNFE)+"/"+Alltrim(cSerNFE)+" ja existente para o Fornecedor "+Alltrim(cFornece)+"/"+Alltrim(cLoja),"","ALERT")
		endif
		Return
	EndIf
	
	if ::lAuto .and. !empty(::getTipoNf())
		aCF[1,1,1] := ::getTipoNf()
	endif
	
	IF aCF[1,1,2] == "F"
		SA2->(dbSetOrder(1))
		SA2->(dbSeek(xFilial("SA2")+cFornece+cLoja))
	Else
		SA1->(dbSetOrder(1))
		SA1->(dbSeek(xFilial("SA1")+cFornece+cLoja))
	EndIf
	
	aCab 		:= {	{"F1_DOC"		,cNumNFE				,NIL},;
		{"F1_SERIE"		,cSerNFE				,NIL},;
		{"F1_FORNECE"	,cFornece   			,NIL},;
		{"F1_LOJA"	    ,cLoja		 			,NIL},;
		{"F1_EMISSAO"	,dEmissao				,NIL},;
		{"F1_EST"		,cUF					,NIL},;
		{"F1_TIPO"		,aCF[1,1,1]				,NIL},;
		{"F1_DTDIGIT"	,dDataBase				,Nil},;
		{"F1_ESPECIE"	,cEspecie				,NIL},; //Alterado por Renato Castro em 26/02/2013
		{"F1_CHVNFE"	,SubStr(oChvNFE:TEXT,4)	,NIL},;
		{"F1_RECBMTO"	,dDataBase				,Nil}}
	
	// Yves - 01/08/2013 - PE para complementar informações no array de cabeçalho na geração da pré-nota via execauto
	IF ExistBlock("IPNFECAB", .F., LFORCES3)
		aAux := {}
		aAux := ExecBlock("IPNFECAB", .F., .T.,{oIdent,oDet,oTotal})
		For nCount := 1 To Len(aAux)
			AADD(aCab,aAux[nCount])
		Next nCount
	EndIf
	
	// Coleta os Dados dos Itens do Documento
	
	aglutDet(aDet, aDetAglutin)
	
	For nI:=1 to Len(aDet)
		
		// Consiste o Produto
		cXMLUm 		:= PADR(aDet[nI,5],TamSX3("B1_UM")[1])
		cProduto 	:= PADR(aDet[nI,3],TamSX3("B1_COD")[1])
		lPriUm 		:=.T.
		If cValUM == 'S'
			lPriUm :=.F.
		Endif
		
		dbSelectArea("SB1")
		SB1->(dbSetOrder(1))
		If !SB1->(dbSeek(xFilial("SB1")+cProduto))
			// Chamada do ponto de entrada IPNFEGRV
			// Executado para cada item que seja gerado a Nota fiscal de entrada ( Pré Nota ).
			// Rotina que permitira que seja manuseado qualquer dado antes da rotina automatica.
			// Implementação feita dia 15/08/2012 - FSW IP Campinas
			IF lIPNfeGrv
				aParam := {aDet,nI}
				ExecBlock("IPNFEGRV",.F.,.F.,aParam)
			Endif
		Endif
		
		
		If Empty(cProduto)
			if ::lAuto
				aadd(aLogAuto, "A - Para o Produto Fornecedor " + AllTrim(aDet[nI,2])+"-"+AllTrim(aDet[nI,4]) + " NÃO foi informado o Produto Protheus")
				return
			else
				If cTipoLog == "1"
					MsgBox("Para o Produto Fornecedor " + AllTrim(aDet[nI,2])+"-"+AllTrim(aDet[nI,4]) + " NÃO foi informado o Produto Protheus","ALERT")
					Return
				Else
					aadd(aLog, "Para o Produto Fornecedor " + AllTrim(aDet[nI,2])+"-"+AllTrim(aDet[nI,4]) + " NÃO foi informado o Produto Protheus")
				EndIf
			endif
		EndIf
		
		dbSelectArea("SB1")
		SB1->(dbSetOrder(1))
		if SB1->(dbSeek(xFilial("SB1")+cProduto))
			if ::lAuto
				aadd(aLogAuto, "I - Produto Fornecedor: " + AllTrim(aDet[nI,2])+"-"+AllTrim(aDet[nI,4]) + " ====  Produto Protheus: " + alltrim(cProduto) + " - " + alltrim(SB1->B1_DESC))
			endif
			if SB1->B1_UM == Upper(cXMLUM)
				lPriUm 	:= .T.
			elseif SB1->B1_SEGUM == Upper(cXMLUM)
				lPriUm  := .F. //Ajuste Niemeyer - 06/10/2016 - Não estava gerando a Pré-Nota com Dados da Segunda Unidade de Medida convertida
				cPriUm  := SB1->B1_UM
				cSegUm 	:= SB1->B1_SEGUM
				nPriQtd := iif(SB1->B1_TIPCONV == "M", aDet[ni,6] * SB1->B1_CONV,aDet[ni,6] / SB1->B1_CONV) 
				nPriVlr	:= iif(SB1->B1_TIPCONV == "M", aDet[ni,7] / SB1->B1_CONV,aDet[ni,7] * SB1->B1_CONV)
				
				/*
				Ponto de entrada para tratar o valor das variáveis nPriQtd e nPriVlr conforme necessidade.
				*/
				IF lIPNfe1aUM
					aParam := {nPriQtd,nPriVlr,aDet[nI]}
					aParam := ExecBlock("IPNFE1AUM",.F.,.F.,aParam)
					If (ValType(aParam) == "A" .and. Len(aParam) >= 2 )
						nPriQtd	:= aParam[1]
						nPriVlr	:= aParam[2]
					EndIf
				Endif
				
				if SB1->B1_CONV == 0
					if ::lAuto
						aAdd(aLogAuto,"A - Produto com Fator de Conversão zerado :" + AllTrim(cProduto) + " Protheus:" + AllTrim(SB1->B1_UM) + "/" + AllTrim(SB1->B1_SEGUM) + " - XML:" + Upper(cXMLUM) )
						return
					else
						if cTipoLog == "1"
							MsgBox("Produto com Fator de Conversão zerado :" + AllTrim(cProduto) + CRLF + "Protheus:" + AllTrim(SB1->B1_UM) + "/" + AllTrim(SB1->B1_SEGUM) + " - XML:" + Upper(cXMLUM)  ,"","Alert")
							return
						else
							aAdd(aLog,"Produto com Fator de Conversão zerado :" + AllTrim(cProduto) + " Protheus:" + AllTrim(SB1->B1_UM) + "/" + AllTrim(SB1->B1_SEGUM) + " - XML:" + Upper(cXMLUM) )
						endif
					endif
				endif
				
			elseif cValUM == 'S' // se valida unidade de medida
				if ::lAuto
					aadd(aLogAuto, "A - Produto não consta unidade de medida válida :"+AllTrim(cProduto)+" Protheus:"+AllTrim(SB1->B1_UM)+"/"+AllTrim(SB1->B1_SEGUM)+" - XML:"+Upper(cXMLUM) )
					Return
				else
					If cTipoLog == "1"
						MsgBox("Produto não consta unidade de medida válida :"+AllTrim(cProduto)+CRLF+"Protheus:"+AllTrim(SB1->B1_UM)+"/"+AllTrim(SB1->B1_SEGUM)+" - XML:"+Upper(cXMLUM)  ,"","ALERT")
						Return
					Else
						aadd(aLog, "Produto não consta unidade de medida válida :"+AllTrim(cProduto)+" Protheus:"+AllTrim(SB1->B1_UM)+"/"+AllTrim(SB1->B1_SEGUM)+" - XML:"+Upper(cXMLUM) )
					EndIf
				endif
			endif
		endIf
		
		if lPriUm
			cUM			:= Transform(aDet[nI,5],PesqPict("SB1","B1_UM"))
			nQuant		:= aDet[ni,6]
			nVlrUnit    := aDet[ni,7]
			nTotal		:= aDet[ni,8]
			
		else
			cUM			:= Transform(cPriUm,PesqPict("SB1","B1_UM"))
			nQuant		:= nPriQtd
			nVlrUnit    := nPriVlr					//aDet[ni,7]
			nTotal		:= Round(nPriQtd * nPriVlr,2)
			
			c2UM		:= aDet[nI,5]
			n2Quant		:= aDet[ni,6]
		endif
		
		cLoteCTL := aDet[ni,13]
		
		aItem 		:= {}
		
		AADD(aItem,{"D1_ITEM" ,StrZero(nI,TamSX3("D1_ITEM")[1])	,Nil})
		AADD(aItem,{"D1_COD"  ,cProduto							,Nil})
		
		cNumPC := ""
		cItemPc:= ""
		If aCF[1,1,2]=="F" .AND. ( !Empty(::getPedCom()) .OR. !Empty(aDet[nI,10]) )
			cNumPC := IF( !Empty(aDet[nI,10]), aDet[nI,10], ::getPedCom())
			cItemPc:= IF(!Empty(aDet[nI,11]), aDet[nI,11], ::getItemPC(cNumPC, cProduto))			
			AADD(aItem,{"D1_PEDIDO",cNumPC ,Nil})
			AADD(aItem,{"D1_ITEMPC",cItemPc,Nil})
			//Incluído por Carlos Niemeyer - 22/12/2016
			//--Início
			cLocal := ::getLocalItemPC(cNumPC, cItemPc, cProduto)
			If !Empty(cLocal)
				AADD(aItem,{"D1_LOCAL",cLocal,Nil})
			Endif
			//--Término
		EndIf
		
		AADD(aItem,{"D1_QUANT",nQuant							,Nil})
		
		//Ajuste Niemeyer - 06/10/2016 - Tratar o Erro de cValUM = 'N" de Produtos com 2UM, falhando a conversão da UM
		If cValUM == 'S' .Or. !lPriUm
			AADD(aItem,{"D1_UM"   ,Upper(cUM)   					,Nil})
		Endif
		
		if !lPriUm
			AADD(aItem,{"D1_SEGUM",c2UM							,Nil})
			AADD(aItem,{"D1_QTSEGUM",n2Quant					,Nil})
		endif
		
		//Ajuste Niemeyer - 24/08/2016 - Tratar o Erro na Geração de 2º Unidade de Medida - A140VZ, mesmo com tudo preenchido
		AADD(aItem,{"D1_VUNIT",nVlrUnit							,Nil})
		AADD(aItem,{"D1_TOTAL",nTotal							,Nil})		
		
		If !Empty(cLoteCTL) .And. SB1->B1_RASTRO = "L"
				AADD(aItem,{"D1_LOTECTL",cLoteCTL					,Nil})
			if (FWUnitBusiness() <> DHL_BUSINESSUNIT_DIS) //Emerson Holanda 15/02/2021 - Tratamento para não preencher as datas do lote no array, pois o mesmo sera preenchido no ponto de entrada IPNFEITEM 
				AADD(aItem,{"D1_DTVALID",cTod("  /  /  ")			,Nil})
				If !Empty(cCpoDtFabr)
					AADD(aItem,{cCpoDtFabr,cTod("  /  /  ")			,Nil})
				EndIf
			endIf
		Else
			AADD(aItem,{"D1_LOTECTL",Space(10)					,Nil})
			AADD(aItem,{"D1_DTVALID",cTod("  /  /  ")			,Nil})
			If !Empty(cCpoDtFabr)
				AADD(aItem,{cCpoDtFabr,cTod("  /  /  ")			,Nil})
			EndIf
		EndIf
		
		// Ectore Cecato - 21/02/2014 - PE para validar as informações do item do XML x Pedido de Compra
		If lIPNfeVldItem
			aParam := {cNumNFE, cSerNFE, cFornece, cLoja, cNumPC, If(!Empty(aDet[nI,11]), aDet[nI,11], ::getItemPC(cNumPC, cProduto)), ;
				nQuant, nVlrUnit, nTotal}
			ExecBlock("IPNFEVLDITEM", .F., .T., aParam)
		EndIf
		
		// Yves - 01/08/2013 - PE para complementar informações no array de itens na geração da pré-nota via execauto
		IF lIPNfeItem
			if fTypeVar("oDetAux") <> "U"
				If	SB1->B1_RASTRO = "L"
					nIAux   := getIndDet(aDetAglutin, cProduto)
					oDetAux := oDet[nIAux]
				Else
					oDetAux := oDet[nI]
				EndIf
			else
				oDetAux := nil
			endif
			aAux := {}
			aAux := ExecBlock("IPNFEITEM", .F., .T.,{aDet[nI], oDetAux}) //Thiago Meschiatti
			For nCount := 1 To Len(aAux)
				AADD(aItem,aAux[nCount])
			Next nCount
		EndIf
		
		If	SB1->B1_RASTRO = "L"
			if !getDtValFabrRastro(aItem, aDet[nI])
				return
			endIf
		EndIf
		
		AADD(aItens,aItem)
		
	Next nI
	
	
	// Apresenta as diveregencias encontradas caso foi informado no parametro ZZ_LOGIPNF
	// para apresentar as divergencia via relatorio.
	if (cTipoLog == "2" .AND. Len(aLog) > 0) .and. !(::lAuto)
		::showLog(aLog, cNumNFE, cSerNfe)
		Return
	endif
	
	// Thiago Meschiatti - 31/10/2014 - PE para realização de alterações no array de item da rotina automatica
	IF ExistBlock("IPNFEALTITEM", .F., LFORCES3)
		FWLogMsg("INFO", , "BusinessObject", funName(), "", "01", "Entrou PE IPNFEALTITEM!!", 0, 0, {})
		aItens := ExecBlock("IPNFEALTITEM", .F., .T.,{aItens,oInfAdNf})
	endif
	
	//Ajuste Niemeyer - 29/07/2016
	//Retirado devido a alterar o Valor Unitário conforme o Pedido de Compra, independente do Valor do XML - Precisar usar a Ordem Específica
	//aItens := FWVetByDic( aItens , "SD1" , .T. )
	
	lMsErroAuto := .F.
	
	::setCab(aCab)		//Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	::setItens(aItens)	//Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
	
	nModulo  := 2
	if (::getModeSimula()) //Thiago Meschiatti - FSW TOTVS IP Campinas - 29/10/2015
		if ::lAuto
			FWLogMsg("INFO", , "BusinessObject", funName(), "", "01", "Processo de Simulaçao Finalizado! Nenhum movimento foi realizado.", 0, 0, {})
			aadd(aLogAuto, "I - Processo de Simulaçao Finalizado! Nenhum movimento foi realizado." )
		else
			MsgBox("Processo de Simulaçao Finalizado! Nenhum movimento foi realizado.","","INFO")
		endif
	else
		
		if ::lAuto
			FWLogMsg("INFO", , "BusinessObject", funName(), "", "01", "Gerando Pre-Nota ["+Alltrim(cNumNFE)+"/"+Alltrim(cSerNFE)+"] Fornecedor/Cliente ["+Alltrim(cFornece)+"/"+Alltrim(cLoja)+"]", 0, 0, {})
			MSExecAuto( { |x,y,z | MATA140(x,y,z) } , aCab , aItens , 3 )
		else
			MsgRun("Gerando Pre-Nota ["+Alltrim(cNumNFE)+"/"+Alltrim(cSerNFE)+"] Fornecedor/Cliente ["+Alltrim(cFornece)+"/"+Alltrim(cLoja)+"]",,{|| MSExecAuto( { |x,y,z | MATA140(x,y,z) } , aCab , aItens , 3 ) })
		endif
		
		If lMsErroAuto
			if ::lAuto
				cRotErro := Mostraerro(cFolderLog)
				FWLogMsg("ERROR", , "BusinessObject", funName(), "", "01", cRotErro, 0, 0, {})
				aadd(aLogAuto, "E - " + cRotErro)
			else
				Mostraerro()
			endif
			DisarmTransaction()
		Else
			::setSuccess(.t.)
			if ::lAuto
				aadd(aLogAuto, "I - Documento "+Alltrim(cNumNFE)+"/"+Alltrim(cSerNFE)+" Importado com sucesso " )
			else
				MsgBox("Documento "+Alltrim(cNumNFE)+"/"+Alltrim(cSerNFE)+" Importado com sucesso ","","INFO")
				conout("** TIMPNFE : DOCUMENTO IMPORTADO COM SUCESSO")
			endif
			
			// Chamada do ponto de entrada IPNFEFIM
			// Executado depois da geracao da pre nota de entrada.
			conout("** TIMPNFE : ANTES ENTRAR PE IPNFEFIM")
			IF ExistBlock("IPNFEFIM", .F., LFORCES3)	// Este terceiro parâmetro (.T.), força a Verificação e posteriormente execução inclusive no Série 3 - Waldir Baldin - 07/12/2012.
				conout("** TIMPNFE : ENTROU EXISTBLOCK")
				ExecBlock("IPNFEFIM", .F., .T.,{oInfAdNf}) //Thiago Meschiatti
			EndIf
		EndIf
	endif
	nModulo := nOldModulo
	
	conout("** TIMPNFE : FINALIZANDO A CLASSE TImpNfe")
	
	//Libera memoria apos o uso
	oDetAux	:= Nil
	aInfNFe	:= Nil
	oIdent5 := Nil
	oNfe	:= Nil
		
return self

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
//³ Converte data			                                           ³
//ÀÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÙ
method ConvDate(cData) Class TImpNfe
	
	Local cRet  := ""
	Local dData	:= CtoD("  /  /  ")
	
	cData  := StrTran(cData,"-","")
	dData  := Stod(cData)
	cRet   := PadR(StrZero(Day(dData),2)+ "/" + StrZero(Month(dData),2)+ "/" + StrZero(Year(dData),4),15)
	
Return cRet

//ÚÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄÄ¿
