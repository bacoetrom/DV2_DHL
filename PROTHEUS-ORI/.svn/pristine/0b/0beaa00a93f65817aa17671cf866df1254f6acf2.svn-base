/*/{Protheus.doc} setProduct

Define o Código do Produto
	
@author Victor Hugo
@since 03/11/2014

@param cProduct, String, Código do Produto
/*/
method setProduct(cProduct) class DHLProductId
	local oSql    := IpSqlObject():newIpSqlObject()
	::cProduct    := cProduct
	if !Empty(cProduct)
		::cDescription := oSql:getFieldValue("SB1", "B1_DESC", "B1_FILIAL = '%SB1.FILIAL%' AND B1_COD = '"+cProduct+"'")
	endIf	
return


