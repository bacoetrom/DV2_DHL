/*/{Protheus.doc} newDHLProductId

Construtor
	
@author Victor Hugo
@since 03/11/2014

@param nRecno, Numerico, Recno da Tabela SZ3 (Opcional. Se informado carrega os atributos do objeto)
/*/
method newDHLProductId(nRecno) class DHLProductId	
	
	if Empty(nRecno)
		::setBranch(xFilial("SZ3"))
		::setUnitValue(0)
		::setDate(dDataBase)
		::setTime(Time())
		::setIdentB6("")
		::setIcmsValue(0)
		::setIpiValue(0)
		::setSituation(DHL_ID_SITUACAO_NORMAL)		 
	else	
		loadData(@self, nRecno)	
	endIf
	
return self

/**
 * Carrega os dados do objeto
 */
static function loadData(oSelf, nRecno)
	
	local oSql := IpSqlObject():newIpSqlObject()
	
	oSql:newTable("SZ3", "*", "Z3_FILIAL = '%SZ3.FILIAL%' AND R_E_C_N_O_ = "+AllTrim(Str(nRecno)))
	
	oSelf:setRecno(nRecno)
	oSelf:setBranch(oSql:getValue("Z3_FILIAL"))
	oSelf:setId(oSql:getValue("Z3_ID"))
	oSelf:setProduct(oSql:getValue("Z3_PRODUTO"))
	oSelf:setUnitValue(oSql:getValue("Z3_VUNIT"))
	oSelf:setDate(oSql:getValue("Z3_DTMOV"))
	oSelf:setTime(oSql:getValue("Z3_HRMOV"))
	oSelf:setType(oSql:getValue("Z3_TPMOV"))
	oSelf:setDocument(oSql:getValue("Z3_DOC"))
	oSelf:setSeries(oSql:getValue("Z3_SERIE"))
	oSelf:setEntity(oSql:getValue("Z3_CLIFOR"))
	oSelf:setUnit(oSql:getValue("Z3_LOJA"))
	oSelf:setItem(oSql:getValue("Z3_ITEM"))
	oSelf:setStatus(oSql:getValue("Z3_STATUS"))
	oSelf:setIdentB6(oSql:getValue("Z3_IDENTB6"))
	oSelf:setSequence(oSql:getValue("Z3_SEQUEN"))
	oSelf:setIcmsValue(oSql:getValue("Z3_VALICM"))
	oSelf:setIpiValue(oSql:getValue("Z3_VALIPI"))
	oSelf:setSituation(oSql:getValue("Z3_SITUACA")) 
	
	oSql:close()
	
return


