static function DoSeqPag()
	local lFormatZero := .F.
	local cTax		  := "pag"
	local cAliq		  := "" 
	local cqBCProd	  := retValTax(cTax,cAliq, oDetPag, "qTrib","tributo")
	local cvAliqProd  := retValTax(cTax,cAliq, oDetPag, "aliquota","tributo")
	
	oPag_valorf := MsafNFeTag():newMsafNFeTag(" ")
                                                                                         
