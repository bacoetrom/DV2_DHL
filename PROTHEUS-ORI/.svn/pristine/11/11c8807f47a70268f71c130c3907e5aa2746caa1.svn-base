	oIPI:setAttributeValue("CNPJProd"	, retValTax(cTax,cAliq, oDetProd, "clEnq","tributo"))
	oIPI:setAttributeValue("cSelo"		, retValTax(cTax,cAliq, oDetProd, "cSelo","tributo"))
