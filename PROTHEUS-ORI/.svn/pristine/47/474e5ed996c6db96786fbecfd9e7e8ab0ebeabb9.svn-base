** Monta mensagem de log para itens de diferentes depositantes no documento(Origem)
*/
Static Function fMsgOrigDep(oSqlSZB)
	Local cMsgError := ""

	cMsgError += "O documento possuí itens de diferentes depositantes e/ou Produto sem amarração Produto x Cliente!"+CRLF
	cMsgError += "--------------------------------------------------------------"+CRLF
	
Return (cMsgError)


