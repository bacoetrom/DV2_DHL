Metodo que valida se cliente existe
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cCnpj, caracter, CNPJ do cliente
/*/
method validCustomer(cCnpj, cBuyCode) class DHLIp040Sap
	Local lError		:= .t.
	
	Default cCnpj := ""
	Default cBuyCode := ""
	
	::oSql:newTable("SA1", "A1_COD", fQrySA1(cCnpj, cBuyCode))
	
	If ::oSql:hasRecords()
		lError := .f.
	EndIf
	
	::oSql:close()
return (lError)


/*/{Protheus.doc} isBlockedCustomer
Metodo que valida se cliente esta bloqueado
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cCnpj, caracter, CNPJ do cliente
/*/
method isBlockedCustomer(cCnpj, cBuyCode) class DHLIp040Sap
	Local lError		:= .f.
	
	Default cCnpj := ""
	
	::oSql:newTable("SA1", "A1_MSBLQL", fQrySA1(cCnpj, cBuyCode))
	
	If ::oSql:getValue("A1_MSBLQL") == BLOCKED
		lError := .t.
	EndIf
	
	::oSql:close()
return (lError)


/*/{Protheus.doc} isEqualSf3
Metodo que valida itens aglutinados SZB são iguais a gerados SF3
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param nQtyLinSZA, numeric, quantidade de linhas que SF3 deve conter
/*/
method isEqualSf3(nQtyLinSZA) class DHLIp040Sap
	
	Local lRet := .t.
	
	::oSql:newAlias(fQrySF3())
	
	If ::oSql:hasRecords()
		If nQtyLinSZA # val(::oSql:getValue("QTY_LIN_F3"))
			lRet := .f.
		EndIf
	EndIf
	
	::oSql:close()
return (lRet)


/*/{Protheus.doc} hasNfRco
Metodo que verifica se deve conter NF RCO 
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param oSqlSZB, object, Objeto contendo itens da tabela SZB(IP_040) 
/*/
method hasNfRco(oSqlSZB) class DHLIp040Sap
	Local lRet	:= .f.

	lRet :=  oSqlSZB:getValue("EST_RCO") == "RCO"
	
return (lRet)


/*/{Protheus.doc} validations
Metodo que executa validações 
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param oSqlSZB, object, Objeto contendo itens da tabela SZB(IP_040) 
/*/
method validations(oSqlSZB) class DHLIp040Sap
	Local lRet		:= .t.	
	
	If ::validCustomer(SZA->ZA_BUYCNPJ, SZA->ZA_BUYCODE)
		::addMsgError(fMsgCustomer(SZA->ZA_BUYCNPJ, SZA->ZA_BUYCODE))
		lRet := .f.
	Else
		If ::isBlockedCustomer(SZA->ZA_BUYCNPJ, SZA->ZA_BUYCODE)
			::addMsgError(fMsgBloqCust(SZA->ZA_BUYCNPJ, SZA->ZA_BUYCODE))
			lRet := .f.
		Endif
	EndIf
	
	If ::validCarrier(SZA->ZA_CNPJCAR)
		::addMsgError(fMsgCarrier())
		lRet := .f.
	EndIf 
	//Emerson Holanda 30/04/18 - Verifica se não foram encontrados erros acima, pois a rotina abaixo executa update na SZB.
	If lRet
		While oSqlSZB:notIsEof()		
		
			If !(::validRefSc6(oSqlSZB))
				::addMsgError(fMsgInvRLog(oSqlSZB))
				lRet := .f.
			EndIf
		
			oSqlSZB:skip()
		EndDo
	EndIf
	oSqlSZB:goTop()	
	
return (lRet)


/*/{Protheus.doc} updateFields
Metodo que executa atualização de campos
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cTabTo, caracter, tabela de origem
@param cFieldTo, caracter, campo de origem
@param xValue, undefined, valor a incluir no campo  
/*/
method updateFields(cTabTo, cFieldTo, xValue) class DHLIp040Sap
	Local nI := 0
	
	(cTabTo)->(RecLock(cTabTo, .f.))
		(cTabTo)->&(cFieldTo) 	:= xValue
	(cTabTo)->(MsUnlock())
return


/*/{Protheus.doc} showLogError
Metodo que mostra tela de erro
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
/*/
method showLogError() class DHLIp040Sap
	If !Empty(::getMsgError())
		Aviso("Atenção",::getMsgError(),{"OK"},3)
	EndIf
return


/*/{Protheus.doc} AtualizNfVinc
Metodo que atualiza array de NF Vinculadas para NFs RCO
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param aNota, array, Informações da NF
@param aNfVinc, array, Informações NF de origem
/*/
Method AtualizNfVinc(aNota, aNfVinc) Class DHLIp040Sap
	
	Local oSql			:= IpSqlObject():newIpSqlObject()
	local cDoc 			:= aNota[2]
	Local cSerie			:= aNota[1]
	Local cTypeNF			:= aNota[4]
	
	If cTypeNF == SAIDA
		
		oSql:newAlias(getQryNfScj(cDoc, cSerie))
		
		While oSql:notIsEof()
			aAdd( aNfVinc, { 	StoD(oSql:getValue("ZA_DUEDATE")),+;
							oSql:getValue("ZA_SERISCJ"),+;
							oSql:getValue("ZA_DOCSCJ"),+;
							oSql:getValue("ZA_CNPJSCJ"),+;
							"",+;
							"",+;
							oSql:getValue("ZB_KENFSCJ") } )
			oSql:skip()
		End
	
		oSql:close()	
	EndIf

Return


/*/{Protheus.doc} getGroupSZB
Metodo que coleta informações da SZB aglutinadas com indice da tabela SF3
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cKeyScj, caracter, Chave NF SCJ
/*/
method getGroupSZB(cKeyScj) class DHLIp040Sap

	Local oSqlGroup := IpSqlObject():newIpSqlObject()
	
	oSqlGroup:newAlias(fQryGroupSZB(cKeyScj))

return (oSqlGroup)


/*/{Protheus.doc} getQtyLinSf3
Metodo que coleta quantidade de linhas da tabela SZB aglutinadas por indice de tabela SF3
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cKeyScj, caracter, Chave NF SCJ
/*/
method getQtyLinSf3(cKeySCJ) class DHLIp040Sap

	Local nQty	 := 0
	Local cQuery := ""
		
	cQuery := "SELECT COUNT(*) AS F3QTLIN "
	cQuery += "FROM "
	cQuery += "( "
	cQuery += "SELECT ZB_KENFSCJ, ZB_CFOP, ZB_ICMTXRT "
	cQuery += "FROM " + RetSqlName("SZB") + " SZB "
	cQuery += "WHERE ZB_FILIAL      = '" + xFilial("SZB") + "' AND "
	cQuery += "      ZB_KENFSCJ     = '" + cKeySCJ + "'   AND "
	cQuery += "      SZB.D_E_L_E_T_ = ' '  "
	cQuery += "GROUP BY "
	cQuery += "      ZB_KENFSCJ, ZB_CFOP, ZB_ICMTXRT "
	cQuery += ") "
	
	::oSql:newAlias(cQuery)
	
	If ::oSql:hasRecords()
		nQty := ::oSql:getValue("F3QTLIN")
	EndIf

	::oSql:close()
				
return (nQty)


/*/{Protheus.doc} getGroupSf3
Metodo que coleta quantidade de linhas da tabela SZB aglutinadas por indice de tabela SF3
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cKeyScj, caracter, Chave NF SCJ
/*/
method getGroupSf3(cKeySCJ) class DHLIp040Sap

	Local nQty	 := 0
	Local cQuery := ""
	
	retCposSf3()
		
	cQuery := "SELECT ZB_KENFSCJ, ZB_CFOP, ZB_ICMTXRT "
	cQuery += "FROM "
	cQuery += "( "
	cQuery += "SELECT ZB_KENFSCJ, ZB_CFOP, ZB_ICMTXRT "
	cQuery += "FROM " + RetSqlName("SZB") + " SZB "
	cQuery += "WHERE ZB_FILIAL      = '" + xFilial("SZB") + "' AND "
	cQuery += "      ZB_KENFSCJ     = '" + cKeySCJ + "'   AND "
	cQuery += "      SZB.D_E_L_E_T_ = ' '  "
	cQuery += "GROUP BY "
	cQuery += "      ZB_KENFSCJ, ZB_CFOP, ZB_ICMTXRT "
	cQuery += ") "
	
	::oSql:newAlias(cQuery)
	
	If ::oSql:hasRecords()
		nQty := ::oSql:getValue("F3QTLIN")
	EndIf

	::oSql:close()
				
return (nQty)


/*/{Protheus.doc} getGroupSf3
Metodo que coleta itens da tabela SZB
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cKeyScj, caracter, Chave NF SCJ
/*/
method getItensSZB(cKeyScj) class DHLIp040Sap

	Local oSql	 := IpSqlObject():newIpSqlObject()
	Local cQuery := ""

	cQuery += " SELECT  													"+CRLF
	cQuery += " 	CASE WHEN A1_EST = 'AM' THEN 'RCO' ELSE '' END EST_RCO  "+CRLF
	cQuery += " 	,A7_CLIENTE                                  			"+CRLF
	cQuery += " 	,A7_LOJA                                     			"+CRLF
	cQuery += " 	,SZB.*                                       			"+CRLF
	cQuery += " FROM %SZB.SQLNAME%                               			"+CRLF
	cQuery += " LEFT JOIN %SA7.SQLNAME% ON                       			"+CRLF
	cQuery += " 	1=1                                          			"+CRLF
	cQuery += " 	AND A7_FILIAL 	= ZB_FILIAL                  			"+CRLF
	cQuery += " 	AND A7_PRODUTO 	= ZB_ITEM                    			"+CRLF
	cQuery += " 	AND %SA7.NOTDEL%                             			"+CRLF
	cQuery += " LEFT JOIN SA1100 SA1 ON                          			"+CRLF
	cQuery += " 	1=1                                          			"+CRLF
	cQuery += " 	AND A1_FILIAL 	= A7_FILIAL                  			"+CRLF
	cQuery += " 	AND A1_COD 		= A7_CLIENTE				 			"+CRLF
	cQuery += " 	AND A1_LOJA 	= A7_LOJA					 			"+CRLF
	cQuery += " 	AND %SA1.NOTDEL%							 			"+CRLF		
	cQuery += " WHERE											 		"+CRLF
	cQuery += " 	1=1                                          			"+CRLF
	cQuery += " 	AND %SZB.XFILIAL%                            			"+CRLF
	cQuery += " 	AND ZB_KENFSCJ	= '" + cKeyScj + "'  					"+CRLF
	cQuery += " 	AND %SZB.NOTDEL%							 			"+CRLF
	cQuery += " ORDER BY ZB_FILIAL, ZB_KENFSCJ, TO_NUMBER(ZB_LINITEM)		"+CRLF
	
	oSql:newAlias(cQuery)
	
Return (oSql)


Static Function fQryTes(nIcmsValue, nIcmsStValue, nIcmsRedBValue, nIcmsDifalValue, cIcmsZFM)
	Local cQuery := ""
	
	cQuery += " 	1=1                                                               "+CRLF
	cQuery += " 	AND %SZC.XFILIAL%                                                 "+CRLF
	cQuery += " 	AND ZC_ICMPROP	= '" + Iif(nIcmsValue > 0, 'S', 'N') + "'         "+CRLF
	cQuery += " 	AND ZC_ICMREDB 	= '" + Iif(nIcmsRedBValue > 0, 'S', 'N') + "'       "+CRLF
	cQuery += " 	AND ZC_ICMST		= '" + Iif(nIcmsStValue > 0, 'S', 'N') + "'     "+CRLF
	cQuery += " 	AND ZC_ICMDIFA	= '" + Iif(nIcmsDifalValue > 0, 'S', 'N') + "'    "+CRLF
	cQuery += " 	AND ZC_ICMZFM		= '" + Iif(cIcmsZFM $ "7" , 'S', 'N') + "'    "+CRLF
		
Return (cQuery)


Static Function fQrySZD(cAlias)
	Local cQuery := ""
	
	cQuery += " 	1=1                                                               "+CRLF
	cQuery += " 	AND %SZD.XFILIAL%                                                 "+CRLF
	cQuery += " 	AND ZD_TABDE	= '" + cAlias + "'         					  "+CRLF
		
Return (cQuery)


Static Function cQryFilTab(cTabFrom, cTabTo, aFieldsTo, oSqlSZA, oSqlSZB)
	Local cQuery := ""
	
	Default cTabFrom := ""
	Default cTabTo   := ""
	
	If (cTabTo == "SF2")
	
		cQuery += " 1=1                            	 "+CRLF
		cQuery += " AND %SF2.XFILIAL%              	 "+CRLF
		cQuery += " AND F2_DOC 		= '" + oSqlSZA:getValue("ZA_NFRCO")   + "'       "+CRLF
		cQuery += " AND F2_SERIE	= '" + oSqlSZA:getValue("ZA_SERIRCO") + "'       "+CRLF
		                                    
	ElseIf (cTabTo == "SF3")                
		                                    
		cQuery += " 1=1                              "+CRLF
		cQuery += " AND %SF3.XFILIAL%                "+CRLF
		cQuery += " AND F3_NFISCAL	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND F3_SERIE	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND F3_CLIEFOR	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND F3_LOJA		= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND F3_CFO		= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND F3_ALIQICM	= '" + oSqlAux:getValue() + "'       "+CRLF
		                                    
	ElseIf (cTabTo == "SFT")                
	                                        
		cQuery += " 1=1                              "+CRLF
		cQuery += " AND %SFT.XFILIAL%                "+CRLF
		cQuery += " AND FT_TIPOMOV	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND FT_SERIE	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND FT_NFISCAL	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND FT_CLIEFOR	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND FT_LOJA		= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND FT_ITEM		= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND FT_PRODUTO	= '" + oSqlAux:getValue() + "'       "+CRLF
		                                    
	ElseIf (cTabTo == "CD2")                
                                            
		cQuery += " 1=1                              "+CRLF
		cQuery += " AND %CD2.XFILIAL%                "+CRLF
		cQuery += " AND CD2_TPMOV	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND CD2_SERIE	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND CD2_DOC		= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND CD2_CODCLI	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND CD2_LOJCLI	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND CD2_ITEM	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND CD2_CODPRO	= '" + oSqlAux:getValue() + "'       "+CRLF
		cQuery += " AND CD2_IMP		= '" + oSqlAux:getValue() + "'       "+CRLF

	EndIf
	
Return (cQuery)


Static Function fQryRefSc6(oSqlSZB)
	Local cQuery := ""

	cQuery += " SELECT C6_NUM, C6_ITEM, (C6_QTDVEN - C6_QTDENT - ISNULL(ZB_QUANTIT, 0)) SALDO "	+CRLF
	cQuery += " FROM %SC5.SQLNAME%																			"+CRLF
	cQuery += " INNER JOIN %SC6.SQLNAME% ON																"+CRLF
	cQuery += " 	1=1																							"+CRLF
	cQuery += " 	AND C6_FILIAL 	= C5_FILIAL															"+CRLF
	cQuery += " 	AND C6_NUM 		= C5_NUM																"+CRLF
	cQuery += " 	AND C6_PRODUTO	= '" + oSqlSZB:getValue("ZB_ITEM") + "'							"+CRLF
	cQuery += " 	AND %SC6.NOTDEL%																			"+CRLF
	cQuery += " LEFT JOIN %SZB.SQLNAME% ON																	"+CRLF
	cQuery += " 	1=1																							"+CRLF
	cQuery += " 	AND ZB_FILIAL     = C5_FILIAL															"+CRLF
	cQuery += " 	AND ZB_PEDIDO     = C6_NUM																"+CRLF
	cQuery += " 	AND ZB_ITEMPV     = C6_ITEM																"+CRLF
	cQuery += " 	AND %SZB.NOTDEL%																			"+CRLF
	cQuery += " WHERE																							"+CRLF
	cQuery += " 	1=1																							"+CRLF
	cQuery += " 	AND %SC5.XFILIAL%																			"+CRLF
	cQuery += " 	AND C5_ZZSHIP	= '" + AllTrim(SZA->ZA_SHIPNUM) + "'									"+CRLF
	cQuery += " 	AND C5_ZZORDEX 	= '" + oSqlSZB:getValue("ZB_DELIVER") + "'						"+CRLF
	cQuery += " 	AND (C6_QTDVEN - C6_QTDENT - ISNULL(ZB_QUANTIT, 0)) >= " + AllTrim(Str(oSqlSZB:getValue("ZB_QUANTIT"))) + CRLF
	cQuery += " 	AND %SC5.NOTDEL%                                                     "+CRLF
	
Return (ChangeQuery(cQuery))


/*
** Query para transportora SA4
*/
Static Function fQrySA4(cCnpj)
	Local cQuery := ""
	
	cQuery += " 	1=1                                                               "+CRLF
	cQuery += " 	AND %SA4.XFILIAL%                                                 "+CRLF
	cQuery += " 	AND A4_CGC	= '" + cCnpj + "'         					  "+CRLF
		
Return (cQuery)


/*
** Query para Cliente SA1
*/
Static Function fQrySA1(cCnpj, cBuyCode)
	Local cQuery := ""
	
	cQuery += " 	1=1                                                               "+CRLF
	cQuery += " 	AND %SA1.XFILIAL%                                                 "+CRLF
	If Empty(cCnpj)
		cQuery += " 	AND A1_ZZCLSAP	= '" + cBuyCode + "'         			    "+CRLF
	Else
		cQuery += " 	AND A1_CGC	= '" + cCnpj + "'         					    "+CRLF
	Endif
		
Return (cQuery)


/*
** Query para Cliente SA1
*/
Static Function fQrySF3()
	Local cQuery := ""
	                                                                                      
	cQuery += " SELECT COUNT(F3_NFISCAL) QTY_LIN_F3                                                   "+CRLF
	cQuery += " FROM %SF3.SQLNAME%                                                                    "+CRLF
	cQuery += " WHERE                                                                                 "+CRLF
	cQuery += " 	1=1                                                                               "+CRLF
	cQuery += " 	AND %SF3.XFILIAL%                                                                 "+CRLF
	cQuery += " 	AND F3_NFISCAL	= '" + SF2->F2_DOC + "'                                           "+CRLF
	cQuery += " 	AND F3_SERIE	= '" + SF2->F2_SERIE + "'                                         "+CRLF
	cQuery += " 	AND F3_CLIEFOR	= '" + SF2->F2_CLIENTE + "'                                       "+CRLF
	cQuery += " 	AND F3_LOJA		= '" + SF2->F2_LOJA + "'                                          "+CRLF
	cQuery += " 	AND %SF3.NOTDEL%                                                                  "+CRLF
	cQuery += " GROUP BY                                                                              "+CRLF
	cQuery += " 	F3_FILIAL,F3_ENTRADA,F3_NFISCAL,F3_SERIE,F3_CLIEFOR,F3_LOJA,F3_CFO,F3_ALIQICM     "+CRLF
		
Return (cQuery)


/*
** Query para Produto SB1
*/
Static Function fQrySB1(cProduct)
	Local cQuery := ""
	
	cQuery += " 	1=1                                                               "+CRLF
	cQuery += " 	AND %SB1.XFILIAL%                                                 "+CRLF
	cQuery += " 	AND B1_COD	= '" + cProduct + "'         					  	  "+CRLF
		
Return (cQuery)


/*
** Query para aglutinada SF3
*/
Static Function fQryGroupSZB(cKeyScj)
	Local cQuery 	:= ""
	Local cFields	:= retCposSZB()
	
	cQuery += "SELECT ZB_KENFSCJ, ZB_CFOP CFOP, ZB_ICMTXRT  ALIQICM, ZB_ICMTXRT "
	cQuery += cFields
	cQuery += " FROM %SZB.SQLNAME%  "
	cQuery += "WHERE ZB_FILIAL      = '" + xFilial("SZB") + "' AND "
	cQuery += "      ZB_KENFSCJ     = '" + cKeySCJ + "'   AND "
	cQuery += "      SZB.D_E_L_E_T_ = ' '  "
	cQuery += "GROUP BY "
	cQuery += "      ZB_KENFSCJ, ZB_CFOP, ZB_ICMTXRT, ZB_PREDBAS "
	
return (cQuery)



/*
** Monta mensagem de log para não localização da invoice request para  faturamento
*/
Static Function fMsgInvRLog(oSqlSZB)
	Local cMsgError := ""

	cMsgError += "Invoice Request para o item " + AllTrim(oSqlSZB:getValue("ZB_ITEM")) + " não encontrada "+CRLF
	cMsgError += "Shipment: " + AllTrim(SZA->ZA_SHIPNUM) + " / Delivery: " + AllTrim(oSqlSZB:getValue("ZB_DELIVER")) + ")."+CRLF
	cMsgError += "--------------------------------------------------------------"+CRLF
	
Return (cMsgError)


