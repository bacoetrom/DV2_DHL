	::oSqlSZB	 	:= IpSqlObject():newIpSqlObject()
	::oUtils		:= IpUtilsObject():newIpUtilsObject()
	::aFieldsSZA 	:= {}
	::aFieldsSZB 	:= {}
	::setSZAFields()
	::setSZBFields()
	::setMsgError("")
