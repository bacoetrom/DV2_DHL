** Monta mensagem de log Transportadora
*/
Static Function fMsgCarrier(cCnpj)
	Local cMsgError := ""

	cMsgError += "Não foi localizada a Transportadora para o CNPJ " +  AllTrim(Transform(cCnpj, "@R 99.999.999/9999-99")) +CRLF
	cMsgError += "--------------------------------------------------------------"+CRLF
	
Return (cMsgError)


/*
** Monta mensagem de log Transportadora
*/
Static Function fMsgCustomer(cCnpj, cBuyCode)
	Local cMsgError := ""

	If Empty(cCnpj)
		cMsgError += "Não foi localizado o Cliente para o Código SAP " +  AllTrim(cBuyCode) +CRLF
	Else
		cMsgError += "Não foi localizado o Cliente para o CNPJ " +  AllTrim(Transform(cCnpj, "@R 99.999.999/9999-99")) +CRLF
	Endif
	cMsgError += "--------------------------------------------------------------"+CRLF
	
Return (cMsgError)


/*
** Monta mensagem de Bloqueio de cliente
*/
Static Function fMsgBloqCust(cCnpj, cBuyCode)
	Local cMsgError := ""

	If Empty(cCnpj)
		cMsgError += "Cliente para o Código SAP " +  AllTrim(cBuyCode) + " esta bloqueado! " +CRLF
	Else
		cMsgError += "Cliente para o CNPJ " +  AllTrim(Transform(cCnpj, "@R 99.999.999/9999-99")) + " esta bloqueado! " +CRLF
	EndIf
	cMsgError += "--------------------------------------------------------------"+CRLF
	
Return (cMsgError)


/*
** Abrir tabelas
*/
Static Function openTables()
	
	DbSelectArea("SD2")
	SD2->(DbSetOrder(3))
	
	DbSelectArea("SF3")
	SF3->(DbSetOrder(1))
	
	DbSelectArea("SFT")
	SFT->(DbSetOrder(1))
	
	DbSelectArea("CD2")
	CD2->(DbSetOrder(1))
	
	DbSelectArea("SB1")
	SB1->(DbSetOrder(1))
return


/**
* Define SUM da query SF3 Group
**/
static function retCposSf3()
	
	Local cFieldsSum	:= ""
	Local nCount		:= 0
	local aCposSX3		:= FWSX3Util():GetAllFields("SF3", .f.)
	
	for nCount := 1 to len(aCposSX3)
	
		If  X3Uso(getSX3Cache(aCposSX3[nCount],"X3_USADO")) .and. cNivel >= getSX3Cache(aCposSX3[nCount],"X3_NIVEL") .and.;
		 	getSX3Cache(aCposSX3[nCount],"X3_TIPO") == "N"
			
			
			cFieldsSum += ", SUM(" + aCposSX3[nCount] + ") " + aCposSX3[nCount]
		EndIf
	
	next nCount
	
Return (cFieldsSum)


/**
* Define SUM da query SF3 Group
**/
static function retCposSZB()
	
	Local cFieldsSum	:= ""
	Local nCount		:= 0
	Local aCposSX3		:= FWSX3Util():GetAllFields("SZB", .f.)
	
	for nCount := 1 to len(aCposSX3)
	
		If  X3Uso(getSX3Cache(aCposSX3[nCount],"X3_USADO")) .and. cNivel >= getSX3Cache(aCposSX3[nCount],"X3_NIVEL") .and.;
		 	getSX3Cache(aCposSX3[nCount],"X3_TIPO") == "N"
			
			If aCposSX3[nCount] # "ZB_ICMTXRT"
				cFieldsSum += ", SUM(" + aCposSX3[nCount] + ") " + aCposSX3[nCount]
			EndIf
		EndIf
	
	next nCount
	
Return (cFieldsSum)


/* 
** Consulta para localizar as Chaves da NF SCJ
*/
Static Function getQryNfScj(cDoc, cSerie)
	Local cQuery := ""

	cQuery += " SELECT DISTINCT ZB_KENFSCJ, ZA_DUEDATE, ZA_DOCSCJ, ZA_SERISCJ, ZA_CNPJSCJ "+CRLF
	cQuery += " FROM %SF2.SQLNAME% "+CRLF
	cQuery += " INNER JOIN %SD2.SQLNAME% ON "+CRLF 
	cQuery += " 		1=1 "+CRLF
	cQuery += " 		AND D2_FILIAL 	= F2_FILIAL "+CRLF
	cQuery += " 		AND D2_DOC 		= F2_DOC "+CRLF
	cQuery += " 		AND D2_SERIE 		= F2_SERIE "+CRLF
	cQuery += " 		AND D2_CLIENTE 	= F2_CLIENTE "+CRLF
	cQuery += " 		AND D2_LOJA 		= F2_LOJA "+CRLF
	cQuery += " 		AND %SD2.NOTDEL% "+CRLF
	cQuery += " INNER JOIN %SZA.SQLNAME% ON "+CRLF
	cQuery += " 		1=1 "+CRLF
	cQuery += " 		AND ZA_FILIAL 	= D2_FILIAL "+CRLF
	cQuery += " 		AND ZA_DOCSCJ		= D2_NFORI "+CRLF
	cQuery += " 		AND ZA_SERISCJ	= D2_SERIORI "+CRLF
	cQuery += " 		AND %SZA.NOTDEL% "+CRLF
	cQuery += " INNER JOIN %SZB.SQLNAME% ON "+CRLF
	cQuery += " 		1=1 "+CRLF
	cQuery += " 		AND ZB_FILIAL		= ZA_FILIAL "+CRLF
	cQuery += " 		AND ZB_KENFSCJ	= ZA_KENFSCJ "+CRLF
	cQuery += " 		AND ZB_LINITEM	= D2_ITEMORI "+CRLF
	cQuery += " 		AND %SZB.NOTDEL% "+CRLF
	cQuery += " WHERE "+CRLF
	cQuery += " 		1=1 "+CRLF
	cQuery += " 		AND F2_DOC 		= '" + cDoc + "' "+CRLF
	cQuery += " 		AND F2_SERIE		= '" + cSerie + "' "+CRLF
	cQuery += " 		AND %SF2.XFILIAL% "+CRLF
	cQuery += " 		AND %SF2.NOTDEL%  "+CRLF
Return (cQuery)