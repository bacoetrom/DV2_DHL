@param cCnpj, caracter, CNPJ da transportadora 
/*/
method getCarrier(cCnpj) class DHLIp040Sap
	Local cCarrier	:= ""
	
	Default cCnpj	:= ""
	
	::oSql:newTable("SA4", "A4_COD", "%SA4.XFILIAL% AND A4_CGC = '" + cCnpj + "' ")
	
	If ::oSql:hasRecords()
		cCarrier := ::oSql:getValue("A4_COD")
	EndIf
	
	::oSql:close()

return (cCarrier)


/*/{Protheus.doc} setFieldsSzd
Metodo monta e seta estrutura de campos baseado em estrutura SZD
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cAlias, caracter, Alias da tabela 
/*/
method setFieldsSzd(cAlias) class DHLIp040Sap
	Local cFields	:= "ZD_TABDE, ZD_CPODE, ZD_TABPARA, ZD_CPOPARA"
	
	::oSql:newTable("SZD", cFields, fQrySZD(cAlias))
	
	If ::oSql:hasRecords()
		if cAlias == "SZA"
			dbEval( { || aAdd( ::afieldsSZA , {::oSql:getValue("ZD_TABDE"), ::oSql:getValue("ZD_CPODE"),::oSql:getValue("ZD_TABPARA"),::oSql:getValue("ZD_CPOPARA")} ) } , , { || ::oSql:notIsEof() } )
		elseif cAlias == "SZB"
			dbEval( { || aAdd( ::afieldsSZB , {::oSql:getValue("ZD_TABDE"), ::oSql:getValue("ZD_CPODE"),::oSql:getValue("ZD_TABPARA"),::oSql:getValue("ZD_CPOPARA")} ) } , , { || ::oSql:notIsEof() } ) 
		EndIf
	EndIf
	
	::oSql:close()
return


/*/{Protheus.doc} getTesOperation
Metodo coleta TES baseado em regras de definição de impostos contidos na interface IP_040
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param nIcmsValue, numeric, Valor do ICMS
@param nIcmsStValue, numeric, Valor do ICMS ST
@param nIcmsRedBValue, numeric, Valor do ICMS Redução de Base
@param nIcmsDifalValue, numeric, Valor do ICMS Difal
@param cIcmsZFM, caracter, Código de isenção do ICMS
/*/
method getTesOperation(nIcmsValue, nIcmsStValue, nIcmsRedBValue, nIcmsDifalValue, cIcmsZFM) class DHLIp040Sap
	Local cTes := ""
	Local ::oSql := IpSqlObject():newIpSqlObject()

	default nIcmsValue     := 0
	default nIcmsStValue   := 0
	default nIcmsRedBValue := 0
	default nIcmsRedBValue := 0
	default cIcmsZFM 		 := ""
	
	::oSql:newTable("SZC", "ZC_TES TES", fQryTes(nIcmsValue, nIcmsStValue, nIcmsRedBValue, nIcmsDifalValue, cIcmsZFM))
	
	If ::oSql:hasRecords()
		cTes := ::oSql:getValue("TES")
	EndIf
	
	::oSql:close()
	
return(cTes)


/*/{Protheus.doc} validValues
Metodo que valida informaçõe de impostos e sobrescreve em caso de difrença
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param oSqlSZB, object, Objeto contendo itens da tabela SZB(IP_040)
@param oSqlGroup, object, Objeto contendo valores aglutinados para comparação com tabela SF3
/*/
method validValues(oSqlSZB, oSqlGroup) class DHLIp040Sap
	Local aAreas	:= ::oUtils:saveAreas({"SF2", "SD2", "SF3", "SFT", "CD2", "SB1"})
	Local nI		:= 0
	Local cCfop	:= ""
	Local cAliq	:= ""
	Local lOk	:= .t.
	Local lOkPos	:= .t.
	openTables()
	
	FWLogMsg("INFO", , "BusinessObject", funName(), "", "01", "*********************INICIO METODO  validValues IN DHLIp040Sap.PRW " + time() + " USUARIO " + PswRet()[1][2]  + " ********************" + CRLF, 0, 0, {})
	
	For nI := 1 to Len(::aFieldsSZA)
		If ::aFieldsSZA[nI, TABLE_TO] $ "SF2" 
			If &("SZA->" + ::aFieldsSZA[nI, FIELD_FROM]) # &("SF2->"+::aFieldsSZA[nI, FIELD_TO])
				::updateFields(::aFieldsSZA[nI, TABLE_TO], ::aFieldsSZA[nI, FIELD_TO], &("SZA->" + ::aFieldsSZA[nI, FIELD_FROM]))
			EndIf
		EndIf
	Next nI
	
	While oSqlSZB:notIsEof()
		If !lOkPos
			exit
		EndIf
		
		lOk := .f.
		If SD2->(DbSeek(SF2->(F2_FILIAL + F2_DOC + F2_SERIE + F2_CLIENTE + F2_LOJA) + oSqlSZB:getValue("ZB_ITEM") + padl(alltrim(oSqlSZB:getValue("ZB_LINITEM")),2, '0')))
			If SFT->(DbSeek(SD2->(D2_FILIAL + "S" + D2_SERIE + D2_DOC + D2_CLIENTE + D2_LOJA + PadR(D2_ITEM, TamSx3("FT_ITEM")[1]) + D2_COD)))
				SB1->(DbSeek(xFilial("SB1") + SD2->D2_COD))
				
				For nI := 1 to Len(::aFieldsSZB)
					
					If ::aFieldsSZB[nI, TABLE_TO] $ "SD2|SFT|SB1|"
						If oSqlSZB:getValue("ZB_PREDBAS") > 0 
							If !(::aFieldsSZB[nI, FIELD_TO] $ FIELDS_ICMS_RED_BASE)  
								If oSqlSZB:getValue(::aFieldsSZB[nI, FIELD_FROM]) # &(::aFieldsSZB[nI, TABLE_TO] + "->" + ::aFieldsSZB[nI, FIELD_TO])
									::updateFields(::aFieldsSZB[nI, TABLE_TO], ::aFieldsSZB[nI, FIELD_TO], oSqlSZB:getValue(::aFieldsSZB[nI, FIELD_FROM]))
								EndIf
							EndIf
						Else
							If oSqlSZB:getValue(::aFieldsSZB[nI, FIELD_FROM]) # &(::aFieldsSZB[nI, TABLE_TO] + "->" + ::aFieldsSZB[nI, FIELD_TO])
								::updateFields(::aFieldsSZB[nI, TABLE_TO], ::aFieldsSZB[nI, FIELD_TO], oSqlSZB:getValue(::aFieldsSZB[nI, FIELD_FROM]))
							EndIf
						EndIf
					ElseIf ::aFieldsSZB[nI, TABLE_TO] $ "CD2|"
					
						If ::aFieldsSZB[nI, FIELD_FROM] $ FIELDS_ICMS
							If CD2->(dbSeek(SD2->(D2_FILIAL + "S" + D2_SERIE + D2_DOC + D2_CLIENTE + D2_LOJA + PadR(D2_ITEM, TamSx3("FT_ITEM")[1]) + D2_COD) + "ICM"))
								lOk := .t.
							EndIf
						ElseIf ::aFieldsSZB[nI, FIELD_FROM] $ FIELDS_ICMS_ST
							If CD2->(dbSeek(SD2->(D2_FILIAL + "S" + D2_SERIE + D2_DOC + D2_CLIENTE + D2_LOJA + PadR(D2_ITEM, TamSx3("FT_ITEM")[1]) + D2_COD) + "SOL"))
								lOk := .t.
							EndIf
						ElseIf ::aFieldsSZB[nI, FIELD_FROM] $ FIELDS_ICMS_DIFAL
							If CD2->(dbSeek(SD2->(D2_FILIAL + "S" + D2_SERIE + D2_DOC + D2_CLIENTE + D2_LOJA + PadR(D2_ITEM, TamSx3("FT_ITEM")[1]) + D2_COD) + "CMP"))
								lOk := .t.
							EndIf
						ElseIf ::aFieldsSZB[nI, FIELD_FROM] $ FIELDS_ICMS_SUFRAMA
							If CD2->(dbSeek(SD2->(D2_FILIAL + "S" + D2_SERIE + D2_DOC + D2_CLIENTE + D2_LOJA + PadR(D2_ITEM, TamSx3("FT_ITEM")[1]) + D2_COD) + "ZFM"))
								lOk := .t.
							EndIf
						EndIf
		
						If lOk
							If oSqlSZB:getValue(::aFieldsSZB[nI, FIELD_FROM]) # &(::aFieldsSZB[nI, TABLE_TO] + "->" + ::aFieldsSZB[nI, FIELD_TO])
								::updateFields(::aFieldsSZB[nI, TABLE_TO], ::aFieldsSZB[nI, FIELD_TO], oSqlSZB:getValue(::aFieldsSZB[nI, FIELD_FROM]))
							EndIf
						EndIf
				
					EndIf
				Next nI
			Else
				lOkPos := .f.
			EndIf
		Else
			lOkPos := .f.
		EndIf
		
		oSqlSZB:skip()
	EndDo
	
	If lOkPos
		While oSqlGroup:notIsEof()
			cCfop	:= ""
			
			If (SF2->F2_EST == GetNewPar("MV_ESTADO", ""))
				cCfop := oSqlGroup:getValue("CFOP")
			Else
				cCfop := "6" + Subs( oSqlGroup:getValue("CFOP"),2,Len( oSqlGroup:getValue("CFOP") ) - 1 ) 
			Endif
			
			If oSqlGroup:getValue("ZB_PREDBAS") > 0
				cAliq := "0.00"
			Else
				cAliq := str(oSqlGroup:getValue("ALIQICM"), 5, 2)
			EndIf
			
			If SF3->(DbSeek(SF2->(F2_FILIAL + Dtos(F2_EMISSAO) + F2_DOC + F2_SERIE + F2_CLIENTE + F2_LOJA) + cCfop + cAliq))
				
				For nI := 1 to Len(::aFieldsSZB)
					If ::aFieldsSZB[nI, TABLE_FROM] $ "SZB" .AND. ::aFieldsSZB[nI, TABLE_TO] $ "SF3" 
						If oSqlGroup:getValue("ZB_PREDBAS") > 0
							If !(::aFieldsSZB[nI, TABLE_TO] $ FIELDS_ICMS_RED_BASE)  
								If oSqlGroup:getValue(::aFieldsSZB[nI, FIELD_FROM]) # &("SF3->"+::aFieldsSZB[nI, FIELD_TO])
									::updateFields(::aFieldsSZB[nI, TABLE_TO], ::aFieldsSZB[nI, FIELD_TO], oSqlGroup:getValue(::aFieldsSZB[nI, FIELD_FROM]))
								EndIf
							Endif
						Else
							If oSqlGroup:getValue(::aFieldsSZB[nI, FIELD_FROM]) # &("SF3->"+::aFieldsSZB[nI, FIELD_TO])
								::updateFields(::aFieldsSZB[nI, TABLE_TO], ::aFieldsSZB[nI, FIELD_TO], oSqlGroup:getValue(::aFieldsSZB[nI, FIELD_FROM]))
							EndIf
						EndIf
					EndIf
				Next nI
			Else
				lOkPos := .f.
				exit
			EndIf
		
			oSqlGroup:skip()
		EndDo
	EndIf
		
	::oUtils:restAreas(aAreas)
	
	FWLogMsg("INFO", "LAST", "BusinessObject", funName(), "", "01", "*********************FIM METODO  validValues IN DHLIp040Sap.PRW " + time() + " USUARIO " + PswRet()[1][2]  + " ********************" + CRLF, 0, 0, {})
	
return (lOkPos)


/*/{Protheus.doc} validRefSc6
Metodo que realiza o vinculo da tabela SZB com o pedido de venda
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param oSqlSZB, object, Objeto contendo itens da tabela SZB(IP_040)
/*/
method validRefSc6(oSqlSZB) class DHLIp040Sap
	
	Local oSqlAux := IpSqlObject():newIpSqlObject()
	Local cWhere  := ""
	Local lRet    := .f.
	Local aAreas  := ::oUtils:saveAreas({"SZB"})
	
	::oSql:NewAlias(fQryRefSc6(oSqlSZB))
	
	If ::oSql:hasRecords()
		cWhere := "%SZB.XFILIAL% AND ZB_KENFSCJ = '" + oSqlSZB:getValue("ZB_KENFSCJ") + "' AND ZB_LINITEM = '" + oSqlSZB:getValue("ZB_LINITEM") + "'"
		oSqlAux:update("SZB", "ZB_PEDIDO = '" + ::oSql:getValue("C6_NUM") + "', ZB_ITEMPV = '" + ::oSql:getValue("C6_ITEM") + "'", cWhere)
	
		lRet := .t.
	EndIf
	
	::oSql:close()
	
	::oUtils:restAreas(aAreas)
		
return (lRet)


/*/{Protheus.doc} validCarrier
Metodo que valida se transportadora existe
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cCnpj, caracter, CNPJ da transportadora
/*/
method validCarrier(cCnpj) class DHLIp040Sap
	Local lError		:= .t.
	
	Default cCnpj := ""
	
	::oSql:newTable("SA4", "A4_COD", fQrySA4(cCnpj))
	
	If ::oSql:hasRecords()
		lError := .f.
	EndIf
	
	::oSql:close()
return (lError)


