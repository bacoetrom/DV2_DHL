#include 'protheus.ch'
#include 'dhl.ch'

#Define TABLE_FROM	1
#Define FIELD_FROM 	2
#Define TABLE_TO 	3
#Define FIELD_TO 	4

#Define FIELDS_ICMS			"ZB_ICMTXBS|ZB_ICMTXVL|ZB_ICMTXRT|"
#Define FIELDS_ICMS_ST			"ZB_ICMSTBS|ZB_ICMSTVL|ZB_ICMSTRT|ZB_VFCPUFD|ZB_MVA|"
#Define FIELDS_ICMS_DIFAL		"ZB_VFCPUFD|ZB_MVA|"
#Define FIELDS_ICMS_SUFRAMA	"ZB_DISCISM|ZB_VLDIICM"
#Define FIELDS_ICMS_RED_BASE	"F3_ALIQICM|F3_BASEICM|F3_VALICM|FT_ALIQICM|FT_BASEICM|FT_VALICM|"

#Define UPD_FIELD	1
#Define UPD_VALUE	2

#define SAIDA			"1"

#define BLOCKED		"1"

/*/{Protheus.doc} DHLIp040Sap
Classe para processamentos da interface IP_040
@author Thiago Meschiatti
@since 19/05/2017
@version 1.0
@example
(examples)
@see (links_or_references)
