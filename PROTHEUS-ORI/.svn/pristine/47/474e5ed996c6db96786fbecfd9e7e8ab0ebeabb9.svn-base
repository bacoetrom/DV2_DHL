/*/{Protheus.doc} getCustomerUnit
Metodo que coleta o codido e loja do cliente, podendo receber Codigo SAP A1_ZZCLSAP ou CNPJ/CPF
@author Thiago Meschiatti
@since 21/08/2017 
@version 1.0
@param cCodSap, caracter, Codigo SAP
@param cCnpj, caracter, CNPJ/CPF do cliente 
/*/
method getCustomerUnit(cCodSap, cCnpj) class DHLIp040Sap
	Local cCustomer	:= ""
	Local cUnit		:= ""
	Local cWhere	:= ""
	
	Default cCodSap := ""
	Default cCnpj	:= ""
	
	If !Empty(cCnpj)
		cWhere := " AND A1_CGC = '" + cCnpj + "' "
	ElseIf !Empty(cCodSap)
		cWhere := " AND A1_ZZCLSAP = '" + cCodSap + "' "
	EndIf
	
	::oSql:newTable("SA1", "A1_COD, A1_LOJA", "%SA1.XFILIAL%" + cWhere)
	
	If ::oSql:hasRecords()
		cCustomer := ::oSql:getValue("A1_COD")
		cUnit	  := ::oSql:getValue("A1_LOJA")
	EndIf
	
	::oSql:close()

return ({cCustomer, cUnit})


