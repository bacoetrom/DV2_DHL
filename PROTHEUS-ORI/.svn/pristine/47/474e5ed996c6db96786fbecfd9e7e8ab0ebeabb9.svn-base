	data aFieldsSZA
	data aFieldsSZB
	data cMsgError
	data lNfRco
	data oSql
	data oSqlSZB
	data oUtils

	method newDHLIp040Sap() constructor 
	method getTesOperation()
	method validations()
	method validRefSc6()
	method validValues()
	method validCarrier()
	method validCustomer()
	method isBlockedCustomer()
	method validOrigProd()
	method isEqualSf3()
	method hasNfRco()
	method updateFields()
	method showLogError()
	Method AtualizNfVinc()
	
	method getGroupSZB()
	method getQtyLinSF3()
	method getGroupSf3()
	method getItensSZB()
	method getCustomerUnit()
	method getCarrier()
	method setFieldsSzd()
	method setSZBFields()
	method getSZBFields()
	method setSZAFields()
	method getSZAFields()
	method addMsgError()
	method getMsgError()
	method setMsgError()
	method hasNfRet()
	method setNfRet()
	
endclass

