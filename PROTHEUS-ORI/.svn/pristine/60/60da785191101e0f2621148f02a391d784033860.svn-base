/*/{Protheus.doc} DHLSafx

Classe com as regras e metodos genericos para os layouts
masterSaf DW
	
@author Daniel Braga
@since 31/10/2014

/*/
user function _Safx;return 

class DHLSafx
	
	data aFields 		as Array
	data oHeaderSql 	as Object
	data oDetailSql   as Object
	
	method newDHLSafx() constructor
	
	method getFields()
	method setFields(aFields)
	
	method getHeaderSql()
	method setHeaderSql(oHeaderSql)
	
	method getDetailSql()
	method setDetailSql(oDetailSql)
	
	method initialize(nTamPos,oHeaderSql,oDetailSql)
	method addField(nPos, xValue ) 
	method getSupCusRecords(cType,cCod,cBranch)
	method getTaxRecord(cType,cDoc,cSer,cCod,cLoja) 
	method getFlowsRecord(cType,cDoc,cSer,cCod,cBranch,lDeleted)
	method getImportAdd(cDoc,cSer,cCod,cBranch) 
	method getItemFlowsRecord(cType,cDoc,cSer,cCod,cBranch)
	method getTypeInOutFlow(cCod)
	method getEletricPower(cType,cDoc,cSer,cCod,cBranch) 
	method getTelecomAdd(cType,cDoc,cSer,cCod,cBranch)
	method getProduct(cCod)
	method populatedResult(oObj,cWhere,cFields,cTable)
	method validRequired(aFields)
	method getFieldValue(xField,xObj) 
	method getFieldSql(cField)
	method addLog(cTitle,cError,cFile) 
	method salveDateExp(cField) 
	method iniValFields(cAlias,aFlds , nFld)
	method fieldListSX3(cAlias)
	method getCodTypeMsg(cTipo)
	method getMsgFlow(cType,cDoc,cSer,cCusSup,cBranch)
	method prepareEnvironment()         
	method isBlocked()  
	method getProdType()
	method getTypeDoc(cDoc,cSer,cCod,cBranch)
	method getSumItems(cType,cDoc,cSer,cCusSup,cBranch)
	method isCutover(cType,cDoc,cSer,cCod,cBranch)
	method getRefItem(cType,cDoc,cSer,cItem)
	method getUfTaxes(cType, cTypeDoc, cSerie, cDoc, cCliFor, cLoja, cItem)

endClass

