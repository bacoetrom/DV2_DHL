/*/{Protheus.doc} populatedResult

Informacoes do produto
	
@author Daniel Braga
@since 31/10/2014

@param oObj 	, String, Objeto SQL
@param cWhere 	, String, condicoes do where
@param cFields, String, campos 
@param cTable 	, String, tabela


@return Array valores das entidades  encontradas
/*/
method populatedResult(oObj,cSql) class DHLSafx	
    local nFields := 0
	local aFields := {}
	local cAlias  := ""
	
	oObj:newAlias(cSql)
	
	cAlias  := oObj:getAlias()
	nFields := (cAlias)->( FCount() )
	aFields := Array(nFields,2)
	
	if !oObj:notIsEof()	
		return ::iniValFields(cAlias,aFields , nFields)
	endIf
	
	while oObj:notIsEof()
	
		  for nI := 1 to nFields
		  	aFields[nI,2] := (cAlias)->( FieldName(nI) )
		  	aFields[nI,1] := (cAlias)->( FieldGet(nI) )
		  
		  next nI
		  
		  exit
	endDo
	oObj:close()
return aFields

/*/{Protheus.doc} iniValFields

(Descrição da Função, Classe ou Método)
	
@author Daniel Braga
@since 12/11/2014

@param cAlias, String, Alias da query
@param aFlds , Array , Array dos campos vazios
@param nFlds , Integer, Quantidade de campos na query

@return TipoRet DescricaoRet
/*/
method iniValFields(cAlias,aFlds , nFld) class DHLSafx
 
 local lIniPad	  := .F.	
 local cFieldName := ""
 local nI		  := 0
 local aArea	  := SX3->(getArea())
 
 default aFlds 	:= {}
 default nFld		:= 0
 default cAlias 	:= ""


	for nI := 1 to nFld
		cFieldName := (cAlias)->( FieldName(nI) )
		
		if !allTrim(cFieldName) $ "R_E_C_D_E_L_|R_E_C_N_O_" 
			aFlds[nI,2] := cFieldName
			aFlds[nI,1] := CriaVar(cFieldName, lIniPad)
		endIf
	
	next nI
	
	SX3->(restArea(aArea))
return aFlds

