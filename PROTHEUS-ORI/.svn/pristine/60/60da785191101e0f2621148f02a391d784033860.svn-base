/*/{Protheus.doc} addField

(Descricaoo da Funcaoo, Classe ou Metodo)
	
@author Daniel Braga
@since 31/10/2014

@param aPos	, Array, Array com as posicaoes do layout 
@param xValue	, todos , valor da coluna 

@return TipoRet DescricaoRet
/*/
method addField(aField, xValue, lFormatZero ) class DHLSafx	
	local nPos  	:= 0
	local nSize 	:= 0
	local oObj 	:= MsafDWFile():newMsafDWFile()
	
	default aField := {}
	default xValue := ""
	default lFormatZero := .T.

	nPos := aField[POS_FIELD]
	nSize:= aField[POS_SIZE]
	
	::aFields[ aField[POS_FIELD] ] := padr( oObj:formatValue(xValue, aField, lFormatZero),nSize," ")

return 

/*/{Protheus.doc} getSupCusRecords

Cliente e fornecedores
	
@author Daniel Braga
@since 31/10/2014

@param cType, String, Tipo de entidade
@param cCod , String, Codigo da entidade
@param cBranch, String, loja da entidade

@return Array valores das entidades  encontradas
/*/
method getSupCusRecords(cType,cCod,cBranch)  class DHLSafx

	local oIpSqlObject :=  IpSqlObject():newIpSqlObject()
	local cWhere := ""
	local cTable  :=""
	local cPrefix := ""
	local cSql		:= ""
	
	
	default cType 	:= ""
	default cCod  	:= ""
    default cBranch := ""
       
	if cType  == "1"
		cTable := "SA2"
	else 
		cTable := "SA1"
	endIf 
	
	cPrefix := PrefixoCpo(cTable)
	
	cWhere := cPrefix+"_FILIAL = '%"+cTable+".FILIAL%' AND "+cPrefix+"_COD = '" +cCod+ "' and "+cPrefix+"_LOJA ='"+cBranch+"' and d_e_l_e_t_ = ' ' " 
	
	cSql   := "select "+::fieldListSX3(cTable)+" from "+retSqlName(cTable)+" where "+ cWhere 
	
	aFields := ::populatedResult(oIpSqlObject,Upper(cSql))
	
	if (oIpSqlObject:aliasExists())
		oIpSqlObject:close()
	endif


return  aFields

/*/{Protheus.doc} getTaxRecord

Impostos 
	
@author Daniel Braga
@since 31/10/2014

@param cType, String, Tipo de entidade
@param cDoc , String, numero do documento
@param cSer , String, serie do documento
@param cCod , String, Codigo da entidade
@param cBranch, String, loja da entidade

@return Array valores das entidades  encontradas
/*/
method getTaxRecord(cType,cDoc,cSer,cCod,cBranch,cItem) class DHLSafx	
	local oIpSqlObject 	:=  IpSqlObject():newIpSqlObject()
	local cWhere			:= "" 
	local cSql      		:= "" 
	
	default cType := ''
	default cItem := ''
	
	if empty(cType)
		cWhere := "ft_filial = '%sft.filial%' and ft_serie= '"+cSer+"' and ft_nfiscal ='"+cDoc+"' and "+;
		 		  " ft_cliefor ='"+cCod+"' and ft_loja ='"+cBranch+"'"		 		  
	else
		cWhere := "ft_filial = '%sft.filial%' and ft_tipomov='" + iif(cType $ '1', 'E', 'S') + "' and ft_serie= '"+cSer+"' and ft_nfiscal ='"+cDoc+"' and "+;
		 		  " ft_cliefor ='"+cCod+"' and ft_loja ='"+cBranch+"'"
	endif
	
	if !empty(cItem)
		cWhere += " and ft_item = '"+cItem+"' "
	endif
	 		  
	cSql:= "select "+::fieldListSX3("SFT")+" from "+retSqlName("SFT")+" where "+cWhere
	
	aFields := ::populatedResult(oIpSqlObject,cSql)
	
	if (oIpSqlObject:aliasExists())
		oIpSqlObject:close()
	endif

return aFields

/*/{Protheus.doc} getFlowsRecord

Documento de entrada e saida 
	
@author Daniel Braga
@since 31/10/2014

@param cType, String, Tipo de entidade
@param cDoc , String, numero do documento
@param cSer , String, serie do documento
@param cCod , String, Codigo da entidade
@param cBranch, String, loja da entidade

@return Array valores das entidades  encontradas
/*/
method getFlowsRecord(cType,cDoc,cSer,cCod,cBranch,lDeleted) class DHLSafx
	local oIpSqlObject :=  IpSqlObject():newIpSqlObject()
	local cWhere := ""
	local cTable  :=""
	local cPrefix := ""
	local cSQL 	:= ""
	local aFields := {}

	default lDeleted := .f.
       
	if cType  == "2"
		cTable := "SF2"
	else 
		cTable := "SF1"
	endIf 
	
	cPrefix := PrefixoCpo(Upper(cTable))
	
	cWhere := cPrefix+"_filial= '%"+cTable+".filial%' and "+cPrefix+"_doc = '" +cDoc+ "' and "+cPrefix+"_serie ='"+cSer+"' and "
	if cType == "2"
		cWhere += cPrefix+"_cliente = '"+cCod+"' and "
	else 
		cWhere += cPrefix+"_fornece = '"+cCod+"' and "
	endIf
	cWhere +=  cPrefix+"_loja='"+cBranch+"' "
	if !lDeleted
		cWhere += " and d_e_l_e_t_ = ' ' "
	endif
	
	cSql := "select "+::fieldListSX3(cTable)+" from "+retSqlName(cTable)+ " where "+cWhere
	
	
	aFields := ::populatedResult(oIpSqlObject,cSql)
	
	if (oIpSqlObject:aliasExists())
		oIpSqlObject:close()
	endif
	
return aFields

