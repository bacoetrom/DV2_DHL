/*/{Protheus.doc} validRequired

Valida os campos obrigatorios
	
@author Daniel Braga
@since 31/10/2014

@param aFields, Array, Array com os campos obrigatorios

@return String descricao dos erros
/*/
method validRequired(aFields) class DHLSafx
	
	local cError 		:= ""
	local aFieldReq 	:= aFields
	local nI			:= 0
	local xValue		:= nil
	
	for nI := 1 to len(aFieldReq)
		xValue :=  ::getFields()[ aFieldReq[nI,1,1] ]
		if Empty( xValue ) .or. allTrim(xValue) == "@"
			cError += aFieldReq[nI,2]+","
		endIf
	next nI
	

return cError

/*/{Protheus.doc} getFieldValue

(Descricao da Funcao, Classe ou MŽtodo)
	
@author Daniel Braga
@since 31/10/2014

@param xField, todos, nome dos campos
@param xObj  , todos, array ou objeto com os valores

@return todos valor dos campos
/*/
method getFieldValue(xField,xObj)  class DHLSafx
	
	local xValue 		:= nil
	local cPrefix		:= ""
	local nPos			:= 0
	
	default xField 	:= ""
	default xObj		:= nil

	
	if ValType(xField)  == "C" .and. xObj == nil 
		
		if ValType(::oHeaderSql) == "C"  
			if AliasInDic(::oHeaderSql)  	
				xValue := (::oHeaderSql)->( FieldGet(FieldPos(xField)) ) 
			elseif Upper(left(xField,3)) == "MV_"
				xValue :=  getMv(xField)
			
			endIf
		else
			if Upper(left(xField,3)) == "ZZ_"
				xValue :=  getMv(xField)
			else
				xValue := ::getFieldSql(xField)
			endif
			
		endIf
			
	elseIf ValType(xField)  == "C" .and. ValType(xObj) == "A"
		nPos := aScan(xObj , {|x| allTrim(x[2]) == allTrim(xField)   })
		if nPos > 0
			xValue := xObj[nPos,1]
		else 
			xValue := ""
		endIf	
    endIf 
	
return xValue

/*/{Protheus.doc} getFieldSql

trata os objetos oHeaderSql e oDetailSql
	
@author Daniel Braga
@since 31/10/2014

@param cField, Strinf, nome do campo

@return String valor do campo 
/*/
method getFieldSql(cField) class DHLSafx
		

	local nPosField 	:= 0 
	local cAlias		:= ""
	local xValue		:= nil
		
	if ::oHeaderSql <> nil
		
		cAlias := ::getHeaderSql():getAlias()
		nPosField := (cAlias)->( FieldPos(cField))
		
		if nPosField > 0
			xValue := ::getHeaderSql():getValue(cField)
			if Empty(xValue)
					if Empty(TamSx3(cField))
						return ""
					else
						return CriaVar(cField)
					endIf
			else 
				return xValue
			endIf	
		endIf
	
	endIf
	
	if ::oDetailSql <> nil
		
		cAlias := ::getDetailSql():getAlias()
		nPosField := (cAlias)->( FieldPos(cField))
		
		if nPosField > 0
			return ::getDetailSql():getValue(cField)
		endIf
	
	endIf
	
		
return "" 

method addLog(cTitle,cError,cFile) class DHLSafx
	local oLog 		:= DHLLogManager():newDHLLogManager()
	
	oLog:start(APP_MASTERSAF_DW, DHL_EXPORTACAO,cFile)
	oLog:fail(cTitle, cError)
return

/*/{Protheus.doc} salveDateExp

Faz a marcacao do registro exportado 
	
@author Daniel Braga
@since 30/10/2014

/*/
method salveDateExp(cField) class DHLSafx

	local cAlias 	:= ::getHeaderSql()
	local cPrefix	:= PrefixoCpo(cAlias)
	local nPos		:= 0	
	
	default cField := "ZZMSDW"
	
	nPos := (cAlias)->( FieldPos(cPrefix+"_"+cField) )
	
	(cAlias)->( recLock(cAlias,.f.) )
	(cAlias)->( FieldPut(nPos,date()) )	
	(cAlias)->(msUnlock())
	
return
