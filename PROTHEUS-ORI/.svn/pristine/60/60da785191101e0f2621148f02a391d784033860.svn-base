	local aFields := {}

	default cItem := ''
       
	if cType  == "2"
		cTable := "SD2"
	else 
		cTable := "SD1"
	endIf 
	
	cPrefix := PrefixoCpo(cTable)
	
	cWhere := cPrefix+"_filial= '%"+cTable+".filial%' and "+cPrefix+"_doc = '" +cDoc+ "' and "+cPrefix+"_serie ='"+cSer+"' and "
	if cType == "2"
		cWhere += cPrefix+"_cliente = '"+cCod+"' and "
	else 
		cWhere += cPrefix+"_fornece = '"+cCod+"' and "
	endIf
	cWhere +=  cPrefix+"_loja='"+cBranch+"' "
	
	if !empty(cItem)
		cWhere += " and "+cPrefix+"_item = '"+cItem+"' and "+cPrefix+"_tes <> '   '"
	endif
	 
	cSql := " select "+::fieldListSX3(cTable)+" from "+retSqlName(cTable)+" where "+cWhere
	
	aFields := ::populatedResult(oIpSqlObject,Upper(cSql))

	if (oIpSqlObject:aliasExists())
