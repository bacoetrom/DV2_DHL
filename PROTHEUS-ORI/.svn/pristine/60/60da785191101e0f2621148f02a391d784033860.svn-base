/*/{Protheus.doc} getMsgFlow

Retorna as mensagens da nota da SZZ
	
@author Daniel Braga
@since 17/11/2014

@param cType	, String, Tipo da nota 
@param cDoc	, String, Documento
@param cSer	, String, Serie
@param cCusSup, String, Cliente/Fornecedor
@param cBranch, String, Filial


@return String Mensagem da nota
/*/

method getMsgFlow(cType,cDoc,cSer,cCusSup,cBranch) class DHLSafx
	
	local oSqlSZZ :=  IpSqlObject():newIpSqlObject() 
	local cMens	:= ""	
	local cSql		:= ""
	
	cSql := "select * from "+retSqlName("SZZ")+" where zz_filial ='"+xfilial("SZZ")+"' and "+;
			 " zz_tipodoc= '"+cType+"' and zz_doc='"+cDoc+"' and zz_serie ='"+cSer+"' and "+;
			 " zz_clifor ='"+cCusSup+"' and zz_loja='"+cBranch+"' and d_e_l_e_t_= ' ' "
	
	oSqlSZZ:newAlias( Upper(cSql) )
	
	while oSqlSZZ:notIsEof()
	
		cMens += alltrim(oSqlSZZ:getValue("ZZ_TXTMENS")) + " "
		
		oSqlSZZ:skip()
	endDo
	
	oSqlSZZ:close()
cMens := strtran( cMens , '"','') // joj JJ 2019-01-02 - erro na safx se tem " na observacao
return cMens


/*/{Protheus.doc} prepareEnvironment

Prepara o ambiente Protheus para Geração das Interfaces
	
@author Victor Hugo
@since 10/12/2014

@param aCompany, Array, Empresa/Filial para Processamento. Ex.: aCompany[1] - Empresa, aCompany[2] - Filial. Obrigatorio quando em Job.
/*/
method prepareEnvironment(aCompany) class DHLSafx
	
	local lOk  			:= .F.
	local cCompany		:= ""
	local cBranch		:= ""
	local lJob 			:= (Type("oMainWnd") != "O")
	local oEnv 			:= IpEnvironmentObject():newIpEnvironmentObject()
	default aCompany	:= {}
	
	if lJob .and. (Len(aCompany) == 0)
		FWLogMsg("WARN", , "BusinessObject", funName(), "", "01", "[MASTERSAFDW] Empresa/Filial não definida para processamento via Job", 0, 0, {})	
		return .F.
	endIf
	
	if (Len(aCompany) > 0)	
		cCompany := aCompany[1]
		cBranch  := aCompany[2]	
	else
		cCompany := cEmpAnt
		cBranch  := cFilAnt		
	endIf
	
	oEnv:setCompany(cCompany)  
	oEnv:setBranch(cBranch) 
	oEnv:load()
	
return .T.


/*/{Protheus.doc} isBlocked

Verifica se um registro está bloqueado. Necessita estar posicionado no registro.
	
@author Victor Hugo
@since 23/12/2014

@param cAlias, String, Alias do registro
/*/
method isBlocked(cAlias) class DHLSafx
	
	local lBlocked    := .F.
	local cValue      := ""
	local cField      := PrefixoCpo(cAlias)+"_MSBLQL"
	local lExistField := (cAlias)->(FieldPos(cField) > 0)
	
	if lExistField                 
		cValue   := (cAlias)->&cField
		lBlocked := (cValue == "1")
	endIf	 
	
return lBlocked 


/*/{Protheus.doc} getProdType

Coleta o Tipo de Produtos Mastersaf DW
	
@author Victor Hugo
@since 23/12/2014

@param lParametro, Booleano, Indica se foi localizado o tipo nos parâmetros (Personalização Bloco K) 12/12/2018

@return String Tipo do Produto no Mastersaf DW
/*/
method getProdType(cErpType, lParametro) class DHLSafx
	
	local cDwType := ""
	
	default lParametro := .F.
	
	cErpType := Upper(AllTrim(cErpType))
	
	if lParametro
		if (cErpType == "PA")
			cDwType := SAFX_TIPO_PRODUTO
		elseIf (cErpType == "MP")
			cDwType := SAFX_TIPO_MAT_PRIMA_INSUMO
		elseIf (cErpType == "EM")
			cDwType := SAFX_TIPO_EMBALAGEM
		elseIf (cErpType == "ME")
			cDwType := SAFX_TIPO_OUTROS
		elseIf (cErpType == "SP")
			cDwType := SAFX_TIPO_OUTROS
		elseIf (cErpType == "PP")
			cDwType := SAFX_TIPO_EM_ELABORACAO
		elseIf (cErpType == "PI")
			cDwType := SAFX_TIPO_MAT_PRIMA_INSUMO
		else
			cDwType := SAFX_TIPO_OUTROS	
		endIf
	else
	
		if (cErpType == "PA")
			cDwType := SAFX_TIPO_PRODUTO
		elseIf (cErpType == "MP")
			cDwType := SAFX_TIPO_MAT_PRIMA_INSUMO
		elseIf (cErpType == "EM")
			cDwType := SAFX_TIPO_EMBALAGEM
		else
			cDwType := SAFX_TIPO_OUTROS	
		endIf
	
	endIf
	
return cDwType  

/*/{Protheus.doc} getTypeDoc

Coleta o tipo da NF
	
@author Thiago Meschiatti
@since 12/02/2015

@param cErpType, String, Tipo do Produto no Protheus

@return String Tipo do Produto no Mastersaf DW
/*/
method getTypeDoc(cDoc, cSer,cCod,cBranch,lCobert,cOrigem) class DHLSafx
	local cType 	:= ''
	local cQuery 	:= ''
	local oSql		:= IpSqlObject():newIpSqlObject()
	
	default cOrigem := ""
	
	default lCobert := .f.
	
	if lCobert
		return '1'
	endif
	
	if EMPTY(cOrigem)
	
		cQuery += " SELECT F3_CFO "
		cQuery += " FROM %SF3.SQLNAME% "
		cQuery += " WHERE "
		cQuery += " 	%SF3.XFILIAL% "
		cQuery += " 	AND F3_NFISCAL = '" + cDoc + "' AND F3_SERIE = '" + cSer + "' "
		//cQuery += " 	AND F3_CLIEFOR = '" + cCod + "' AND F3_LOJA  = '" + cBranch + "' "
		
		oSql:newAlias(cQuery)
		
		if oSql:hasRecords()
			while oSql:notIsEof()
				if empty(oSql:getValue("F3_CFO"))
					oSql:skip()
				else
					cType := iif(val(oSql:getValue("F3_CFO")) < 5000 , "1","2" )
					exit
				endif
			end 
		endif
	Else
		IF cOrigem == "SD1"
			cType := "1"
		else
			cType := "2"
		endif		
	EndIf
	
	oSql:close()

return (cType)

/*/{Protheus.doc} getTaxRecord

Impostos 
	
@author Daniel Braga
@since 31/10/2014

@param cType, String, Tipo de entidade
@param cDoc , String, numero do documento
@param cSer , String, serie do documento
@param cCod , String, Codigo da entidade
@param cBranch, String, loja da entidade

@return Array valores das entidades  encontradas
/*/
method getSumItems(cType,cDoc,cSer,cCod,cBranch) class DHLSafx	
	local oIpSqlObject 	:=  IpSqlObject():newIpSqlObject()
	local cWhere			:= "" 
	local cSql      		:= "" 
	
	default cType := ''
	
	if empty(cType)
		cWhere := "ft_filial = '%sft.filial%' and ft_serie= '"+cSer+"' and ft_nfiscal ='"+cDoc+"' and "+;
		 		  " ft_cliefor ='"+cCod+"' and ft_loja ='"+cBranch+"' and %sft.notdel%"
	else
		cWhere := "ft_filial = '%sft.filial%' and ft_tipomov='" + iif(cType $ '1', 'E', 'S') + "' and ft_serie= '"+cSer+"' and ft_nfiscal ='"+cDoc+"' and "+;
		 		  " ft_cliefor ='"+cCod+"' and ft_loja ='"+cBranch+"' and %sft.notdel%"
	endif
	 		  
	cSql:= " select sum(ft_frete) frete, sum(ft_seguro) seguro, sum(ft_descont) descont, sum(ft_valirr) valirf, sum(ft_baseins) baseins, "
 	cSql+= " sum(ft_icmscom) icmscom, sum(ft_baseicm) baseicm, sum(ft_baseirr) baseirr, sum(ft_baseret) baseret, "
 	cSql+= " sum(ft_bretcsl) bretcsl, sum(ft_vretcsl) vretcsl, sum(ft_total) total, sum(ft_valcont) valcont 
	cSql+= " from "+retSqlName("SFT")+" sft where "+cWhere
	
	aFields := ::populatedResult(oIpSqlObject,cSql)
	
	if (oIpSqlObject:aliasExists())
		oIpSqlObject:close()
	endif

return aFields


/*/{Protheus.doc} isCutover

Documento de cutover? Sim ou Não
	
@author Thiago Meschiatti
@since 31/10/2014

@param cType, String, Tipo de entidade
@param cDoc , String, numero do documento
@param cSer , String, serie do documento
@param cCod , String, Codigo da entidade
@param cBranch, String, loja da entidade

@return Array valores das entidades  encontradas
/*/
method isCutover(cType,cDoc,cSer,cCod,cBranch) class DHLSafx
	local oIpSqlObject	:=  IpSqlObject():newIpSqlObject()
	local cWhere 		:= ""
	local cTable  		:= ""
	local cField		:= ""
	local cPrefix 		:= ""
	local cSQL 			:= ""
	local lCutover		:= .f.
	local aFields := {}

	if cType  == "2"
		cTable := "SF2"
		cField := "F2_SERIE"
	else 
		cTable := "SF1"
		cField := "F1_ZZCUTOV"
	endIf 
	
	cPrefix := PrefixoCpo(Upper(cTable))
	
	cWhere := cPrefix+"_filial= '%"+cTable+".filial%' and "+cPrefix+"_doc = '" +cDoc+ "' and "+cPrefix+"_serie ='"+cSer+"' and "
	if cType == "2"
		cWhere += cPrefix+"_cliente = '"+cCod+"' and "
	else 
		cWhere += cPrefix+"_fornece = '"+cCod+"' and "
	endIf
	cWhere +=  cPrefix+"_loja='"+cBranch+"' and d_e_l_e_t_ = ' ' "
		
	if cType == "2"
		lCutover := oIpSqlObject:getFieldValue(cTable, cField, cWhere) == DHL_SERIE_CUTOVER
	else
		lCutover := oIpSqlObject:getFieldValue(cTable, cField, cWhere) == 'S'
	endif
	
	oIpSqlObject:close()
	
return (lCutover)

/*/{Protheus.doc} getItemFlowsRecord

Itens de documento de entrada e saida
	
@author Daniel Braga
@since 31/10/2014

@param cDoc , String, numero do documento
@param cSer , String, serie do documento
@param cCod , String, Codigo da entidade
@param cBranch, String, loja da entidade

@return Array valores das entidades  encontradas
/*/
method getRefItem(cType,cDoc,cSer,cProduct) class DHLSafx
	local oIpSqlObject :=  IpSqlObject():newIpSqlObject()
	local cWhere := ""
	local cTable  :=""
	local cPrefix := ""
	local cSql 	:= ""
	local aFields := {}

	default cProduct := ''
       
	if cType  == "2"
		cTable := "SD2"
	else 
		cTable := "SD1"
	endIf 
	
	cPrefix := PrefixoCpo(cTable)
	
	cWhere := cPrefix+"_filial= '%"+cTable+".filial%' and "+cPrefix+"_doc = '" +cDoc+ "' and "+cPrefix+"_serie ='"+cSer+"' "
	
	if !empty(cProduct)
		cWhere += " and "+cPrefix+"_cod = '"+cProduct+"' and d_e_l_e_t_ = ' ' "
	endif
	 
	cSql := " select "+::fieldListSX3(cTable)+" from "+retSqlName(cTable)+" where "+cWhere
	
	aFields := ::populatedResult(oIpSqlObject,Upper(cSql))

	if (oIpSqlObject:aliasExists())
		oIpSqlObject:close()
	endif
	
return aFields


/*/{Protheus.doc} getUfTaxes

Retorna impostos referente a transação interestadual.
	
@author Thiago Meschiatti
@since 11/01/2016

@param cType , String, Tipo do documento (entrada/saida)
@param cTypeDoc , String, Tipo do documento (devolucao/beneficiamento/etc...)
@param cDoc , String, numero do documento
@param cSerie , String, serie do documento
@param cCliFor , String, Codigo da entidade
@param cLoja , String, loja da entidade
@param cItem , String, item do documento

@return Array valores das entidades  encontradas
/*/
method getUfTaxes(cType, cTypeDoc, cSerie, cDoc, cCliFor, cLoja, cItem , lTodos , lSol ) class DHLSafx
	local oSql   	:= IpSqlObject():newIpSqlObject()
	local nVlrFCP	:= 0
	local nVlrUfDest:= 0
	local nVlrUfOri	:= 0

	local tVlrFCP	:= 0
	local tVlrUfDest:= 0
	local tVlrUfOri	:= 0
	
	local aRet	:= {}
	local npos	:= 0
	
	local cQuery	:= ""
	local cTypeMov	:= Alltrim(iif(cType == "1" ,'E','S'))
	local cFil		:= xFilial("CD2")
	
	default cItem	:= ""
	Default lTodos	:= .f.
	Default lSol	:= .f. // icms e solidadio 4.0 // criado para manter compatibilidade com outros pontos da safx -- e nao mais testar pelo empty(cItem)
	
	cQuery := " CD2_FILIAL = '"+cFil+"' AND CD2_TPMOV = '"+cTypeMov+"' AND CD2_SERIE = '"+cSerie+"' AND CD2_DOC = '"+cDoc+"' "
	
	if !empty(cItem)
		cQuery += " AND CD2_ITEM = '"+cItem+"' "
	endif

	if cTypeMov == 'E'
		if cTypeDoc $ "B|D|"
			cQuery += " AND CD2_CODCLI = '"+cCliFor+"' AND CD2_LOJCLI = '"+cLoja+"' "
		else
			cQuery += " AND CD2_CODFOR = '"+cCliFor+"' AND CD2_LOJFOR = '"+cLoja+"' "			
		endif
	else
		if cTypeDoc $ "B|D|"
			cQuery += " AND CD2_CODFOR = '"+cCliFor+"' AND CD2_LOJFOR = '"+cLoja+"' "
		else
			cQuery += " AND CD2_CODCLI = '"+cCliFor+"' AND CD2_LOJCLI = '"+cLoja+"' "
		endif
	endif
	
	oSql:newTable("CD2", "CD2_IMP, CD2_VFCP, CD2_VDDES, CD2_VLTRIB, CD2_ITEM, CD2_PFCP, CD2_BFCP", cQuery)
	
	while oSql:notIsEof()
		if !lSol //empty(cItem)
			if Upper(alltrim(oSql:getValue("CD2_IMP"))) == "CMP"
				nVlrFCP 	+= oSql:getValue("CD2_VFCP")
				nVlrUfDest	+= oSql:getValue("CD2_VDDES")
				nVlrUfOri	+= oSql:getValue("CD2_VLTRIB")
	
				if lTodos
					tVlrFCP 	+= oSql:getValue("CD2_VFCP")
					tVlrUfDest	+= oSql:getValue("CD2_VDDES")
					tVlrUfOri	+= oSql:getValue("CD2_VLTRIB")
					
					npos := ascan( aret , {|X| X[4] == oSql:getValue("CD2_ITEM")})
					if npos == 0
						aadd( aret , { 0 , 0 , 0 , oSql:getValue("CD2_ITEM")})
						npos := len(aret)
					endif
					aret[npos,1] += oSql:getValue("CD2_VFCP")
					aret[npos,2] += oSql:getValue("CD2_VDDES")
					aret[npos,3] += oSql:getValue("CD2_VLTRIB")
					
				endif
	
			endif
		else
			if Upper(alltrim(oSql:getValue("CD2_IMP"))) == "ICM"
				if oSql:getValue("CD2_PFCP") >0 
					aadd(aRet, {"ICM", oSql:getValue("CD2_VFCP")})
				EndIf
			ElseIf Upper(alltrim(oSql:getValue("CD2_IMP"))) == "SOL"
				If oSql:getValue("CD2_VFCP") > 0
					aadd(aRet, {"SOL", oSql:getValue("CD2_VFCP")})
				EndIf
			EndIf
		endif
		
		oSql:skip()
	enddo
	
	If !lSol //empty(cItem)
		if lTodos
			if len( aret ) = 0
				aret := { {nVlrFCP, nVlrUfDest, nVlrUfOri , ""} }
			else
				aadd( aret , { tVlrFCP, tVlrUfDest, tVlrUfOri , "" })
			endif
		else
			aret :=  {nVlrFCP, nVlrUfDest, nVlrUfOri ,  "" } 
		endif
	EndIf
	
	oSql:close()
	
return(aret)  // {nVlrFCP, nVlrUfDest, nVlrUfOri})