		cRet := &("oXml:" + cPath)
	endif

return (cRet)


/*/{Protheus.doc} getQuant
Coleta a quantidade do item do XML

@author Thiago Meschiatti
@since 06/04/2016
@version 1.0
@return Caracter Quantidade do item do XML
/*/
method getQuant() class DHLTaxes
