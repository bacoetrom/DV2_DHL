#Include 'Protheus.ch'

/*/{Protheus.doc} MA410LEG

Ponto de entrada para adicionar legendas do pedido de venda
	
@author Renato Castro
@since 22/10/2014


@return Array Novas cores
/*/
User Function MA410LEG()

	Local aLegenda := {} //PARAMIXB traz a estrutura do array padrão
	
	AADD(aLegenda,{"PMSEDT4" ,"Ajuste de Inventário"})
	AADD(aLegenda,{"BR_BRANCO" ,"Pedido de Venda Pendente de Informação"})
	AADD(aLegenda,{"ENABLE" ,"Pedido em Aberto"})
	AADD(aLegenda,{"DISABLE" ,"Pedido Encerrado"})
	AADD(aLegenda,{"BR_AMARELO" ,"Pedido Liberado"})
	AADD(aLegenda,{"BR_AZUL" ,"Pedido Bloqueado por Regra"})
	AADD(aLegenda,{"BR_LARANJA" ,"Pedido Bloqueado por Verba"})

Return(aLegenda)

