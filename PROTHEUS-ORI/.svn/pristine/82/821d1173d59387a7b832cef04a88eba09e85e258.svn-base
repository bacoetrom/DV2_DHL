/*/{Protheus.doc} addLine

Cria a lina ‡ ser impressa no arquivo txt
	
@author Daniel Braga
@since 30/10/2014

/*/
method addLine(dDtInvent, lTerceiro, lContSB6) class DHLSafx52
	
	local lSPL			:= (FWUnitBusiness() == DHL_BUSINESSUNIT_SPL) 
	local lFormatZero 	:= .f.	
	local lPATerceiro	:= .f.	
	local cProduto 		:= ::getFieldValue("B2_COD")
	local cLocal   		:= if (empty(::getFieldValue("B2_LOCAL")), ::getFieldValue("B1_LOCPAD"),::getFieldValue("B2_LOCAL")) 
	local aSaldo   		:= {}//CalcEst(cProduto, cLocal, dDtInvent)
	local aProduct		:= {}
	local aSupCus		:= {}
	local nTerceiro		:= iif(lTerceiro, 0, ::getSldTerc(cProduto, dDtInvent))
	local nQuant   		:= iif(lSPL, ::getFieldValue("D1_QUANT"), iif(valtype(::getFieldValue("SALDO")) == "C", 0,::getFieldValue("SALDO")) - nTerceiro)
	local nValorTot		:= iif(lSPL, ::getFieldValue("D1_VUNIT") + ::getFieldValue("D1_VALIPI"), iif(valtype(::getFieldValue("CUSTO")) == "C", 0,::getFieldValue("CUSTO")))//aSaldo[2])
	local nCustoUnit 	:= nValorTot / nQuant // nValorTot / nQuant = 100.000173
	local cCod 			:= ""
	local cBranch		:= ""
	local cNokiaTransf  := ""
	
	if lSPL
		if GetNewPar("ZZ_ICSTDEV", .T.)
			nValorTot += ::getFieldValue("D1_ICMSRET")
		endif
		cCod 	:= Left(GetMv("ZZ_FORNDEP"), tamsx3("A2_COD")[1])
		cBranch := Right(GetMv("ZZ_FORNDEP"), tamsx3("A2_LOJA")[1])
		
		aSupCus 		:= ::getSupCusRecords('1', cCod, cBranch)
	else
		if !lTerceiro
			lPATerceiro := isProdTerc(self)
			if lPATerceiro
				aSupCus := ::getSupCusRecords('2', ::getFieldValue("B1_ZZCDPRO"), ::getFieldValue("B1_ZZLJPRO"))
			endif
		endif
	endif
	
	default nSaldo := 0
	
	if lTerceiro
		nQuant 		:= ::getFieldValue("SALDO")
		nCustoUnit	:= (nValorTot / nQuant)
		aProduct 	:=	::getProduct(::getFieldValue("B2_COD"))
	else
		nValorTot	:=  nQuant * nCustoUnit 
	endif
	
	nSaldo := iif(nQuant < 0 , 0 , nQuant)
	if nSaldo == 0 .and. nTerceiro > 0
		lContSB6 := .t.
	endif

	::addField(COD_EMPRESA				, "SOL")
	::addField(COD_ESTAB				, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp())))
	::addField(DATA_INVENTARIO			, dDtInvent)
	if !lTerceiro .and. lPATerceiro
		::addField(GRUPO_CONTAGEM			, '3')
	else
		::addField(GRUPO_CONTAGEM			, iif(lTerceiro .or. lSPL,'3', '1'))
	endif
	::addField(COD_NBM					, iif(lTerceiro,::getFieldValue("B1_POSIPI",aProduct),::getFieldValue("B1_POSIPI")))
	::addField(IND_PRODUTO				, getType(self, lTerceiro, aProduct))    //iif(lTerceiro,::getProdType(::getFieldValue("B1_TIPO",aProduct)),::getProdType(::getFieldValue("B1_TIPO")))) //TODO Retirar depois
	::addField(COD_PRODUTO				, iif(lSPL, ::getFieldValue("D1_COD"), ::getFieldValue("B2_COD")))
	::addField(COD_UND_PADRAO			, iif(lTerceiro,::getFieldValue("B1_UM",aProduct),::getFieldValue("B1_UM")))
	::addField(COD_ALMOX				, iif(lTerceiro,::getFieldValue("B1_LOCPAD",aProduct),::getFieldValue("B1_LOCPAD")))
	if !lTerceiro .and. lPATerceiro
		::addField(COD_NAT_ESTOQUE			, '03')
	else 
		::addField(COD_NAT_ESTOQUE			, iif(lTerceiro .or. lSPL, '03', '02'))
	endif
	::addField(COD_MEDIDA				, iif(lTerceiro,::getFieldValue("B1_UM",aProduct),::getFieldValue("B1_UM")))
	::addField(QUANTIDADE				, nQuant, lFormatZero)
	::addField(VLR_TOT					, Round(nValorTot,2), lFormatZero)
	::addField(VLR_UNIT					, nCustoUnit, lFormatZero)
	::addField(COD_CONTA				, iif(lTerceiro,iif(alltrim(::getFieldValue("B1_ZZCONTA",aProduct)) == '.....', ' ', ::getFieldValue("B1_ZZCONTA",aProduct)),;
										  iif(alltrim(::getFieldValue("B1_ZZCONTA")) == '.....', ' ', ::getFieldValue("B1_ZZCONTA"))))
	if !lTerceiro .and. lPATerceiro
		::addField(IND_FIS_JUR				, ::getFieldValue("A1_ZZINDDW", aSupCus))
		::addField(COD_FIS_JUR				, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp())) + ::getFieldValue("B1_ZZCDPRO") + ::getFieldValue("B1_ZZLJPRO"))
	else
		::addField(IND_FIS_JUR				, iif(lTerceiro, ::getFieldValue("ZZINDDW"), iif(lSPL, ::getFieldValue("A2_ZZINDDW", aSupCus), '3')))
		
		If FWUnitBusiness() == DHL_BUSINESSUNIT_REP
			cNokiaTransf := iif(lTerceiro, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp())) + ::getFieldValue("CLIFOR") + ::getFieldValue("LOJA"),;
							iif(lSPL, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp())) + ::getFieldValue("A2_COD", aSupCus) + ::getFieldValue("A2_LOJA", aSupCus), SM0->M0_CGC))

			If cNokiaTransf = "E2700000801"					
				::addField(COD_FIS_JUR				, "E2700007901")
			Else
				::addField(COD_FIS_JUR				, AllTrim(cNokiaTransf))
			EndIf		
		Else
		::addField(COD_FIS_JUR				, iif(lTerceiro, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp())) + ::getFieldValue("CLIFOR") + ::getFieldValue("LOJA"),;
											  iif(lSPL, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp())) + ::getFieldValue("A2_COD", aSupCus) + ::getFieldValue("A2_LOJA", aSupCus), SM0->M0_CGC)))
		EndIf									  
	endif
	::addField(IND_PRODUTO_RASTRO		, getRastro(self)) //::getProdType(::getFieldValue("B1_TIPO"))) //TODO RETIRAR DEPOIS
	::addField(COD_PRODUTO_RASTRO		, iif(lSPL, ::getFieldValue("D1_COD"), ::getFieldValue("B2_COD")))
	::addField(COD_SITUACAO_A			, iif(lTerceiro, ::getFieldValue("B1_ORIGEM",aProduct), ::getFieldValue("B1_ORIGEM")))
	::addField(COD_SITUACAO_B			, iif(lTerceiro, ::getFieldValue("B1_CLASFIS",aProduct), ::getFieldValue("B1_CLASFIS")))
	::addField(IND_MOT_INV				, "01")

	::notFieldRequired()

return

/*/{Protheus.doc} getSql

Instrucao SQL para exportacao
	
@author Daniel Braga
@since 30/10/2014

@return string instrucao sql
/*/
method getSql() class DHLSafx52
	
	local cQuery 		:= ""

	//cQuery:= "select sb2.*, sb1.*, (b2_qatu - b2_qtnp) saldo"
	cQuery:= "select sb2.*, sb1.*, (b2_qfim) saldo, b2_vfim1 custo"
	cQuery+= " from "+retSqlName("SB2")+" sb2 "
	cQuery+= "inner join "+retSqlName("SB1")+" sb1 on sb1.B1_COD = sb2.b2_cod and "
	cQuery+= "					 sb1.b1_filial = '"+xFilial("SB1")+"' and "
	cQuery+= "					 sb1.D_E_L_E_T_ = ' ' "	
	cQuery+= "where sb2.D_E_L_E_T_ = ' '  and sb2.b2_filial= '"+xFilial("SB2")+"' and sb2.b2_qfim > 0 "
//	cQuery+= " and sb2.b2_cod = '84147780' "

return Upper(cQuery)


/*/{Protheus.doc} getSqlSb6

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getSqlSb6(cProduct, dDtInvent) class DHLSafx52
	
	local cQuery 		:= ""

	cQuery += " SELECT 	B6_FILIAL FILIAL, B6_PRODUTO PRODUTO, B6_CLIFOR CLIFOR, 				"+CRLF
	cQuery += " 		B6_LOJA LOJA, B6_TPCF TIPO, B2_VFIM1 CUSTO,                              "+CRLF
	cQuery += " 		SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_QUANT) ELSE  (-B6_QUANT) END) SALDO "+CRLF
	cQuery += " FROM %SB2.SQLNAME% 		                                                        "+CRLF
	cQuery += " INNER JOIN  %SB1.SQLNAME% ON SB1.B1_COD = SB2.B2_COD AND                        "+CRLF
	cQuery += " 	SB1.B1_FILIAL = SB2.B2_FILIAL AND                                     		"+CRLF
	cQuery += " 	SB1.D_E_L_E_T_ = ' '                                                        "+CRLF
	cQuery += " INNER JOIN 	%SB6.SQLNAME% ON SB1.B1_COD = SB6.B6_PRODUTO               		    "+CRLF
	cQuery += " 	AND SB6.B6_FILIAL = SB1.B1_FILIAL                                			"+CRLF
	cQuery += "		AND SB6.B6_DTDIGIT >= '20000101' 											"+CRLF
	cQuery += "		AND SB6.B6_DTDIGIT <= '"+Dtos(dDtInvent)+"' 								"+CRLF
	cQuery += " 	AND SB6.D_E_L_E_T_ = ' '                                                    "+CRLF
	
	If (FWUnitBusiness() == DHL_BUSINESSUNIT_REP)
		cQuery += " INNER JOIN %SA1.SQLNAME% ON                                             	"+CRLF
	    cQuery += " 	    A1_FILIAL   	= B6_FILIAL                                         "+CRLF
	    cQuery += " 	AND A1_COD      	= B6_CLIFOR                                         "+CRLF
	    cQuery += " 	AND A1_LOJA     	= B6_LOJA                                           "+CRLF
	    cQuery += " 	AND A1_ZZDEPOS  	<> 'N'                                              "+CRLF
	    cQuery += " 	AND SA1.D_E_L_E_T_ = ' '                                                "+CRLF
	EndIf
	
	cQuery += " WHERE                                                                           "+CRLF
	cQuery += " 	SB2.D_E_L_E_T_ = ' '                                                        "+CRLF
	cQuery += " 	AND %SB2.XFILIAL%	 				                                   		"+CRLF
	cQuery += " 	AND SB2.B2_COD = '"+cProduct+"'                                         	"+CRLF
	cQuery += " GROUP BY                                                                        "+CRLF
	//VALIDAR SALDO
	cQuery += " 	B6_FILIAL, B6_PRODUTO, B6_CLIFOR,	B6_LOJA, B6_TPCF, B2_VFIM1              "+CRLF

return cQuery


/*/{Protheus.doc} getAglutB6

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getAglutB6(cProduct, cType, dDtInvent, cEntity, cUnit) class DHLSafx52
	local cQuery 	:= ""
	local cField	:= ""
	local cGroup	:= ""
	
	if cType $ SAFX52_CLIENTE
		cField := " A1_ZZINDDW ZZINDDW,"
		cGroup := " A1_ZZINDDW," 
	else
		cField := " A2_ZZINDDW ZZINDDW," 
		cGroup := " A2_ZZINDDW,"
	endif
	
	cQuery += " SELECT 	B6_FILIAL FILIAL, B6_PRODUTO PRODUTO, B6_CLIFOR CLIFOR, B6_LOJA LOJA, B6_TPCF, "+CRLF
	cQuery += " 	SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_QUANT) ELSE  (-B6_QUANT) END) SALDO, "+CRLF
	cQuery += " 	SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_CUSTO1) ELSE  (-B6_CUSTO1) END) CUSTO, "+CRLF
	cQuery += cField	
	cQuery += " 		B1_EX_NBM,B2_COD,B1_UM,B1_LOCPAD,B1_TIPO,B1_UM,B1_ZZCONTA,B1_ORIGEM,B1_CLASFIS		        		"+CRLF
	cQuery += " FROM SB2100 SB2                                                                                             "+CRLF
	cQuery += " INNER JOIN  %SB1.SQLNAME% ON SB1.B1_COD = SB2.B2_COD AND                                                    "+CRLF
	cQuery += " 	SB1.B1_FILIAL = SB2.B2_FILIAL AND                                                                       "+CRLF
	cQuery += " 	SB1.D_E_L_E_T_ = ' '                                                                                    "+CRLF
	cQuery += " INNER JOIN 	%SB6.SQLNAME% ON SB1.B1_COD = SB6.B6_PRODUTO                                                    "+CRLF
	cQuery += " 	AND SB6.B6_FILIAL = SB1.B1_FILIAL	                                                                    "+CRLF
	cQuery += " 	AND SB6.B6_CLIFOR	= '" + cEntity + "'                                                                 "+CRLF
	cQuery += " 	AND SB6.B6_LOJA 	= '" + cUnit + "'                                                                   "+CRLF	
	cQuery += "		AND SB6.B6_DTDIGIT >= '20000101' 																		"+CRLF
	cQuery += "		AND SB6.B6_DTDIGIT <= '"+Dtos(dDtInvent)+"' 															"+CRLF
	cQuery += " 	AND SB6.D_E_L_E_T_ = ' '                                                                                "+CRLF
	if cType $ SAFX52_CLIENTE
		cQuery += " INNER JOIN %SA1.SQLNAME% ON SA1.A1_COD = SB6.B6_CLIFOR                                                  "+CRLF
		cQuery += " 	AND SA1.A1_LOJA = SB6.B6_LOJA                                                                       "+CRLF
		cQuery += " 	AND SA1.A1_FILIAL = SB6.B6_FILIAL 	                                                                "+CRLF
		cQuery += " 	AND SA1.D_E_L_E_T_ = ' '                                                                            "+CRLF
	else
		cQuery += " INNER JOIN %SA2.SQLNAME% ON SA2.A2_COD = SB6.B6_CLIFOR                                                  "+CRLF
		cQuery += " 	AND SA2.A2_LOJA = SB6.B6_LOJA                                                                       "+CRLF
		cQuery += " 	AND SA2.A2_FILIAL = SB6.B6_FILIAL 	                                                                "+CRLF
		cQuery += " 	AND SA2.D_E_L_E_T_ = ' '                                                                            "+CRLF
	endif
	cQuery += " WHERE                                                                                                       "+CRLF
	cQuery += " 	SB2.D_E_L_E_T_ = ' '                                                                                    "+CRLF
	cQuery += " 	AND %SB2.XFILIAL%	 				                                   									"+CRLF
	cQuery += " 	AND SB2.B2_COD = '"+cProduct+"'                                                                        	"+CRLF
	cQuery += " GROUP BY                                                                                                    "+CRLF
	cQuery += " 	B6_FILIAL, B6_PRODUTO, B6_CLIFOR, B6_LOJA, B6_TPCF, 		                                            "+CRLF
	cQuery += cGroup
	cQuery += " 	B1_EX_NBM,B2_COD,B1_UM,B1_LOCPAD,B1_TIPO,B1_UM,B1_ZZCONTA,B1_ORIGEM,B1_CLASFIS                  		"+CRLF
	
return(cQuery)


/*/{Protheus.doc} getSldTerc

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getSldTerc(cProduct, dDtInvent) class DHLSafx52
	local cQuery 	:= ""
	local oSql	 	:= IpSqlObject():newIpSqlObject()
	local nSldTerc	:= 0
	
	cQuery += " SELECT 	SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_QUANT) ELSE  (-B6_QUANT) END) SALDO                       	"+CRLF             
	cQuery += " FROM %SB6.SQLNAME%                                  "+CRLF
	cQuery += " WHERE                                              	"+CRLF
	cQuery += "     %SB6.XFILIAL%                                 	"+CRLF
	cQuery += " 	AND SB6.B6_PRODUTO = '"+cProduct+"'             "+CRLF
	cQuery += " 	AND SB6.B6_DTDIGIT >= '20000101' 	           	"+CRLF
	cQuery += " 	AND SB6.B6_DTDIGIT <= '" + dtos(dDtInvent) + "' "+CRLF
	cQuery += " 	AND SB6.D_E_L_E_T_ = ' '                       	"+CRLF
	
	oSql:newAlias(cQuery)
	
	if oSql:hasRecords()
		nSldTerc := oSql:getValue("SALDO")
	endif
	
	oSql:close()
return (nSldTerc)

/*/{Protheus.doc} getSqlSPL

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getSqlSPL(dDtInvent) class DHLSafx52
	local cQuery 	:= ""
	local oSql	 	:= IpSqlObject():newIpSqlObject()
	local nSldTerc	:= 0
	
	cQuery += " SELECT 	D1_COD, SUM(D1_QUANT) D1_QUANT, SUM(D1_VUNIT) D1_VUNIT, 					 "+CRLF 
	cQuery += " 		SUM(D1_VALIPI) D1_VALIPI, SUM(D1_CUSTO) D1_CUSTO, SUM(D1_ICMSRET) D1_ICMSRET,"+CRLF
	cQuery += " 		B1_POSIPI, B1_TIPO, B1_UM, B1_ZZCONTA, B1_TIPO, B1_ORIGEM, B1_CLASFIS,		 "+CRLF
	cQuery += " 		B1_LOCPAD																	 "+CRLF
	cQuery += " FROM %SD1.SQLNAME%  			                                                     "+CRLF
	cQuery += " INNER JOIN %SB1.SQLNAME% ON				                                             "+CRLF
	cQuery += " 	%SB1.NOTDEL%		                                                             "+CRLF
	cQuery += " 	AND D1_FILIAL 	= B1_FILIAL                                                      "+CRLF
	cQuery += " 	AND D1_COD		= B1_COD                                                         "+CRLF
	cQuery += " LEFT JOIN %SD2.SQLNAME% ON				                                             "+CRLF
	cQuery += " 	%SD2.NOTDEL%  			                                                         "+CRLF
	cQuery += " 	AND D1_FILIAL 	= D2_FILIAL                                                  	 "+CRLF
	cQuery += " 	AND D1_ZZID 	= D2_ZZID                                                        "+CRLF
	cQuery += " 	AND D1_DOC		= D2_NFORI                                                       "+CRLF
	cQuery += " 	AND	D1_SERIE	= D2_SERIORI                                                     "+CRLF
	cQuery += " 	AND D1_ITEM		= D2_ITEMORI                                                     "+CRLF
	cQuery += " 	AND D2_EMISSAO <= '"+dtos(dDtInvent)+"'                                          "+CRLF
	cQuery += " LEFT JOIN %SF2.SQLNAME% ON				                                             "+CRLF
	cQuery += " 	%SF2.NOTDEL%                  		                                             "+CRLF
	cQuery += " 	AND D2_FILIAL	= F2_FILIAL                                                      "+CRLF
	cQuery += " 	AND	D2_DOC		= F2_DOC                                                         "+CRLF
	cQuery += " 	AND D2_SERIE	= F2_SERIE                                                       "+CRLF
	cQuery += " 	AND (F2_FIMP 	= 'S' OR                                                         "+CRLF
	cQuery += " 	((F2_SERIE = '"+DHL_SERIE_INVENTARIO+"' AND F2_FIMP = ' ') OR					 "+CRLF
	cQuery += " 	(F2_SERIE = '"+DHL_SERIE_CUTOVER+"' AND F2_FIMP = ' ')))  						 "+CRLF
	cQuery += " WHERE                                                                                "+CRLF
	cQuery += " 	%SD1.XFILIAL% 			                                                         "+CRLF
	cQuery += " 	AND %SD1.NOTDEL%	                                                             "+CRLF
	cQuery += " 	AND D1_TES <> '"+criavar("D1_TES", .F.)+"'										 "+CRLF
	cQuery += " 	AND D2_DOC IS NULL                                                               "+CRLF
	cQuery += " 	AND D1_DTDIGIT <= '"+dtos(dDtInvent)+"'                                          "+CRLF
	cQuery += " GROUP BY  D1_COD, B1_LOCPAD, B1_POSIPI, B1_TIPO, B1_UM, B1_ZZCONTA, B1_TIPO,		 "+CRLF
	cQuery += "  	B1_ORIGEM, B1_CLASFIS                                                            "+CRLF
	
return (cQuery)


