/*/{Protheus.doc} getDateDefault

Coleta a Data Padrão da Interface
	
@author Victor Hugo
@since 11/12/2014

@return Data Data padrão da interface
/*/
method getDateDefault() class DHLSafx52

return (FirstDay(Date()) - 1)


/*
** Verifica Produtos que sao produzido pela DHL que pertecem a Unilever.
*/
static function isProdTerc(oSelf)
	local lRet := .f.
	
	if alltrim(oSelf:getFieldValue("B1_TIPO")) == "PA" .and. right(alltrim(oSelf:getFieldValue("B1_GRUPO")), 1) == "U"
		if !empty(oSelf:getFieldValue("B1_ZZCDPRO")) .and. !empty(oSelf:getFieldValue("B1_ZZLJPRO"))
			lRet := .t.
		endif
	endif
return (lRet)

/*
** Obtém o rastro (Tratamento bloco K)
*/
static function  getRastro(self)	
	
	local cTipo 		:= ""
	local cParBlocoK	:= ""
	local aTiposPar		:= {}
	local lParametro    := .F.
	
	cTipo := self:getFieldValue("B1_TIPO") 
	
	if !cTipo $ LISTA_RECEITA_FEDERAL
		
		cParBlocoK := getParBlocK(cTipo)
		if !empty(cParBlocoK)
			aTiposPar := strToKarr(cParBlocoK, ",")
			cTipo := aTiposPar[TIPO_SISTEMA] 
			lParametro := .T.
		endIf
		
	endIf
	
	cTipo := self:getProdType(cTipo, lParametro)
	
return cTipo

/*
** Obtém o tipo (Tratamento bloco K)
*/
static function  getType(self, lTerceiro, aProduct)	
	
	local cTipo 		:= ""
	local cParBlocoK	:= ""
	local aTiposPar		:= {}	
	local lParametro	:= .F.
	
	if lTerceiro
		cTipo := self:getFieldValue("B1_TIPO", aProduct) 
	else
		cTipo := self:getFieldValue("B1_TIPO")
	endIf
	
	if !cTipo $ LISTA_RECEITA_FEDERAL
		
		cParBlocoK := getParBlocK(cTipo)
		if !empty(cParBlocoK)
			aTiposPar := strToKarr(cParBlocoK, ",")
			cTipo := aTiposPar[TIPO_RECEITA_FEDERAL] 
			lParametro	:= .T.
		endIf
		
	endIf
	
	cTipo := self:getProdType(cTipo, lParametro)
	
return cTipo

/*
** Obtém o parâmetro bloco K referente ao tipo
*/
static function getParBlocK(cTipo)
	
	local oSql	 	:= IpSqlObject():newIpSqlObject()
	local cQuery	:= ""
	local xContPar	:= ""
	local cNameTableSX6 := ""
	
	//NECESSÁRIO, POIS O RETSQLNAME RETORNAVA VAZIO QUANDO PASSAVA SX6
	cNameTableSX6 := getNameTableSx6()
	
	cQuery := "SELECT " + CRLF
	cQuery += "	X6_CONTEUD AS CONTEUD " + CRLF
	cQuery += "FROM " + cNameTableSX6 + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND X6_FIL = '" + FWxFilial("SX6") + "' " + CRLF
	cQuery += "	AND X6_VAR LIKE 'MV_BLKTP%' " + CRLF
	cQuery += "	AND X6_CONTEUD != ' ' " + CRLF
	cQuery += "	AND D_E_L_E_T_ = ' ' " + CRLF
	
	oSql:newAlias(cQuery)
	
	While oSql:notIsEof()
		
		xContPar := oSql:getValue("CONTEUD")
		
		if cTipo $ xContPar
			exit
		endIf
		oSql:skip()
	EndDo
	
	oSql:close()
		
return xContPar

/**
* retorna o nome da tabela físico no banco
**/
static function getNameTableSx6()
	
	local cNameTableSX6 := "SX6" + cEmpant + "0"
	
return cNameTableSX6
