/*/{Protheus.doc} addLine

Cria a lina ‡ ser impressa no arquivo txt
	
@author Daniel Braga
@since 30/10/2014

/*/
method addLine( dDtInvent, lTerceiro, lContSB6, cLocal, nTerceiro ) class DHLSafx52Dis
	
	local lFormatZero 	:= .f.	
	local lPATerceiro	:= .f.	
	local cProduto 		:= Iif( !lTerceiro, ::getFieldValue("B9_COD"), ::getFieldValue("B2_COD") )
//	local cLocal   		:= if (empty(::getFieldValue("B2_LOCAL")), ::getFieldValue("B1_LOCPAD"),::getFieldValue("B2_LOCAL")) 
	local aSaldo   		:= {}//CalcEst(cProduto, cLocal, dDtInvent)
	local aProduct		:= {}
	local aSupCus		:= {}
	local aEntity		:= {}
//	local nTerceiro		:= iif(lTerceiro, 0, ::getSldTerc(cProduto, dDtInvent, cLocal))
	local nQuant   		:= iif(valtype(::getFieldValue("SALDO")) == "C", 0,::getFieldValue("SALDO")) - nTerceiro
	local nValorTot		:= iif(valtype(::getFieldValue("CUSTO")) == "C", 0,::getFieldValue("CUSTO"))//aSaldo[2])
	local nCustoUnit 	:= nValorTot / nQuant // nValorTot / nQuant = 100.000173
	local cCod 			:= ""
	local cBranch		:= ""
	Local __cTIPO		:= getType(self, .F., aProduct)//::getProdType(::getFieldValue("B1_TIPO")) //TODO RETIRAR DEPOIS
	Local __cUM			:= ""
	Local __cZZCDPRO	:= ::getFieldValue("B1_ZZCDPRO")
	Local __cZZLJPRO	:= ::getFieldValue("B1_ZZLJPRO")
	Local __cZZCONTA	:= ::getFieldValue("B1_ZZCONTA")
	Local __cZZCONTA_x	:= ::getFieldValue("B1_ZZCONTA",aProduct)
	Local __ZZ_CDEMODW	:= GetNewPar("ZZ_CDEMPDW", FwCodEmp())

	Default cLocal   	:= Iif( !lTerceiro, ::getFieldValue("B9_LOCAL"), ::getFieldValue("B2_LOCAL") )
	Default nTerceiro	:= iif(lTerceiro, 0, nTerceiro)

	if !lTerceiro
		lPATerceiro := isProdTerc(self)
		if lPATerceiro
			aSupCus := ::getSupCusRecords('2', __cZZCDPRO, __cZZLJPRO)
		endif
	endif
	
	default nSaldo := 0
	
	if lTerceiro
		nQuant 		:= ::getFieldValue("SALDO")
		nCustoUnit	:= (nValorTot / nQuant)
		aProduct 	:= ::getProduct(cProduto)
		aEntity		:= ::getCliSld(cProduto, dDtInvent)
		aSupCus 	:= ::getSupCusRecords('2', aEntity[1], aEntity[2])
		__cUM		:= ::getFieldValue("B1_UM",aProduct)
	else
		nValorTot	:=  nQuant * nCustoUnit 
		__cUM		:= ::getFieldValue("B1_UM")
	endif
	
	nSaldo := iif(nQuant < 0 , 0 , nQuant)
	if nSaldo == 0 .and. nTerceiro > 0
		lContSB6 := .t.
	endif

	::addField(COD_EMPRESA				, alltrim(GetNewPar("ZZ_IDEMPDW", "SOL")))
	::addField(COD_ESTAB				, alltrim(__ZZ_CDEMODW))
	::addField(DATA_INVENTARIO			, dDtInvent)
	::addField(GRUPO_CONTAGEM			, '3')
	::addField(COD_NBM					, iif(lTerceiro,::getFieldValue("B1_POSIPI",aProduct),::getFieldValue("B1_POSIPI")))
	::addField(IND_PRODUTO				, getType(self, lTerceiro, aProduct))//iif(lTerceiro,::getProdType(::getFieldValue("B1_TIPO",aProduct)),__cTIPO)) //RETIRAR DEPOIS
	::addField(COD_PRODUTO				, cProduto)
	::addField(COD_UND_PADRAO			, __cUM)
	::addField(COD_ALMOX				, cLocal)
	if !lTerceiro .and. lPATerceiro
		::addField(COD_NAT_ESTOQUE			, '03')
	else 
		::addField(COD_NAT_ESTOQUE			, iif(lTerceiro, '03', '02'))
	endif
	::addField(COD_MEDIDA				, __cUM)
	::addField(QUANTIDADE				, nQuant, lFormatZero)
	::addField(VLR_TOT					, Round(nValorTot,2), lFormatZero)
	::addField(VLR_UNIT					, nCustoUnit, lFormatZero)
	::addField(COD_CONTA				, iif(lTerceiro,iif(alltrim(__cZZCONTA_x) == '.....', ' ', __cZZCONTA_x),;
										  iif(alltrim(__cZZCONTA) == '.....', ' ', __cZZCONTA)))
	if !lTerceiro .and. lPATerceiro
		::addField(IND_FIS_JUR			, ::getFieldValue("A1_ZZINDDW", aSupCus))
		::addField(COD_FIS_JUR			, alltrim(__ZZ_CDEMODW) + __cZZCDPRO + __cZZLJPRO)
	else
		::addField(IND_FIS_JUR			, iif(lTerceiro, ::getFieldValue("A1_ZZINDDW", aSupCus), '3'))
		::addField(COD_FIS_JUR			, iif(lTerceiro, alltrim(__ZZ_CDEMODW) + aEntity[1] + aEntity[2], SM0->M0_CGC))
	endif
	::addField(IND_PRODUTO_RASTRO		, __cTIPO)
	::addField(COD_PRODUTO_RASTRO		, cProduto)
	::addField(COD_SITUACAO_A			, iif(lTerceiro, ::getFieldValue("B1_ORIGEM",aProduct), ::getFieldValue("B1_ORIGEM")))
	::addField(COD_SITUACAO_B			, iif(lTerceiro, ::getFieldValue("B1_CLASFIS",aProduct), ::getFieldValue("B1_CLASFIS")))
	::addField(IND_MOT_INV				, "01")

	::notFieldRequired()

return

/*/{Protheus.doc} getSql

Instrucao SQL para exportacao
	
@author Daniel Braga
@since 30/10/2014

@return string instrucao sql
/*/
method getSql() class DHLSafx52Dis
	
	local cQuery 		:= ""

	//cQuery:= "select sb2.*, sb1.*, (b2_qatu - b2_qtnp) saldo"
	cQuery:= "select B2_LOCAL B2_LOCAL, sb2.*, sb1.*, (b2_qfim) saldo, b2_vfim1 custo"
	cQuery+= " from "+retSqlName("SB2")+" sb2 "
	cQuery+= "inner join "+retSqlName("SB1")+" sb1 on sb1.B1_COD = sb2.b2_cod and "
	cQuery+= "					 sb1.b1_filial = '"+xFilial("SB1")+"' and "
	cQuery+= "					 sb1.D_E_L_E_T_ = ' ' "	
	cQuery+= "where sb2.D_E_L_E_T_ = ' '  and sb2.b2_filial= '"+xFilial("SB2")+"' and sb2.b2_qfim > 0 AND B2_COD = 'F000141663' "
//	cQuery+= " and sb2.b2_cod = '84147780' "

return Upper(cQuery)


/*/{Protheus.doc} getSqlSb6

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getSqlSb6(cProduct, dDtInvent) class DHLSafx52Dis
	
	local cQuery 		:= ""

	cQuery += " SELECT 	B6_FILIAL FILIAL, B6_PRODUTO PRODUTO,  				"+CRLF
	cQuery += " 		 B6_TPCF TIPO, B2_VFIM1 CUSTO,                              "+CRLF
	cQuery += " 		SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_QUANT) ELSE  (-B6_QUANT) END) SALDO "+CRLF
	cQuery += " FROM %SB2.SQLNAME% 		                                                        "+CRLF
	cQuery += " INNER JOIN  %SB1.SQLNAME% ON SB1.B1_COD = SB2.B2_COD AND                        "+CRLF
	cQuery += " 	SB1.B1_FILIAL = SB2.B2_FILIAL AND                                     		"+CRLF
	cQuery += " 	SB1.B1_LOCPAD = SB2.B2_LOCAL AND                                     		"+CRLF
	cQuery += " 	SB1.D_E_L_E_T_ = ' '                                                        "+CRLF
	cQuery += " INNER JOIN 	%SB6.SQLNAME% ON SB1.B1_COD = SB6.B6_PRODUTO               		    "+CRLF
	cQuery += " 	AND SB6.B6_FILIAL = SB1.B1_FILIAL                                			"+CRLF
	cQuery += "		AND SB6.B6_DTDIGIT >= '20000101' 											"+CRLF
	cQuery += "		AND SB6.B6_DTDIGIT <= '"+Dtos(dDtInvent)+"' 								"+CRLF
	cQuery += " 	AND SB6.D_E_L_E_T_ = ' '                                                    "+CRLF
	cQuery += " WHERE                                                                           "+CRLF
	cQuery += " 	SB2.D_E_L_E_T_ = ' '                                                        "+CRLF
	cQuery += " 	AND %SB2.XFILIAL%	 				                                   		"+CRLF
	cQuery += " 	AND SB2.B2_COD = '"+cProduct+"'                                         	"+CRLF
	cQuery += " GROUP BY                                                                        "+CRLF
	//VALIDAR SALDO
	cQuery += " 	B6_FILIAL, B6_PRODUTO, B6_TPCF, B2_VFIM1              "+CRLF

return cQuery


/*/{Protheus.doc} getAglutB6

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getAglutB6(cProduct, cType, dDtInvent, cEntity, cUnit) class DHLSafx52Dis
	local cQuery 	:= ""
	local cField	:= ""
	local cGroup	:= ""
	
//	if cType $ SAFX52_CLIENTE
//		cField := " A1_ZZINDDW ZZINDDW,"
//		cGroup := " A1_ZZINDDW," 
//	else
//		cField := " A2_ZZINDDW ZZINDDW," 
//		cGroup := " A2_ZZINDDW,"
//	endif
	
	cQuery += " SELECT 	B6_FILIAL FILIAL, B6_PRODUTO PRODUTO,  B6_TPCF, "+CRLF
	cQuery += " 	SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_QUANT) ELSE  (-B6_QUANT) END) SALDO, "+CRLF
	cQuery += " 	SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_CUSTO1) ELSE  (-B6_CUSTO1) END) CUSTO, "+CRLF
	cQuery += cField	
	cQuery += " 		B1_EX_NBM,B2_COD,B1_UM,B1_LOCPAD,B1_TIPO,B1_UM,B1_ZZCONTA,B1_ORIGEM,B1_CLASFIS		        		"+CRLF
	cQuery += " FROM %SB2.SQLNAME%                                                                                          "+CRLF
	cQuery += " INNER JOIN  %SB1.SQLNAME% ON SB1.B1_COD = SB2.B2_COD AND                                                    "+CRLF
	cQuery += " 	SB1.B1_FILIAL = SB2.B2_FILIAL AND                                                                       "+CRLF
	cQuery += " 	SB1.B1_LOCPAD = SB2.B2_LOCAL AND                                                                       "+CRLF
	cQuery += " 	SB1.D_E_L_E_T_ = ' '                                                                                    "+CRLF
	cQuery += " INNER JOIN 	%SB6.SQLNAME% ON SB1.B1_COD = SB6.B6_PRODUTO                                                    "+CRLF
	cQuery += " 	AND SB6.B6_FILIAL = SB1.B1_FILIAL	                                                                    "+CRLF
//	cQuery += " 	AND SB6.B6_CLIFOR	= '" + cEntity + "'                                                                 "+CRLF
//	cQuery += " 	AND SB6.B6_LOJA 	= '" + cUnit + "'                                                                   "+CRLF	
	cQuery += "		AND SB6.B6_DTDIGIT >= '20000101' 																		"+CRLF
	cQuery += "		AND SB6.B6_DTDIGIT <= '"+Dtos(dDtInvent)+"' 															"+CRLF
	cQuery += " 	AND SB6.D_E_L_E_T_ = ' '                                                                                "+CRLF
	if cType $ SAFX52_CLIENTE
		cQuery += " INNER JOIN %SA1.SQLNAME% ON SA1.A1_COD = SB6.B6_CLIFOR                                                  "+CRLF
		cQuery += " 	AND SA1.A1_LOJA = SB6.B6_LOJA                                                                       "+CRLF
		cQuery += " 	AND SA1.A1_FILIAL = SB6.B6_FILIAL 	                                                                "+CRLF
		cQuery += " 	AND SA1.D_E_L_E_T_ = ' '                                                                            "+CRLF
	else
		cQuery += " INNER JOIN %SA2.SQLNAME% ON SA2.A2_COD = SB6.B6_CLIFOR                                                  "+CRLF
		cQuery += " 	AND SA2.A2_LOJA = SB6.B6_LOJA                                                                       "+CRLF
		cQuery += " 	AND SA2.A2_FILIAL = SB6.B6_FILIAL 	                                                                "+CRLF
		cQuery += " 	AND SA2.D_E_L_E_T_ = ' '                                                                            "+CRLF
	endif
	cQuery += " WHERE                                                                                                       "+CRLF
	cQuery += " 	SB2.D_E_L_E_T_ = ' '                                                                                    "+CRLF
	cQuery += " 	AND %SB2.XFILIAL%	 				                                   									"+CRLF
	cQuery += " 	AND SB2.B2_COD = '"+cProduct+"'                                                                        	"+CRLF
	cQuery += " GROUP BY                                                                                                    "+CRLF
//	cQuery += " 	B6_FILIAL, B6_PRODUTO, B6_CLIFOR, B6_LOJA, B6_TPCF, 		                                            "+CRLF
	cQuery += " 	B6_FILIAL, B6_PRODUTO,  B6_TPCF, 		                                            "+CRLF
	cQuery += cGroup
	cQuery += " 	B1_EX_NBM,B2_COD,B1_UM,B1_LOCPAD,B1_TIPO,B1_UM,B1_ZZCONTA,B1_ORIGEM,B1_CLASFIS                  		"+CRLF
	
return(cQuery)


/*/{Protheus.doc} getSldTerc

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getSldTerc(cProduct, dDtInvent, cLocal) class DHLSafx52Dis
	local cQuery 	:= ""
	local oSql	 	:= IpSqlObject():newIpSqlObject()
	local nSldTerc	:= 0
	
	cQuery += " SELECT 	SUM(CASE WHEN B6_PODER3 = 'R' THEN (B6_QUANT) ELSE  (-B6_QUANT) END) SALDO                       	"+CRLF             
	cQuery += " FROM %SB6.SQLNAME%                                  "+CRLF
	cQuery += " WHERE                                              	"+CRLF
	cQuery += "     %SB6.XFILIAL%                                 	"+CRLF
	cQuery += " 	AND SB6.B6_PRODUTO = '"+cProduct+"'             "+CRLF
	cQuery += " 	AND SB6.B6_DTDIGIT >= '20000101' 	           	"+CRLF
	cQuery += " 	AND SB6.B6_DTDIGIT <= '" + dtos(dDtInvent) + "' "+CRLF
	cQuery += " 	AND SB6.B6_LOCAL = '" + cLocal + "'             "+CRLF
	cQuery += " 	AND SB6.D_E_L_E_T_ = ' '                       	"+CRLF
	
	oSql:newAlias(cQuery)
	
	if oSql:hasRecords()
		nSldTerc := oSql:getValue("SALDO")
	endif
	
	oSql:close()
return (nSldTerc)


/*/{Protheus.doc} getCliSld

Instrucao SQL para exportacao
	
@author Thiago Meschiatti
@since 04/02/2015

@return string instrucao sql
/*/
method getCliSld(cProduct, dDtInvent) class DHLSafx52Dis
	local cQuery 	:= ""
	local oSql	 	:= IpSqlObject():newIpSqlObject()
	local cCliFor	:= ""
	local cLoja		:= ""
	
	cQuery += " SELECT 	DISTINCT B6_CLIFOR, B6_LOJA                 "+CRLF             
	cQuery += " FROM %SB6.SQLNAME%                                  "+CRLF
	cQuery += " WHERE                                              	"+CRLF
	cQuery += "     %SB6.XFILIAL%                                 	"+CRLF
	cQuery += " 	AND SB6.B6_PRODUTO = '"+cProduct+"'             "+CRLF
	cQuery += " 	AND SB6.B6_DTDIGIT >= '20000101' 	           	"+CRLF
	cQuery += " 	AND SB6.B6_DTDIGIT <= '" + dtos(dDtInvent) + "' "+CRLF
	cQuery += " 	AND SB6.B6_PODER3 = 'R' 						"+CRLF
	cQuery += " 	AND SB6.D_E_L_E_T_ = ' '                       	"+CRLF
	
	oSql:newAlias(cQuery)
	
	if oSql:hasRecords()
		cCliFor := oSql:getValue("B6_CLIFOR")
		cLoja	:= oSql:getValue("B6_LOJA")
	endif
	
	oSql:close()
return {cCliFor, cLoja}


