/*/{Protheus.doc} getDateDefault

Coleta a Data Padrão da Interface
	
@author Victor Hugo
@since 11/12/2014

@return Data Data padrão da interface
/*/
method getDateDefault() class DHLSafx52Dis

return (FirstDay(Date()) - 1)


/*
** Verifica Produtos que sao produzido pela DHL que pertecem a Unilever.
*/
static function isProdTerc(oSelf)
	local lRet := .f.
	
	if alltrim(oSelf:getFieldValue("B1_TIPO")) == "PA" .and. right(alltrim(oSelf:getFieldValue("B1_GRUPO")), 1) == "U"
		if !empty(oSelf:getFieldValue("B1_ZZCDPRO")) .and. !empty(oSelf:getFieldValue("B1_ZZLJPRO"))
			lRet := .t.
		endif
	endif
return (lRet)


/*/{Protheus.doc} getSqlSB9
Query que retornará os registros aptos para geração de instrução SQL para exportacao conforme
saldo do momento do encerramento do estoque do referido ano/mes

@author Icaro Queiroz
@since 25 de agosto de 2017

@return String instrucao sql
/*/
Method getSqlSB9( dDtInvent ) class DHLSafx52Dis
Local __cQuery		:= ""

Default dDtInvent	:= dDataBase

__cQuery := " SELECT DISTINCT B9_COD, B1_ZZCDPRO, B1_ZZLJPRO, B1_POSIPI, B1_TIPO, B1_UM, B1_ZZCONTA, B1_ORIGEM, B1_CLASFIS, B1_GRUPO, B1_LOCPAD, '01' B9_LOCAL, SUM(B9_QINI) SALDO, SUM(B9_VINI1) CUSTO "
__cQuery += "  FROM " + RetSqlName( "SB9" ) + " SB9"
__cQuery += " INNER JOIN " + RetSqlName( "SB1" ) + " SB1 ON B1_FILIAL = B9_FILIAL AND SB1.D_E_L_E_T_ = ' ' AND B1_COD = B9_COD"
__cQuery += " WHERE B9_FILIAL = '" + xFilial( "SB9" ) + "' "
__cQuery += "  AND SB9.D_E_L_E_T_ = ' '"
__cQuery += "   AND B9_DATA = '" + dTOs( dDtInvent ) + "'"
__cQuery += "   AND B9_QINI <> 0 "
//__cQuery += "   AND B9_COD = 'F000129454' "
//__cQuery += "   AND B9_COD IN ('F000142910','F000141663','0000496327', '0000495305') "
//__cQuery += "   AND B9_COD BETWEEN '0000496500' AND '0000496550'"
__cQuery += " GROUP BY B9_COD, B1_ZZCDPRO, B1_ZZLJPRO, B1_POSIPI, B1_TIPO, B1_UM, B1_ZZCONTA, B1_ORIGEM, B1_CLASFIS, B1_GRUPO, B1_LOCPAD"

Return( __cQuery )

/*
** Obtém o tipo (Tratamento bloco K)
*/
static function  getType(self, lTerceiro, aProduct)	
	
	local cTipo 		:= ""
	local cParBlocoK	:= ""
	local aTiposPar		:= {}	
	local lParametro	:= .F.
	
	if lTerceiro
		cTipo := self:getFieldValue("B1_TIPO", aProduct) 
	else
		cTipo := self:getFieldValue("B1_TIPO")
	endIf
	
	if !cTipo $ LISTA_RECEITA_FEDERAL
		
		cParBlocoK := getParBlocK(cTipo)
		if !empty(cParBlocoK)
			aTiposPar := strToKarr(cParBlocoK, ",")
			cTipo := aTiposPar[TIPO_RECEITA_FEDERAL] 
			lParametro	:= .T.
		endIf
		
	endIf
	
	cTipo := self:getProdType(cTipo, lParametro)
	
return cTipo

/*
** Obtém o parâmetro bloco K referente ao tipo
*/
static function getParBlocK(cTipo)
	
	local oSql	 	:= IpSqlObject():newIpSqlObject()
	local cQuery	:= ""
	local xContPar	:= ""
	local cNameTableSX6 := ""
	
	//NECESSÁRIO, POIS O RETSQLNAME RETORNAVA VAZIO QUANDO PASSAVA SX6
	cNameTableSX6 := getNameTableSx6()
	
	cQuery := "SELECT " + CRLF
	cQuery += "	X6_CONTEUD AS CONTEUD " + CRLF
	cQuery += "FROM " + cNameTableSX6 + CRLF
	cQuery += "WHERE 1=1" + CRLF
	cQuery += "	AND X6_FIL = '" + FWxFilial("SX6") + "' " + CRLF
	cQuery += "	AND X6_VAR LIKE 'MV_BLKTP%' " + CRLF
	cQuery += "	AND X6_CONTEUD != ' ' " + CRLF
	cQuery += "	AND D_E_L_E_T_ = ' ' " + CRLF
	
	oSql:newAlias(cQuery)
	
	While oSql:notIsEof()
		
		xContPar := oSql:getValue("CONTEUD")
		
		if cTipo $ xContPar
			exit
		endIf
		oSql:skip()
	EndDo
	
	oSql:close()
		
return xContPar

/**
* retorna o nome da tabela físico no banco
**/
static function getNameTableSx6()
	
	local cNameTableSX6 := "SX6" + cEmpant + "0"
	
return cNameTableSX6
