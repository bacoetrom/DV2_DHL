/*/{Protheus.doc} incSalesOrder
Inclusão de Pedido de Venda
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
/*/
method incSalesOrder() class DhlDisControl
	private lMsErroAuto := .F.
	
	abreTabelas()
	
	MSExecAuto({|x, y, z| Mata410(x, y, z)}, ::getHeader(), ::getItems(), 3)
	
	if lMsErroAuto
		::setError(lMsErroAuto)
		DisarmTransaction()
		::setMsgErro("Falha ao incluir o pedido de vendas"+CRLF+CRLF+::oUtils:getErroAuto())
	endif
return


/*/{Protheus.doc} libSalesOrder
Liberação do Pedido de Venda
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
/*/
method libSalesOrder() class DhlDisControl

	::aItSalesOrder := {}
	::aBlock 		:= {}

	// Liberacao de pedido
	Ma410LbNfs(2,@::aItSalesOrder,@::aBlock)

	// Checa itens liberados
	Ma410LbNfs(1,@::aItSalesOrder,@::aBlock)

	If Empty(::aBlock) .And. !Empty(::aItSalesOrder)
		::setError(.f.)
	Else
		::setError(.t.)
		if InTransaction()
			DisarmTransaction()
		endif
		::setMsgErro("Falha ao liberar o pedido de vendas"+CRLF+CRLF+SC7->C7_NUM)
	Endif

return


/*/{Protheus.doc} incOutFlowInv
Geração do documento de saída
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
@param cSalesOrder, characters, Numero do pedido de venda
@type function
/*/
method incOutFlowInv(cSalesOrder) class DhlDisControl
	local oSql		:= IpSqlObject():newIpSqlObject()
	local aArea		:= GetArea()
	local aAreaSA1	:= SA1->(GetArea())
	local aAreaSB1	:= SB1->(GetArea())
	local aAreaSB2	:= SB2->(GetArea())
	local aAreaSC6	:= SC6->(GetArea())
	local aAreaSC9	:= SC9->(GetArea())
	
	::aItSalesOrder := {}
	
	oSql:NewTable("SC6", "R_E_C_N_O_ RECNO, C6_PRODUTO", 	"%SC6.XFILIAL% AND C6_NUM = '"+cSalesOrder+"' ")
	while oSql:notIsEof()
		
		SC6->(DbGoTo(oSql:getValue("RECNO")))
		Posicione("SB1",1,xFilial("SB1") + oSql:getValue("C6_PRODUTO"),"B1_DESC")
		SC9->(dbSetOrder(2)) 
		SC9->(dbSeek( SC6->C6_FILIAL + SC6->C6_CLI + SC6->C6_LOJA + SC6->C6_NUM + SC6->C6_ITEM ))
	
		::addItSalesOrder()
		
		oSql:skip()
	endDo
	
	::setNumDoc(MaPvlNfs(::getItSalesOrder(), ::getSeries(), .F., .F., .F., .T., .F., 0, 0, .T., .F.))
	
	if Empty(::getNumDoc()) 
		::setError(.t.)
		if InTransaction()
			DisarmTransaction()
		endif
		::setMsgErro("Erro ao gerar nota fiscal de Saída Automática!")
	endif
return


/*/{Protheus.doc} updAuto
Atualiza campo que determina se documento e automático
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
/*/
method updAuto() class DhlDisControl
	if ::getTypeDoc() == DHL_NFE_INVOICE_OUTFLOW
	 	SF2->(RecLock("SF2", .F.))
	 		SF2->F2_ZZAUTO := 'S'
	 	SF2->(MsUnlock())
	 else
	 	SF1->(RecLock("SF1", .F.))
	 		SF1->F1_ZZAUTO := 'S'
	 	SF1->(MsUnlock())
	 endif
return


/*/{Protheus.doc} recordMsgAuto
Realiza a gravação da mensagem das Nfs automáticas
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
@param cDocument, characters, Numero do documento
@param cSeries, characters, serie do documento
@param cSupplier, characters, codigo da entidade fornecedor/cliente
@param cUnit, characters, loja da entidade fornecedor/cliente
@type function
/*/
method recordMsgAuto(cDocument, cSeries, cSupplier, cUnit) class DhlDisControl
	Local oTMsg  := FswTemplMsg():newTemplMsg("S", cDocument, cSeries, cSupplier, cUnit,"SZZ")
	
	aadd(oTMsg:aMsg, {"",::getMsgAuto()})
	
	oTMsg:grvMsg()
return


/*/{Protheus.doc} setMsgAuto
Seta mensagens das Nfs automáticas
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
@param cDocument, characters, Numero do documento
@param cSeries, characters, Serie do documento
@param cSupplier, characters, Codigo do fornecedor
@param cUnit, characters, Loja do fornecedor
@type function
/*/
method setMsgAuto(cDocument, cSeries, cSupplier, cUnit) class DhlDisControl
	local cMsg	:= ""
	local cDate	:= ""
	default cDocument:= ""
	default cSeries	 := ""
	default cSupplier:= ""
	default cUnit	 := ""
	
	cDate := ::getIssueDate(cDocument, cSeries, cSupplier, cUnit)
	
	if !empty(cDocument)
		if !(upper(alltrim(cDocument)) $ ::getMsgAuto()) .and. empty(::getMsgAuto())
			cMsg += "Nota Fiscal emitida nos termos do inciso II do art. 456 do RICMS-SP - Nota Fiscal de " + iif(::getTypeDoc() == DHL_NFE_INVOICE_OUTFLOW, "aquisição", "saída" )
			cMsg += " número " + alltrim(cDocument) + ", série " + alltrim(cSeries) + ", de " + dtoc(stod(cDate)) + ". "
		elseif !(upper(alltrim(cDocument)) $ ::getMsgAuto()) .and. !(empty(::getMsgAuto()))
			cMsg += substr(::getMsgAuto(), 1, len(::getMsgAuto())-2)
			cMsg += ", número " + alltrim(cDocument) + ", série " + alltrim(cSeries) + ", de " + dtoc(stod(cDate)) + ". "
		endif
		::cMsgAuto := cMsg
	else
		if (empty(::getMsgAuto()))
			::cMsgAuto := ""
		endif
	endif
	
return


/*/{Protheus.doc} getIssueDate
//TODO Descrição auto-gerada.
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
@param cDoc, characters, numero do documento
@param cSeries, characters, serie do documento
@param cSupplier, characters, codigo do fornecedor/cliente
@param cUnit, characters, loja do fornecedor/cliente
@type function
/*/
method getIssueDate(cDoc, cSeries, cSupplier, cUnit) class DhlDisControl
	local oSql := IpSqlObject():newIpSqlObject()
	local cDate:= ""

	if ::getTypeDoc() == DHL_NFE_INVOICE_OUTFLOW
		cDate := oSql:getFieldValue("SF1", "F1_EMISSAO", " %SF1.XFILIAL% AND F1_DOC = '"+cDoc+"' AND F1_SERIE = '"+cSeries+"' AND "+;
						" F1_FORNECE = '"+cSupplier+"' AND F1_LOJA = '"+cUnit+"' ")
	else
		cDate := oSql:getFieldValue("SF2", "F2_EMISSAO", " %SF2.XFILIAL% AND F2_DOC = '"+cDoc+"' AND F2_SERIE = '"+cSeries+"' AND "+;
						" F2_CLIENTE = '"+cSupplier+"' AND F2_LOJA = '"+cUnit+"' ")
	endif
	oSql:close()
return (cDate)


/*/{Protheus.doc} validExclusion
Valida exclusao das NFs que fazer parte do processo de NFs automáticas
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
@param cDoc, characters, numero do documento
@param cSeries, characters, serie do documento
@param cItem, characters, item do documento
@param cEntity, characters, codigo da entidade do documento fornecedor/cliente
@param cUnit, characters, loja da entidade do documento fornecedor/cliente
@type function
/*/
method validExclusion(cDoc, cSeries, cItem, cEntity, cUnit) class DhlDisControl
	local oSql := IpSqlObject():newIpSqlObject()

	if ::getTypeDoc() == DHL_NFE_INVOICE_OUTFLOW
		oSql:newTable("SD1", "D1_DOC, D1_SERIE, D1_EMISSAO", retQrysd1(cDoc, cSeries, cItem, cEntity, cUnit))
		if oSql:hasRecords()
			::setError(.t.)
			::setMsgError("Nota Fiscal não pode ser excluída/estornada. " + CRLF +;
						"Para realizar a exclusão/estorno, necessário excluir a NF de Entrada Automática previamente!" + CRLF +;
						" Doc.: " + alltrim(oSql:getValue("D1_DOC"))+; 
						" Série:" + alltrim(oSql:getValue("D1_SERIE")) +; 
						" Data:"  + dtoc(stod(oSql:getValue("D1_EMISSAO"))) + ". ")
		endif
		oSql:close()
	else
		oSql:newTable("SD2", "D2_DOC, D2_SERIE, D2_EMISSAO", retQrySD2(cDoc, cSeries, cItem, cEntity, cUnit))
		if oSql:hasRecords()
			::setError(.t.)
			::setMsgError("Nota Fiscal não pode ser excluída/estornada. " + CRLF +;
						"Para realizar a exclusão/estorno, necessário excluir a NF de Saída Automática previamente!" + CRLF +;
						" Doc.: " + alltrim(oSql:getValue("D2_DOC"))+; 
						" Série:" + alltrim(oSql:getValue("D2_SERIE")) +; 
						" Data:"  + dtoc(stod(oSql:getValue("D2_EMISSAO"))) + ". ")
		endif
		oSql:close()
	endif
	
return


/*/{Protheus.doc} validAutorization
Valida se Nf esta autorizada
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
@param cDoc, characters, numero do documento 
@param cSeries, characters, serie do documento
@param cItem, characters, item do documento
@param cIdentB6, characters, identificacao da tabela de poder der terceiros
@type function
/*/
method validAutorization(cDoc, cSeries, cItem, cIdentB6) class DhlDisControl
	local oSql := IpSqlObject():newIpSqlObject()
	
	oSql:newAlias(retQrySF2(cDoc, cSeries, cItem, cIdentB6))
	
	if oSql:hasRecords()
		if oSql:getValue("FIMP") <> 'S'
			::setError(.t.)
			::setMsgError("Nota Fiscal não pode ser gerada. " + CRLF +;
					"Nota Fiscal abaixo de Débito ICMS não foi autorizada pela Sefaz!" + CRLF +;
					" Doc.: " + alltrim(oSql:getValue("DOC"))+; 
					" Série:" + alltrim(oSql:getValue("SERIE")) +; 
					" Data:"  + dtoc(stod(oSql:getValue("EMISSAO"))) + ". " + CRLF +;
					"Processo de faturamento será abortado. Emissão será possível apenas quando a NF mencionada for regularizada!")
		endif
	endif
	
	oSql:close()
	
return


/*
** Where para tabela SD2
*/
static function retQrySD2(cDoc, cSeries, cItem, cEntity, cUnit)
	local cQuery := ""
	
	cQuery += "%SD2.XFILIAL% AND D2_ZZNFAUT = '" + cDoc + "' AND D2_ZZSEAUT = '" + cSeries + "' AND D2_ZZITAUT = '" + cItem + "'"
	cQuery += "AND D2_CLIENTE = '" + cEntity + "' AND D2_LOJA = '" + cUnit + "' "
	
return (cQuery)


/*
** Where para tabela SD2
*/
static function retQrySD1(cDoc, cSeries, cItem, cEntity, cUnit)
	local cQuery := ""
	
//	cQuery += "%SD1.XFILIAL% AND D1_NFORI = '" + cDoc + "' AND D1_SERIORI = '" + cSeries + "' AND D1_ITEMORI = '" + cItem + "'"
//	cQuery += "AND D1_FORNECE = '" + cEntity + "' AND D1_LOJA = '" + cUnit + "' "

	cQuery += "%SD1.XFILIAL% AND D1_ZZNFAUT = '" + cDoc + "' AND D1_ZZSEAUT = '" + cSeries + "' AND D1_ZZITAUT = '" + cItem + "'"
	cQuery += "AND D1_ZZCLAUT = '" + cEntity + "' AND D1_ZZLJAUT = '" + cUnit + "' "
	
return (cQuery)


/*
** Where para tabela SD2
*/
static function retQrySF2(cDoc, cSeries, cItem, cIdentB6)
	local cQuery := ""
	
	cQuery += " SELECT F2_DOC DOC, F2_SERIE SERIE, 				" + CRLF
	cQuery += " F2_EMISSAO EMISSAO ,F2_FIMP FIMP           		" + CRLF
	cQuery += " FROM %SD2.SQLNAME%                              " + CRLF
	cQuery += " INNER JOIN %SF2.SQLNAME% ON                     " + CRLF
	cQuery += " 	 			F2_FILIAL 	= D2_FILIAL         " + CRLF
	cQuery += " 	AND		F2_DOC		= D2_DOC            	" + CRLF
	cQuery += " 	AND		F2_SERIE	= D2_SERIE            	" + CRLF
	cQuery += " 	AND		F2_CLIENTE	= D2_CLIENTE            " + CRLF
	cQuery += " 	AND		F2_LOJA		= D2_LOJA            	" + CRLF
	cQuery += " 	AND		%SF2.NOTDEL%                        " + CRLF
	cQuery += " INNER JOIN %SB6.SQLNAME% ON                     " + CRLF
    cQuery += "		B6_FILIAL       	= D2_FILIAL             " + CRLF
    cQuery += "		AND B6_DOC      	= D2_ZZNFAUT            " + CRLF
    cQuery += "		AND B6_SERIE    	= D2_ZZSEAUT            " + CRLF
    cQuery += "		AND B6_PRODUTO  	= D2_COD                " + CRLF
    cQuery += "		AND B6_IDENT  		= '"+cIdentB6+"'        " + CRLF
    cQuery += "		AND B6_TPCF 		= 'C'                   " + CRLF
    cQuery += "		AND B6_PODER3 		= 'R'                   " + CRLF
    cQuery += "		AND SB6.D_E_L_E_T_ 	= ' '                   " + CRLF
	cQuery += "  WHERE                                          " + CRLF
	cQuery += "  			D2_ZZNFAUT 	= '" + cDoc 	+ "'    " + CRLF
	cQuery += "  	AND 	D2_ZZSEAUT 	= '" + cSeries 	+ "'    " + CRLF
	cQuery += "  	AND 	D2_ZZITAUT 	= '" + cItem 	+ "'    " + CRLF
	cQuery += "  	AND 	%SD2.XFILIAL%                       " + CRLF
	cQuery += "  	AND		%SD2.NOTDEL%                        " + CRLF
                                                                
	
return (cQuery)


/*
** Controla numeração do SX5
*/
static function contrSx5(cNumDoc, cSerie)
	local oSql		:= IpSqlObject():newIpSqlObject()
	local cNumSx5	:= Soma1(cNumDoc)
	local cTipoNf  	:= SuperGetMv("MV_TPNRNFS")
	local cUpd		:= "X5_DESCRI = '"+cNumSx5+"', X5_DESCSPA = '"+cNumSx5+"', X5_DESCENG = '"+cNumSx5+"'"
	local nDif 		:= 0
	
	oSql:update("SX5",cUpd,"%SX5.XFILIAL% AND X5_TABELA = '"+NF_TABELA+"' AND X5_CHAVE = '"+cSerie+"'")
	
	//TODO Momento de execução de NF de entrada, função esta pulando duas numerações
//	NxtSX5Nota(cSerie, NIL, cTipoNf)
return()

/**
* Abre as tabelas. Necessário, pois na segunda iteração da nota estava dando ajustar DOC_SEQ.
* É necessário abrir as 3 tabelas
**/
static function abreTabelas()
	
	local lStatus := .F.
	
	If Select('SD1') <= 0
		dbSelectArea('SD1')
	EndIf
	If Select('SD2') <= 0
		dbSelectArea('SD2')
	EndIf
	If Select('SD3') <= 0
		dbSelectArea('SD3')
	EndIf
	
	lStatus := (Select('SD1')>0) .And. (Select('SD2')>0) .And. (Select('SD3')>0)
	
return
