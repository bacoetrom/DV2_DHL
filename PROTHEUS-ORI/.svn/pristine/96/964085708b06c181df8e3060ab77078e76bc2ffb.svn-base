/*/{Protheus.doc} hasGeneration
Método para verificação se TES possuí Geração de NF Automática
@author Thiago Meschiatti
@since 24/05/2016
@version 1.0
@param cTes, character, Tes do item
/*/
method hasGeneration(cTes) class DhlDisControl
	local oSql 	:= IpSqlObject():newIpSqlObject()
	local lRet	:= .f.
	
	if oSql:getFieldValue("SF4", "F4_ZZNFAUT", "%SF4.XFILIAL% AND F4_CODIGO = '" + cTes + "' ") == "S"
		lRet := .t.
	endif
	
	oSql:close()
return (lRet)


