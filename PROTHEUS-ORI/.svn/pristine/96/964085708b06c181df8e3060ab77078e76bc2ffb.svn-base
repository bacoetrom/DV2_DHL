	method validAutorization()
	method delInDoc()
	
	method getTes()
	method getObjItems()
	method getSeries()
	
	method addHeader()
	method getHeader() 
	method addItems()
	method getItems() 
	method addEndItems()
	method addItSalesOrder()
	method getItSalesOrder()
	method setTypeDoc()
	method getTypeDoc()
	method setError()
	method hasError()
	method setMsgError()
	method getMsgError()
	method setNumDoc()
	method getNumDoc()
	method setMsgAuto()
	method getMsgAuto()
	method getIssueDate()
	method setEntityAuto()
	method getEntityAuto()
	method setUnitAuto()
	method getUnitAuto()
	method setState()
	method getState()
endclass


/*/{Protheus.doc} newDhlDisControl
Método construtor
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
@param cTypeDoc, characters, Tipo do documento
/*/
method newDhlDisControl(cTypeDoc) class DhlDisControl
	default cTypeDoc:= ""
	
	::oUtils  		:= IpUtilsObject():newIpUtilsObject()
	::aHeader 		:= {}
	::aAuxItems		:= {}
	::aItems  		:= {}
	::aItSalesOrder := {}
	::aBlock		:= {}
	::setMsgAuto()
	::setError()
	::setMsgError()
	::setEntityAuto()
	::setUnitAuto()
	::setTypeDoc(cTypeDoc)
return


