	cRet := oSql:getFieldValue("SF4", "F4_ZZTESAU", "%SF4.XFILIAL% AND F4_CODIGO = '" + cTes + "' ") 
	
	oSql:close()
return (cRet)


/*/{Protheus.doc} getObjItems
Retorna objeto com query para itens do documento(SD1 ou SD2)
@author Thiago Meschiatti
@since 24/05/2016
@version 1.0
@param oSql, objeto, Itens do documento(SD1 ou SD2)
/*/
method getObjItems(cDocument, cSeries, cSupplier, cUnit) class DhlDisControl
	local oSql := IpSqlObject():newIpSqlObject()
	
	default cDocument := ""
	default cSeries   := ""
	default cSupplier := ""
	default cUnit     := ""
	
	if ::getTypeDoc() == DHL_NFE_INVOICE_OUTFLOW
		oSql:NewTable("SD1", "D1_TES TES, SD1.*", 	"%SD1.XFILIAL% AND D1_DOC = '"+cDocument+"' AND D1_SERIE = '"+cSeries+"' AND "+;
									" D1_FORNECE = '"+cSupplier+"' AND D1_LOJA = '"+cUnit+"' ")
	else
		oSql:NewTable("SD2", "D2_TES TES, SD2.*", 	"%SD2.XFILIAL% AND D2_DOC = '"+cDocument+"' AND D2_SERIE = '"+cSeries+"' AND "+;
									" D2_CLIENTE = '"+cSupplier+"' AND D2_LOJA = '"+cUnit+"' ")
	endif
return (oSql)


/*/{Protheus.doc} execAuto
Execução de rotina automática de acordo com o tipo do documento.
@author Thiago Meschiatti
@since 24/05/2016
@version 1.0
@param lRet, logico, Informa se rotina automática foi executada com sucesso.
/*/'
method execAuto(nOperation, lDocDev, lAtuNumber) class DhlDisControl

	default lDocDev 	:= .f.
	default nOperation	:= DHL_OPC_INCLUSAO
	default lAtuNumber	:= .t.
	
	if nOperation == DHL_OPC_EXCLUSAO
		::delInDoc()
	else
		if ::getTypeDoc() == DHL_NFE_INVOICE_OUTFLOW
			::incSalesOrder()
			if !(::hasError())
				::libSalesOrder()
				if !(::hasError())
					::incOutFlowInv(SC5->C5_NUM)
				endif
			endif
		else
			::incInDoc(lDocDev, lAtuNumber)
		endif
	endif
return


/*/{Protheus.doc} incInDoc
Execução separada de rotina automática de documento de entrada
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
/*/
method incInDoc(lDocDev, lAtuNumber) class DhlDisControl
	private lMsErroAuto := .F.
	
	abreTabelas()
	
	MSExecAuto({|x, y, z| Mata103(x, y, z)}, ::getHeader(), ::getItems(), 3)
	
	if lMsErroAuto
		::setError(lMsErroAuto)
		DisarmTransaction()
		if lDocDev
			::setMsgErro(::oUtils:getErroAuto())
		else
			::setMsgErro("Falha ao incluir NF de Entrada Automática(Crédito ICMS). A NF de Entrada deverá ser gerada manualmente."+CRLF+CRLF+::oUtils:getErroAuto())
		endif
	else
		if lAtuNumber
			contrSx5(SF1->F1_DOC, SF1->F1_SERIE)
		endif
	endif
return


/*/{Protheus.doc} delInDoc
Execução separada de rotina automática de documento de entrada(Exclusão)
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
/*/
method delInDoc() class DhlDisControl
	private lMsErroAuto := .F.
	
	abreTabelas()
	
	MSExecAuto({|x, y, z| Mata103(x, y, z)}, ::getHeader(), ::getItems(), 5)
	
	if lMsErroAuto
		::setError(lMsErroAuto)
		::setMsgErro("Falha ao excluir NF de Entrada."+CRLF+CRLF+::oUtils:getErroAuto())
		DisarmTransaction()
	endif
return


/*/{Protheus.doc} incPreInDoc
Execução separada de rotina automática de pré-documento de entrada(Exclusão)
@author Thiago Meschiatti
@since 20/06/2016
