	data aHeader
	data aAuxItems
	data aItems
	data aItSalesOrder
	data aBlock
	data lError

	method newDhlDisControl() constructor
	
	method hasGeneration()
	method execAuto()
	method incSalesOrder()
	method libSalesOrder()
	method incOutFlowInv()
	method incInDoc()
	method preInfInvoice()
	method classInfInvoice()
	method showError()
	method updAuto()
	method recordMsgAuto()
