@type function
/*/
method preInfInvoice(nOperation, lAtuNumber) class DhlDisControl
	private lMsErroAuto := .F.
	
	default nOperation := DHL_OPC_INCLUSAO 
	default lAtuNumber := .t.
	
	abreTabelas()
	
