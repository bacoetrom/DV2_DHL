	if lMsErroAuto
		::setError(lMsErroAuto)
		::setMsgErro(::oUtils:getErroAuto())
//		DisarmTransaction()
	else
		if lAtuNumber
			contrSx5(SF1->F1_DOC, SF1->F1_SERIE)
		endif
	endif
return


