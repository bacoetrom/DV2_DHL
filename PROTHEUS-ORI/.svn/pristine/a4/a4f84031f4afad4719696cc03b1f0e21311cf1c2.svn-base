#include 'protheus.ch'
#include 'dhl.ch'

/*/{Protheus.doc} ProcDevRec
Processamento de Devolução/Recusa
@author Thiago Meschiatti
@since 09/06/2016
@version undefined
/*/
user function ProcDevRec()
	local aAreas 	:= Lj7GetArea({"SC5","SC6","SF1","SF2","SD1","SD2","SA1","SA2","SF4"})
	local aAreaSF1	:= SF1->(GetArea())
	local aAreaSD1	:= SD1->(GetArea()) 	
	local lDev		:= cTipo == 'D'		
	local lRet		:= .t.
	local cTes		:= ""
	local cCliLoj	:= ""
	local nSavNF	:= 0
	local nObj		:= 0
	local nI,nJ		:= 0
	local nPos		:= 0

	private oDevRec		:= DHLDisDevRec():newDHLDisDevRec()
	private oSqlSD1	:= IpSqlObject():newIpSqlObject()

	private aCAb	:= {}
	private aItens := {}
	private aItem := {}
	private lMsErroAuto := .F.

	if lDev
		for nI:=1 to len(aCols)
			if !(gdDeleted())
				if oDevRec:hasGeneration(gdFieldGet("D1_TES", nI))
					cCliLoj := oDevRec:getSA7(gdFieldGet("D1_COD", nI))[1] 
					if nObj > 0
						for nJ:=1 to nObj
							nPos := aScan(&("oContrAut"+cValtoChar(nObj)):getHeader(),{|x| AllTrim(x[2]) == alltrim(cCliLoj)})
							if nPos > 0
								&("cItem"+cValtoChar(nObj)) 	:= Soma1(&("cItem"+cValtoChar(nObj)))
								mountDetail(&("oContrAut"+cValtoChar(nJ)), &("cItem"+cValtoChar(nObj)), oDevRec, nI, nObj)
							else
								nObj++
								&("oContrAut"+cValtoChar(nObj)) := DhlDisControl():newDhlDisControl(DHL_NFE_INVOICE_INFLOW)
								&("cItem"+cValtoChar(nObj)) 	:= Soma1(if(fTypeVar("cItem"+cValtoChar(nObj)), "0000", &("cItem"+cValtoChar(nObj))))
								mountHeader(&("oContrAut"+cValtoChar(nObj)), oDevRec, nI, nObj)
								mountDetail(&("oContrAut"+cValtoChar(nObj)), &("cItem"+cValtoChar(nObj)), oDevRec, nI, nObj)
							endif
						next nJ
					else
						nObj++
						&("oContrAut"+cValtoChar(nObj)) := DhlDisControl():newDhlDisControl(DHL_NFE_INVOICE_INFLOW)
						&("cItem"+cValtoChar(nObj)) 	:= Soma1(if(fTypeVar("cItem"+cValtoChar(nObj)), "0000", &("cItem"+cValtoChar(nObj))))
						mountHeader(&("oContrAut"+cValtoChar(nObj)), oDevRec, nI, nObj)
						mountDetail(&("oContrAut"+cValtoChar(nObj)), &("cItem"+cValtoChar(nObj)), oDevRec, nI, nObj)
					endif
				endif
			endif
		next nI

		nSavNF := MaFisSave()
		MaFisEnd()	

		BEGIN TRANSACTION 
			for nI := 1 to nObj
				if execAuto(&("oContrAut"+cValtoChar(nI)))
					lRet := .f.
					exit
				endif
			next nI
		END TRANSACTION 

		MaFisRestore(nSavNF)
	endif

	RestArea(aAreaSD1)
	RestArea(aAreaSF1)
	Lj7RestArea(aAreas)

return (lRet)

/*
** Where para tabela SD1
*/
static function retQrySD1()
	local cQuery := ""

	cQuery += "%SD1.XFILIAL% AND D1_DOC = '"+SF1->F1_DOC+"' AND D1_SERIE = '"+SF1->F1_SERIE+"' AND D1_FORNECE = '"+SF1->F1_FORNECE+"'"
	cQuery += " AND D1_LOJA = '"+SF1->F1_LOJA+"'"

return (cQuery)


/*
** Monta cabeçalho
*/
static function mountHeader(oContrAut, oDevRec, nI, nObj)	
	local cFromInv	:= ""
	local cSeries	:= GetNewPar("ZZ_SERIDEV", "")

	cFromInv	:= getNumDoc(cSeries, nObj)

	oContrAut:addHeader("F1_FILIAL"   	, xFilial("SF1"))
	oContrAut:addHeader("F1_DOC"   		, cFromInv)
	oContrAut:addHeader("F1_SERIE"   	, cSeries)
	oContrAut:addHeader("F1_ESPECIE"	, "DEV")
	oContrAut:addHeader("F1_TIPO"   	, 'B')
	oContrAut:addHeader("F1_FORNECE"  	, oDevRec:getSA7(gdFieldGet("D1_COD", nI))[1])
	oContrAut:addHeader("F1_LOJA"     	, oDevRec:getSA7(gdFieldGet("D1_COD", nI))[2])
	oContrAut:addHeader("F1_FORMUL"   	, 'S')
	oContrAut:addHeader("F1_COND"     	, GetNewPar("ZZ_CONDDEV", "001"))
	oContrAut:addHeader("F1_EMISSAO"  	, dDataBase)
	oContrAut:addHeader("F1_CHVNFE"  	, getKeyNfe(DHL_NFE_INVOICE_INFLOW))

return


/*
** Monta itens
*/
static function mountDetail(oContrAut, cItem, oDevRec, nI, nObj)
	local oSql		:= IpSqlObject():newIpSqlObject()
	local cFornece	:= oDevRec:getSA7(gdFieldGet("D1_COD", nI))[1]
	local cLoja		:= oDevRec:getSA7(gdFieldGet("D1_COD", nI))[2]
	local cSeries	:= GetNewPar("ZZ_SERIDEV", "")	
	local nQuant	:= 0
	local nPrice	:= 0 
	local nCount	:= 0
	local aCposSX3	:= FWSX3Util():GetAllFields("SD1",.f.)

	cFromInv	:= getNumDoc(cSeries, nObj)
	nPrice 		:= gdFieldGet("D1_VUNIT", nI)
	nQuant 		:= gdFieldGet("D1_QUANT", nI)

	oContrAut:aAuxItems := {}
	oContrAut:addItems("D1_FILIAL"   	, xFilial("SD1")) 
	oContrAut:addItems("D1_ITEM"   		, cItem)	
	oContrAut:addItems("D1_COD"   		, gdFieldGet("D1_COD", nI))
	oContrAut:addItems("D1_FORNECE" 	, cFornece)
	oContrAut:addItems("D1_LOJA"   		, cLoja)
	oContrAut:addItems("D1_UM"   		, gdFieldGet("D1_UM", nI))
	oContrAut:addItems("D1_QUANT"   	, nQuant)
	oContrAut:addItems("D1_VUNIT"   	, A410Arred(nPrice))
	oContrAut:addItems("D1_TOTAL"   	, A410Arred(nPrice * nQuant ,"D1_VUNIT"))
	oContrAut:addItems("D1_TES"   		, oDevRec:getTesDev(gdFieldGet("D1_TES", nI))) 
	oContrAut:addItems("D1_ZZTES"  		, oDevRec:getTesDev(gdFieldGet("D1_TES", nI)))
	oContrAut:addItems("D1_NFORI"   	, cNFiscal)
	oContrAut:addItems("D1_SERIORI"  	, cSerie)
	oContrAut:addItems("D1_ITEMORI"  	, gdFieldGet("D1_ITEM", nI))
	if !empty(gdFieldGet("D1_LOTECTL", nI))
		oContrAut:addItems("D1_LOTECTL"  	, gdFieldGet("D1_LOTECTL", nI))
	endif
	oContrAut:addItems("D1_ZZCHVNF"  	, oDevRec:getKeyNf(gdFieldGet("D1_NFORI", nI), gdFieldGet("D1_SERIORI", nI), gdFieldGet("D1_ITEMORI", nI)))

	for nCount := 1 to len(aCposSX3)

		if AllTrim(getSX3Cache(aCposSX3[nCount],"X3_PROPRI")) == "U" .and. !(AllTrim(aCposSX3[nCount]) $ "D1_ZZTES|D1_ZZCHVNF")
			oContrAut:addItems(AllTrim(aCposSX3[nCount]), gdFieldGet(AllTrim(aCposSX3[nCount]), nI))
		endIf

	next nCount

	GdfieldPUT("D1_ZZCHVNF", cFromInv + cSeries + cItem + cFornece + cLoja , nI)

	oSql:close()

	oContrAut:addEndItems()
return


/**
* Coleta o Tamanho do Número do Documento de acordo com a Serie
*/
static function getNumDoc(cSeries, nObj)

	local cDoc 	 := ""
	local oSql   := IpSqlObject():newIpSqlObject()

	oSql:newTable("SX5", "X5_DESCRI DOCATUAL", "%SX5.XFILIAL% AND X5_TABELA = '01' AND X5_CHAVE = '"+cSeries+"'")

	if oSql:hasRecords()
		cDoc := oSql:getValue("AllTrim(DOCATUAL)")
		if nObj > 1
			cDoc := strZero(val(cDoc) + (nObj-1), TamSx3("F1_DOC")[1])
		endif
	endIf

	oSql:close()

return (cDoc)


/*
** Execução da rotina automática
*/
static function execAuto(oContrAut)
	local aAreaSD1	:= SD1->(GetArea())
	local lIsDev 	:= .t.

	oContrAut:preInfInvoice(DHL_OPC_INCLUSAO, .t.)

	if oContrAut:hasError()
		oContrAut:setMsgError("Falha ao incluir NF Espelho! Verifique o motivo e faça a devolução novamente. " +CRLF+CRLF+oContrAut:getMsgError())
		oContrAut:showError()
	else
		oContrAut:classInfInvoice()

		if oContrAut:hasError()
			oContrAut:setMsgError("Falha ao incluir NF Espelho! Verifique o motivo e faça a devolução novamente. " +CRLF+CRLF+oContrAut:getMsgError())
			oContrAut:showError()
			//		DisarmTransaction()
		endif
	endif





	RestArea(aAreaSD1)

return (oContrAut:hasError())


/**
* Retorna a Chave de Acesso da NFe
*/
static function getKeyNfe(cTipo)

	local dEmissao := CtoD("")
	local cDoc	   := ""
	local cSerChv   := ""
	local cChave   := ""

	if (cTipo == DHL_NFE_INVOICE_INFLOW)
		dEmissao := dDEmissao
		cDoc     := AllTrim(cNFiscal)
		cSerChv  := AllTrim(cSerie)
	endIf

	cChave := getCodUf(SM0->M0_ESTCOB)
	cChave += FsDateConv(dEmissao, "YYMM")
	cChave += SM0->M0_CGC
	cChave += "55"
	cChave += StrZero(Val(cSerie), 3)
	cChave += StrZero(Val(cDoc), 9)
	cChave += GetNewPar("ZZ_TPEMIS", "1")
	cChave += subStr(U_GCifra(Val(cDoc), 9), 1, 9)

	cchave := substr(cChave,1,43) + sfchave( substr(cChave,1,43) )

return cChave

/**
* Retorna o Codigo da UF
*/
static function getCodUf(cUf)

	local aUF    := {}
	local cCodUf := ""
	local nScan	 := 0

	aadd(aUF,{"RO","11"})
	aadd(aUF,{"AC","12"})
	aadd(aUF,{"AM","13"})
	aadd(aUF,{"RR","14"})
	aadd(aUF,{"PA","15"})
	aadd(aUF,{"AP","16"})
	aadd(aUF,{"TO","17"})
	aadd(aUF,{"MA","21"})
	aadd(aUF,{"PI","22"})
	aadd(aUF,{"CE","23"})
	aadd(aUF,{"RN","24"})
	aadd(aUF,{"PB","25"})
	aadd(aUF,{"PE","26"})
	aadd(aUF,{"AL","27"})
	aadd(aUF,{"MG","31"})
	aadd(aUF,{"ES","32"})
	aadd(aUF,{"RJ","33"})
	aadd(aUF,{"SP","35"})
	aadd(aUF,{"PR","41"})
	aadd(aUF,{"SC","42"})
	aadd(aUF,{"RS","43"})
	aadd(aUF,{"MS","50"})
	aadd(aUF,{"MT","51"})
	aadd(aUF,{"GO","52"})
	aadd(aUF,{"DF","53"})
	aadd(aUF,{"SE","28"})
	aadd(aUF,{"BA","29"})
	aadd(aUF,{"EX","99"})

	nScan := aScan(aUF, {|x| x[1] == cUf})

	if (nScan > 0)
		cCodUf := aUF[nScan,2]
	endIf

return cCodUf

/**
* Retorna a chave nfe
*/
static function sfchave(cMostra)
	Local achave := {}
	Local nx := ny := nz := 0
	Local afactor := {2,3,4,5,6,7,8,9}
	Local nsoma := nresto := ndigito := 0
	Local cRet := ""

	cMotTra := substr(cMostra,1,43) //Space(43)

	for nz := 43 to 1 step -1
		ny += 1
		if ny > 8
			ny := 1
		endif
		aadd( achave , { substr(cMotTra,nz,1) , afactor[ny] , (val(substr(cMotTra,nz,1)) * afactor[ny]) })

		nx := len(achave)
		nsoma += achave[nx,3]
	next

	nresto := mod(nsoma,11)
	ndigito := 11 - nresto

	if ndigito >= 10
		ndigito := 0
	endif

	//MsgStop("digito " + str(ndigito))
	cRet := str(ndigito)
return(cRet)

/*
Verifica o tipo da variável
*/
Static Function fTypeVar(cVar)
Return ( Type(cVar) == "U")
