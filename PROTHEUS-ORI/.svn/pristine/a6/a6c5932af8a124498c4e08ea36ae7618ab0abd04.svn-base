#include 'protheus.ch'
#include 'safx07.ch'
#include 'safx.ch'
#include 'dhl.ch'

#define ENTRADA 1
#define SAIDA   2
#define AMBAS   3 

/*/{Protheus.doc} DHLSafx07Ag2

Respons‡vel pelas regras e montagem das informacoes para a exportacao
	
@author Thiago Meschiatti
@since 05/09/2016

/*/
user function _07Ag2Safx;return

class DHLSafx07Ag2 from DHLSafx
	
	data lDocRef
	data cDocType	as string
	
	method newDHLSafx07Ag2(nTamPos) constructor
	method getSql(nType,dDtFrom , dDtUntil)
	method addLine()
	method notFieldRequired()
	method setDocRef()
	method hasDocRef()
	//Emerson Holanda 20/03/20 -- Metodos para tratar documentos complementares
	method isDocSupplier()
	method isDocComplement()
	method getDocType()

endclass



method newDHLSafx07Ag2(nTamPos,oHeaderSql) class DHLSafx07Ag2
	lDocRef := .f.
	::setDocRef(lDocRef)
return


