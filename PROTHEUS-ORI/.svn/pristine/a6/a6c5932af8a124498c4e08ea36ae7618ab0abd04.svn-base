/*
** Valida Tipo de de frete
*/
static function validFrete(cType, aInOutFlows, oSelf)
	local cTipoFrete	:= ""
	
	if cType == "1"
		if (cSFT_)->f1_TPFRETE $ 'C'
			cTipoFrete := '1'
		elseif (cSFT_)->f1_TPFRETE $ 'F'
			cTipoFrete := '2'
		else
			cTipoFrete := '0'
		endif
	else
		if (cSFT_)->f2_TPFRETE $ 'C'
			cTipoFrete := '1'
		elseif (cSFT_)->f2_TPFRETE $ 'F'
			cTipoFrete := '2'
		else
			cTipoFrete := '0'
		endif
	endif
return (cTipoFrete)

/*
** Valida Tipo de de frete
*/
static function validFat(cCond, cTes)
	local oSql		:= IpSqlObject():newIpSqlObject()
	local cTipoInd	:= ""
	local cTipoCond	:= ""
	local cPrazo	:= ""
	
	if empty(cCond)
		cTipoInd := SAFX07_FAT_ASEMPGTO
	else
		if oSql:getFieldValue("SF4", "F4_DUPLIC", " %SF4.XFILIAL% AND F4_CODIGO = '"+cTes+"' ") $ 'N'
			cTipoInd := SAFX07_FAT_ASEMPGTO
		else
			cTipoCond 	:= oSql:getFieldValue("SE4", "E4_TIPO", " %SE4.XFILIAL% AND E4_CODIGO = '"+cCond+"' ")
			cPrazo		:= oSql:getFieldValue("SE4", "E4_COND", " %SE4.XFILIAL% AND E4_CODIGO = '"+cCond+"' ")
			if cTipoCond $ '1' .and. cPrazo $ '00|0|01|1'
				cTipoInd := SAFX07_FAT_AVISTA
			else
				cTipoInd := SAFX07_FAT_APRAZO
			endif
		endif
	endif

return (cTipoInd)

static function montamail( aresult , ndirx )
local ctexto	:= ""

	cTexto := '<html><title></title><body>'
	cTexto += '<table borderColor="#0099cc" height="29" cellSpacing="1" width="645" borderColorLight="#0099cc" border=1>'
	cTexto += ' <tr><td borderColor="#0099cc" borderColorLight="#0099cc" align="left" width="100%"'
	cTexto += '    borderColorDark="#0099cc" bgColor="#0099cc" height="1">'
	cTexto += '    <p align="center"><FONT face="Courier New" color="#ffffff" size="4">'
	cTexto += '    <b>(WorkFlow) - Execução safx52 ag2 diretorio ' + strzero(ndirx,2) + '<br />teste performance- checkpoint a cada 100 registros<br />'
	ctexto += "<br />" 
	ctexto += ALLTRIM(SM0->M0_NOME) + "-" + ALLTRIM(SM0->M0_FILIAL) +  "<br /><br />"

	//if !empty(cnomevend)
	//	ctexto += alltrim(cNomeVend) + '</b></font></p></td></tr>'
	//else
	//	ctexto += "PEDIDOS EXPEDIDOS" + '</b></font></p></td></tr>'
	//endif
	
	cTexto += ' <tr><td align="left" width="100%" height="100%"><p align="left"><b>    '
	cTexto += MontaTabelaHTML(aresult, .f., "100%")		
	cTexto += '</b></p></td></tr>'  
	cTexto += '</table><br>'  			 
return( ctexto )

/**
* Função responsável em enviar e-mail
**/
Static Function SendEmail(ctexto)
		
	Local aArquivos 	:= {}
	Local nI			:= 1
	Local oMail			:= DHLSndMail():Create()
	Local cDescrResu 	:= ""	
	Local cDescrCompl 	:= ""
	Local aAnexos		:= {} //GetAnexos()
	
	Private cEmailFrom		:= alltrim(GetMv("MV_RELFROM"))

	oMail:cFrom	 	:= alltrim(GetMv("MV_RELFROM")) // cEmailFrom
	oMail:cTo		:= "jairo.oliveira@fitgestao.com.br" //cEmailTo
	oMail:aAttached	:= aAnexos
	oMail:cSubject	:= "log safx " + dToc(dDataBase)
	oMail:cBody		:= ctexto //"<html><head></head><body>Arquivos em anexos.</body></html>"
	oMail:lSilence	:= .f.
	
	//Conout("[" + DToC(dDataBase) + " - " + Time() + "] - Envio de e-mail de  "+cEmailFrom  )
	//Conout("[" + DToC(dDataBase) + " - " + Time() + "] - Para: " + cEmailTo )
			
	If oMail:Send()
		//Conout("[" + DToC(dDataBase) + " - " + Time() + "] - Enviado com sucesso.")
		ni := ni
	Else
		cDescrResu	:= "E-mail"
		cDescrCompl	:= "Não foi possível enviar o e-mail"
		//SaveLog(cDescrResu,cDescrCompl)
		//Conout("[" + DToC(dDataBase) + " - " + Time() + "] - Falha no envio do e-mail.")
	EndIf
		
Return

//Emerson Holanda 20/03/20 - Utilizacao de metodos ja existentes para notas complementares

/*/{Protheus.doc} isDocSupplier

Verifica se o documento é de Entrada e de Fornecedor (1 perna)
	

@return logico 
/*/
method isDocSupplier()  class DHLSafx07Ag2
	local lRet	:= .f.
	
	if ::getDocType() == "1" .and. empty(::getFieldValue("F3_TIPO"))
		lRet	:= .t.
	endif

return (lRet)

/*/{Protheus.doc} isDocComplement

Verifica se o documento é de Complemento
	

@return logico 
/*/
method isDocComplement()  class DHLSafx07Ag2
	local lRet	:= .f.
	
	if (cSF3_)->(F3_TIPO) $ 'C|I|P' //::getFieldValue("F3_TIPO") $ 'C|I|P'
		lRet	:= .t.
	endif

return (lRet)


method getDocType() class DHLSafx07Ag2
return (::cDocType)