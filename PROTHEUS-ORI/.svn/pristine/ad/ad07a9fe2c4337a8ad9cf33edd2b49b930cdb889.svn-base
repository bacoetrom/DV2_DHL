/**
 *	Retorna o erro da rotina automática
 */
static function mostraErroRotAuto()

	local aErro  := {}
	local nI 	 := 0
	local cError := ""
	
	aErro := GetAutoGRLog()
	
    for nI := 1 to Len(aErro)
    	cError += aErro[nI] +CRLF
    next nI

return cError


/* 
** Retorna valor unitário através de LIFO
*/
static function retVUnit(cCodProd)
	local oSqlUtil	:= IpSqlObject():newIpSqlObject()
	local cQuery 	:= ""	
	local nRet		:= 0
	
	cQuery += " Select * from (SELECT MAX(SD1.R_E_C_N_O_) RECNO, D1_VUNIT, D1_VALIPI, D1_ICMSRET FROM %SD1.SQLNAME%       "+CRLF
	cQuery += " INNER JOIN %SF4.SQLNAME% ON                                                      "+CRLF
	cQuery += " 	%SF4.NOTDEL%                                                                 "+CRLF
	cQuery += " 	AND D1_FILIAL 	= F4_FILIAL                                                  "+CRLF
	cQuery += " 	AND D1_TES 		= F4_CODIGO                                                  "+CRLF
	cQuery += " 	AND F4_ZZSTATU 	=  'G'                                                       "+CRLF
	cQuery += " WHERE                                                                            "+CRLF
	cQuery += " 	%SD1.NOTDEL%                                                                 "+CRLF
	cQuery += " 	AND %SD1.XFILIAL%                                                            "+CRLF
	cQuery += " 	AND D1_COD 			= '"+cCodProd+"'                                         "+CRLF
	cQuery += " 	AND D1_FORNECE		= '"+Left(GetMv("ZZ_FORNDEP"), tamsx3("A2_COD")[1])+"'   "+CRLF
	cQuery += " 	AND D1_LOJA			= '"+Right(GetMv("ZZ_FORNDEP"), tamsx3("A2_LOJA")[1])+"' "+CRLF
	cQuery += " GROUP BY D1_VUNIT, D1_VALIPI, D1_ICMSRET Order by RECNO DESC) Where rownum = 1   "+CRLF
	
	oSqlUtil:newAlias(cQuery)
	
	if oSqlUtil:hasRecords()
		if GetNewPar("ZZ_ICSTDEV", .T.)
			nRet := oSqlUtil:getValue("D1_VUNIT") + oSqlUtil:getValue("D1_VALIPI") + oSqlUtil:getValue("D1_ICMSRET")
		else
			nRet := oSqlUtil:getValue("D1_VUNIT") + oSqlUtil:getValue("D1_VALIPI")
		endif
	endif
	
	oSqlUtil:close() 
return(nRet)


/*
** Retorna cliente e loja
*/ 
static function retCliDhl(cCliente, cLoja)
	local oSql 		:= IpSqlObject():newIpSqlObject()
	local cQuery 	:= ""
	local lOk		:= .t.
	
	cQuery := "%SA1.XFILIAL% AND A1_CGC = '" + SM0->M0_CGC + "'
	
	oSql:newTable("SA1", "A1_COD, A1_LOJA", cQuery)
	
	if oSql:hasRecords()
		cCliente := oSql:getValue("A1_COD")
		cLoja	 := oSql:getValue("A1_LOJA")
	else
		lOk := .f.
		oLogImp:start(cApplication,DHL_IMPORTACAO,cXmlArq)
		oLogImp:fail(INTERFACE_NAME,"Cliente DHL não localizado. CNPJ: " + SM0->M0_CGC)
	endif
	
	oSql:close()
	
return (lOk)