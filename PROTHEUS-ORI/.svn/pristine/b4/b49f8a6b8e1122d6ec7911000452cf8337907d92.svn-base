	cQuery += "FROM   (SELECT CASE "
	cQuery += "                 WHEN f3_tipo IN ( 'D', 'B' ) THEN '"+SAFX_MOVIMENTO_DEVOLUCAO+"' "
	cQuery += "                 ELSE '"+SAFX_MOVIMENTO_NORMAL+"' "
	cQuery += "               END             tipo, "
	cQuery += "               f3_cliefor, "
	cQuery += "               f3_loja, "
	cQuery += "               f3_nfiscal, "
	cQuery += "               f3_serie, "
	cQuery += "               f3_entrada, "
	cQuery += "               f3_dtcanc, "
	cQuery += "               Sum(f3_valicm)  f3_valicm, "
