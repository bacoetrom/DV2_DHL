aadd( acampoF4 , "F4_BASEIPI" )
aadd( acampoF4 , "F4_DESTACA" )
aadd( acampoF4 , "F4_LFICM" )


for nx := 1 to len( acampo )
	ccampos += if(nx=1,"",",") + acampo[nx] 
next


if ctype == "1"
	for nx := 1 to len( acampoF1 )
		ccampos += "," + acampoF1[nx]
	next
	
	for nx := 1 to len( aCampoD1 )
		ccampos += "," + acampoD1[nx]
	next
else
	for nx := 1 to len( acampoF2 )
		ccampos += "," + acampoF2[nx]
	next
	
	for nx := 1 to len( aCampoD2 )
		ccampos += "," + acampoD2[nx]
	next
endif

for nx := 1 to len( acampoF4 )
	ccampos += "," + acampoF4[nx]
next


CQUERY := "SELECT " + ccampos + " from " + RETSQLNAME("SFT") + " SFT , " + RETSQLNAME("SB1") + " SB1 ," 
IF Ctype == "1"
	CQUERY  += RETSQLNAME("SF1") + " SF1, " + RETSQLNAME("SD1") + " SD1, "
else
	CQUERY += RETSQLNAME("SF2") + " SF2, " + RETSQLNAME("SD2") + " SD2, "
endif

CQUERY += RETSQLNAME("SF4") + " SF4 "

cWhere := "ft_filial = '" + xfilial("SFT") + "' and ft_tipomov='" + iif(cType == '1', 'E', 'S') + "' and ft_serie= '"+cSer+"' and ft_nfiscal ='"+cDoc+"' and "+;
		  " ft_cliefor ='"+cCod+"' and ft_loja ='"+cBranch+"' " 
if empty( (cSF3_)->f3_dtcanc)
	cWhere += " AND SFT.D_E_L_E_T_ = ' ' "
endif

 cWhere += " and b1_filial = '" + xfilial("SB1") + "' and b1_cod = ft_produto and SB1.D_E_L_E_T_ = ' ' "

cprefix := IF( cTYPE == "1" , "F1" , "F2")
cWhere += " AND " + cPrefix+"_filial= '" + XFILIAL(IF(CTYPE=="1","SF1","SF2")) +"' and "+cPrefix+"_doc = '" +cDoc+ "' and "+cPrefix+"_serie ='"+cSer+"' and "
if cType == "2"
	cWhere += cPrefix+"_cliente = '"+cCod+"' and "
else 
	cWhere += cPrefix+"_fornece = '"+cCod+"' and "
endIf
cWhere +=  cPrefix+"_loja='"+cBranch+"' "

if empty( (cSF3_)->f3_dtcanc)
	cWhere += " AND " + if(cType == "1","SF1.","SF2.") + "D_E_L_E_T_ = ' ' "
endif

cprefix := IF( cTYPE == "1" , "D1" , "D2")
cWhere += " AND " +  cPrefix+"_filial= '" + XFILIAL(IF(CTYPE=="1","SD1","SD2")) + "' and "+cPrefix+"_doc = '" +cDoc+ "' and "+cPrefix+"_serie ='"+cSer+"' and "
if cType == "2"
	cWhere += cPrefix+"_cliente = '"+cCod+"' and "
else 
	cWhere += cPrefix+"_fornece = '"+cCod+"' and "
endIf
cWhere +=  cPrefix+"_loja='"+cBranch+"' "

cWhere += " and " + cPrefix + "_TES <> '    ' and " + cprefix + "_item = ft_item "

if empty( (cSF3_)->f3_dtcanc)
	cWhere += " AND " + if(cType == "1","SD1.","SD2.") + "D_E_L_E_T_ = ' ' "
endif

cWhere 	+= " AND f4_filial ='"+ XFILIAL("SF4") + "'  and f4_codigo =" + CPREFIX+"_TES and sf4.d_e_l_e_t_= ' ' " 

NX := NX   

cret := cquery + " where " + cwhere + " order by ft_item "

if !empty( (cSF3_)->f3_dtcanc)
    nx := nx
endif

dbUseArea( .t. , "TOPCONN",TcGenQry(,,cRet),cSFt_,.f.,.t.)

(cSFT_)->(dbgotop())

return()
