aadd( acampoF1 , "F1_TIPO" )
aadd( acampoF1 , "F1_FILIAL" )
aadd( acampoF1 , "F1_SERIE" )
aadd( acampoF1 , "F1_DOC" )
aadd( acampoF1 , "F1_LOJA" )
aadd( acampoF1 , "F1_MENNOTA" )
