#include "totvs.ch"
#include "dhl.ch"

#define CAMPOS_SZA  	"ZA_FILIAL #ZA_NFRET  #ZA_SERIRET#ZA_NFRCO  #ZA_SERIRCO#ZA_F3QTLIN #ZA_NFRCOX5"
#define CAMPOS_SZB 	"ZB_FILIAL #ZB_PEDIDO #ZB_ITEMPV "
#define SUFRAMA	  	"7"

/*/{Protheus.doc} SAPIP040

Rotina responsável por ler e processar a interface SAP IP 040 e gravar os dados da nota fiscal SCJ em tabelas personalizadas.
Processo para a Unidade de Negócio AG2(SCJ - PUZZLE)
	
@author Diogo Mesquita
@since 17/05/2017
/*/
user function SAPIP040(cFilePath)

	local lError		:= .f.
	private cFile		:= cFilePath
	private oIp040		:= DHLIp040Sap():newDHLIp040Sap()
	
	BEGIN TRANSACTION
		BEGIN SEQUENCE
			lError := incNFSCJ()
			if lError
				BREAK
			endif
		RECOVER
			DisarmTransaction()
		END SEQUENCE
	END TRANSACTION
	
return lError

/**
* Inclui NF SCJ em tabelas personalizadas
**/
static function incNFSCJ()
	
	local aArea		:= GetArea()
	local lError		:= .f.		
	local aItems		:= {}
	local nItem		:= 1
	local nLenItem	:= 0
	local oSql			:= IpSqlObject():newIpSqlObject()
	local cQuery		:= ""
	local nF3QtLin	:= 0
	local cWhere		:= ""
	local lUpdate		:= .f.
	Local nCount		:= 0
	local aCposSX3		:= FWSX3Util():GetAllFields("SZA", .f.)
		
	SZA->(DbSelectArea("SZA"))
	SZA->(DbSetOrder(1))
	if SZA->(DbSeek(xFilial("SZA") + getKeNFSCJ()))
		DisarmTransaction()
		setFileLog(cFile,"fail","Interface não pode ser processada. NF SCJ já importada no Protheus - Chave NFe: "+alltrim(getKeNFSCJ())+".")
		lError := .t.
	endif
		
	if !(lError)
		
		if SZA->(RecLock("SZA",.T.))
			SZA->ZA_FILIAL  := xFilial("SZA")
			
			for nCount := 1 to len(aCposSX3)
				if X3Uso(getSX3Cache(aCposSX3[nCount],"X3_USADO")) .and. cNivel >= getSX3Cache(aCposSX3[nCount],"X3_NIVEL") .and. !(aCposSX3[nCount] $ CAMPOS_SZA)
					
					
					&("SZA->" + alltrim(aCposSX3[nCount])) := &("get" + allTrim(SubStr(aCposSX3[nCount],4,7)) + "()")
		 		endif
			next nCount
			
			SZA->(MsUnlock())	
		
			if ValType(oXml:_IP_040:_BODY:_FILEITEM) == "A"
					
				nLenItem := Len(oXml:_IP_040:_BODY:_FILEITEM)
				aItems   := {}
						
				for nItem := 1 to nLenItem
				
					if !incItNFSCJ(@nItem)
						lError := .t.
						exit
					endif
					
				next nItem
						
			elseif ValType(oXml:_IP_040:_BODY:_FILEITEM) == "O"
				
				nItem	:= 0
				aItems  := {}
				
				if !incItNFSCJ(@nItem)
					lError := .t.
				endif
						
			endif
		
			// Atualiza o campo ZA_F3QTLIN
			nF3QtLin := oIp040:getQtyLinSF3(getKeNFSCJ())
			
			cWhere := "ZA_FILIAL  = '%SZA.FILIAL%' AND "
			cWhere += "ZA_KENFSCJ = '"+getKeNFSCJ()+"'"
			
			lUpdate := oSql:update("SZA","ZA_F3QTLIN = " + Str(nF3QtLin),cWhere)
						
			if !(lUpdate)
				lError := .T.
				setFileLog(cFile,"fail","Falha ao atualizar o campo ZA_F3QTLIN." + CRLF + CRLF + oSql:getLastError())
			endif
			
		endif
	endif
	
	RestArea(aArea)
	
return lError 


/**
* Inclui o item da NF SCJ em tabela personalizada
**/
static function incItNFSCJ(nItem)
	
	local lOk		:= .t.
	Local nCount	:= 0
	Local aCposSX3	:= FWSX3Util():GetAllFields("SZB", .f.)
	
	Private cItem		:= ""
	
	SZB->(RecLock("SZB",.T.))
	SZB->ZB_FILIAL  := xFilial("SZB")
	
	for nCount := 1 to len(aCposSX3)
	
		If  X3Uso(getSX3Cache(aCposSX3[nCount],"X3_USADO")) .and. cNivel >= getSX3Cache(aCposSX3[nCount],"X3_NIVEL") .and.;
		 	!(PADR(aCposSX3[nCount],Len(getSX3Cache(aCposSX3[nCount],"X3_CAMPO"))) $ CAMPOS_SZB)
			
			&("SZB->" + alltrim(aCposSX3[nCount])) := &("get" + allTrim(SubStr(aCposSX3[nCount],4,7)) + iif( allTrim(aCposSX3[nCount]) == "ZB_KENFSCJ","()","(" + STR(nItem) + ")"))
		EndIf
	
	next nCount
	
	SZB->(MsUnlock())
	
return lOk


/**
* Coleta o Número nota fiscal SCJ
**/
static function getDocSCJ()

	local cChvNfe := AllTrim(oXml:_IP_040:_BODY:_FILEHEADER:_KEY_NF_SCJ:TEXT)

	/*
	cUF:	Código da UF do emitente do Documento Fiscal	-	02 caracteres
	AAMM:	Ano e Mês de emissão da NFe						-	04 caracteresf
	CNPJ:	CNPJ do emitente									-	14 caracteres
	mod:	Modelo do Documento Fiscal						-	02 caracteres
	serie:	Série do Documento Fiscal						-	03 caracteres
	nNF:	Número do Documento Fiscal						-	09 caracteres
	cNF:	Código Numérico que compõe a Chave de Acesso	-	09 caracteres
	cDV:	Dígito Verificador da Chave de Acesso			-	01 caracter
	*/

return PadR(SubStr( cChvNfe, 26, 09 ), TamSx3("ZA_DOCSCJ")[1])


/**
* Coleta a Serie nota fiscal SCJ
**/
static function getSeriSCJ()

	local cChvNfe := AllTrim(oXml:_IP_040:_BODY:_FILEHEADER:_KEY_NF_SCJ:TEXT)

	/*
	cUF:	Código da UF do emitente do Documento Fiscal	-	02 caracteres
	AAMM:	Ano e Mês de emissão da NFe						-	04 caracteres
	CNPJ:	CNPJ do emitente									-	14 caracteres
	mod:	Modelo do Documento Fiscal						-	02 caracteres
	serie:	Série do Documento Fiscal						-	03 caracteres
	nNF:	Número do Documento Fiscal						-	09 caracteres
	cNF:	Código Numérico que compõe a Chave de Acesso	-	09 caracteres
	cDV:	Dígito Verificador da Chave de Acesso			-	01 caracter
	*/

return PadR(SubStr( cChvNfe, 23, 03 ), TamSx3("ZA_SERISCJ")[1])


