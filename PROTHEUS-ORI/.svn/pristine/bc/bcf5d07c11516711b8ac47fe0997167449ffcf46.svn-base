/**
* Coleta a TES 
**/
static function getTES(nItem)
	local xRet 			:= ""
	local oDhlIp040Sap 	:= DhlIp040Sap():newDhlIp040Sap()
	
	xRet := oDhlIp040Sap:getTesOperation(getIcmTxVl(nItem), getIcmStVl(nItem), getDiscIcm(nItem), getVIcmUFD(nItem), getIcmExRe(nItem))
	
return (xRet)


/**
* Coleta a CFOP
**/
static function getCFOP(nItem)
	local xRet 			:= ""
	local oDhlIp040Sap	:= DhlIp040Sap():newDhlIp040Sap()
	local cTes				:= ""
	local oSql				:= IpSqlObject():newIpSqlObject() 
	
	cTes := oDhlIp040Sap:getTesOperation(getIcmTxVl(nItem), getIcmStVl(nItem), getDiscIcm(nItem), getVIcmUFD(nItem), getIcmExRe(nItem))
	
	if !(Empty(cTes))
		xRet := oSql:getFieldValue("SF4", "F4_CF", " %SF4.XFILIAL% AND F4_CODIGO = '"+cTes+"' ")
	endif	
	
return (xRet)


/**
* Coleta valor total dos produto + valor do ICMS ST + IPI
**/
static function getTotVlSt(nItem)
	local xRet 	:= 0
	local xSt  	:= 0
	local xIpi 	:= 0
	local xFcpSt:= 0 
	
	local xRet := ""
	
	if nItem > 0
		xRet := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_TOTAL_VALUE:TEXT)
		
		if Type("oXml:_IP_040:_BODY:_FILEITEM["+str(nItem)+"]:_ICMS:_ICMS_ST_VALUE:TEXT") <> "U"
			xSt	 := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_ICMS:_ICMS_ST_VALUE:TEXT)
		Endif
		
		if Type("oXml:_IP_040:_BODY:_FILEITEM["+str(nItem)+"]:_IPI_VALUE:TEXT") <> "U"
			xIpi	 := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_IPI_VALUE:TEXT)
		Endif
		
		if Type("oXml:_IP_040:_BODY:_FILEITEM["+str(nItem)+"]:_ICMS") <> "U"
			xFcpSt := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_ICMS:_SUB_TRIB_FCP_AMOUNT:TEXT)
		endif
		
	else
		xRet := Val(oXml:_IP_040:_BODY:_FILEITEM:_TOTAL_VALUE:TEXT)
		
		if Type("oXml:_IP_040:_BODY:_FILEITEM:_ICMS:_ICMS_ST_VALUE:TEXT") <> "U"
			xSt := Val(oXml:_IP_040:_BODY:_FILEITEM:_ICMS:_ICMS_ST_VALUE:TEXT)
		Endif
		
		if Type("oXml:_IP_040:_BODY:_FILEITEM:_IPI_VALUE:TEXT") <> "U"
			xIpi := Val(oXml:_IP_040:_BODY:_FILEITEM:_IPI_VALUE:TEXT)
		Endif
		
		if Type("oXml:_IP_040:_BODY:_FILEITEM:_ICMS") <> "U"
			xFcpSt := Val(oXml:_IP_040:_BODY:_FILEITEM:_ICMS:_SUB_TRIB_FCP_AMOUNT:TEXT)
		endif
	endif	
	
	xRet += xSt + xIpi + xFcpSt
	
return (xRet)


