/**
* Coleta a Base de Calculo do ICMS
**/
static function getIcmTxBs(nItem)
	local xRet := 0
	
	If AllTrim(getIcmExRe(nItem)) # SUFRAMA
		if nItem > 0
			if Type("oXml:_IP_040:_BODY:_FILEITEM["+str(nItem)+"]:_ICMS") <> "U"
				xRet := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_ICMS:_ICMS_TAX_BASE:TEXT)
			endif
		else
			if Type("oXml:_IP_040:_BODY:_FILEITEM:_ICMS") <> "U"
				xRet := Val(oXml:_IP_040:_BODY:_FILEITEM:_ICMS:_ICMS_TAX_BASE:TEXT)
			endif
		endif
	EndIf
	
return (xRet)


/**
* Coleta o Valor do ICMS
**/
static function getIcmTxVl(nItem)
	local xRet := 0
	
	If AllTrim(getIcmExRe(nItem)) # SUFRAMA
		if nItem > 0
			if Type("oXml:_IP_040:_BODY:_FILEITEM["+str(nItem)+"]:_ICMS") <> "U"
				xRet := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_ICMS:_ICMS_TAX_VALUE:TEXT)
			endif
		else
