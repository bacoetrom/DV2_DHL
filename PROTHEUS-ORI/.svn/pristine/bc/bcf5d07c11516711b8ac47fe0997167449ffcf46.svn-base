Author.: Alberto (DHL)
Projeto: NF 4.0

<UTRIB>CX</UTRIB>
<QTRIB>127.0000</QTRIB>
<VUNTRIB>29.34976379</VUNTRIB>
************************************************************************************************************/
static function getUTrib(nItem)

	local xRet := ""
	
	if nItem > 0
		xRet := AllTrim(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_UTRIB:TEXT)
	else
		xRet := AllTrim(oXml:_IP_040:_BODY:_FILEITEM:_UTRIB:TEXT)
	endif	
	
	if !Empty(xRet)
		updPrd(cItem, "B1_SEGUM", xRet)
	endif
	
return (xRet)

static function getQTrib(nItem)

	local xRet := ""
	local nQtd := getQuantit(nItem)

	if nItem > 0
		xRet := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_QTRIB:TEXT)
	else
		xRet := Val(oXml:_IP_040:_BODY:_FILEITEM:_QTRIB:TEXT)
	endif	
	
	if !Empty(xRet)
		updPrd(cItem, "B1_CONV", xRet/nQtd)
	endif
	
return (xRet)

static function getVTrib(nItem)

	local xRet := ""
	
	if nItem > 0
		xRet := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_VUNTRIB:TEXT)
	else
		xRet := Val(oXml:_IP_040:_BODY:_FILEITEM:_VUNTRIB:TEXT)
	endif	
return (xRet)

