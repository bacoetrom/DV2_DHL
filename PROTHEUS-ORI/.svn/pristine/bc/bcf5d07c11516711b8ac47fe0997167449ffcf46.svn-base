/**
* Coleta o MVA
**/
static function getMVA(nItem)
	local xRet      := 0
	local nVlrIcmSt := 0
	
	nVlrIcmSt := getIcmStVl(nItem)
		
	if nItem > 0
		if Type("oXml:_IP_040:_BODY:_FILEITEM["+str(nItem)+"]:_ICMS_DIFAL") <> "U"
			xRet 	:= Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_ICMS_DIFAL:_MVA:TEXT)
			cItem 	:= getItem(nItem)
		endif
	else
		if Type("oXml:_IP_040:_BODY:_FILEITEM:_ICMS_DIFAL") <> "U"
			xRet := Val(oXml:_IP_040:_BODY:_FILEITEM:_ICMS_DIFAL:_MVA:TEXT)
			cItem 	:= getItem(0)
		endif
	endif
	
	if (nVlrIcmSt == 0 .and. xRet > 0)
		xRet := 0
	endif
	
	updPrd(cItem, "B1_PICMRET", xRet)
return (xRet)


