return (xRet)


/**
* Coleta a quantidade de linhas que deverão ser criadas na tabela CD2
**/
static function getCD2QtLi(nItem)
	
	local xRet 	:= 0
		
	if getIcmTxVl(nItem) > 0
		xRet +=1
	endif
	
	if getIcmStVl(nItem) > 0
		xRet +=1
	endif
	
	if getVIcmUFD(nItem) > 0
		xRet +=1
	endif
			
return (xRet)


/**
 * Define os Logs de acordo com os tipos de arquivos
 */
static function setFileLog(cFile,cLogType,cLogText,cTag,cValue)
	
	local cInterface := "SAP IP_040"
	
	oLog:start(APP_SAP,DHL_IMPORTACAO,cFile)
	
	if !(Empty(cTag))
		cLogText += CRLF+CRLF+"Tag: "+cTag
	endIf
	
	if !(Empty(cValue))
		cLogText += CRLF+CRLF+"Valor: "+cValue
	endIf
	
	if (cLogType == "fail")
		oLog:fail(cInterface, cLogText)
	elseIf (cLogType == "warn")
		oLog:warn(cInterface, cLogText)
	endIf	
	
return


Static Function updPrd(cItem, cField , xValue)
	Local oSqlSB1	:= IpSqlObject():newIpSqlObject()
	Local cWhere	:= ""
	Local cUpd	:= ""	
	
	cWhere += " %SB1.XFILIAL% AND "
	cWhere += " B1_COD 		= '" + cItem + "'"
	
	If ValType(xValue) == "C"
		cUpd	 := cField + " = '" + xValue + "'"
	Else
		cUpd	 := cField + " = " + Str(xValue)
	Endif
	
	if !oSqlSB1:update("SB1", cUpd, cWhere)
		lError := .T.
		setFileLog(cFile,"fail","Falha ao atualizar o campo " + cField + "." + CRLF + CRLF + oSqlSB1:getLastError())
	endif
	
	oSqlSB1:close()
Return