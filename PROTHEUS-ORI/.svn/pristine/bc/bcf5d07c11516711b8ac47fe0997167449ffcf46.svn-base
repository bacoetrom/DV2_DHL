/***********************************************************************************************************

Author.: Edson Deluca - FIT GEstão
Projeto: NF 4.0

=>  <SUB_TRIB_FCP_TOTAL>0</SUB_TRIB_FCP_TOTAL> ---> SZA->ZA_FCPTOTA

=>  <SUB_TRIB_FCP_RATE>0</SUB_TRIB_FCP_RATE>   ---> SZB->ZB_FCPRATE
=>  <SUB_TRIB_FCP_AMOUNT>0</SUB_TRIB_FCP_AMOUNT> -> SZB->ZB_FCPAMOU
=>  <SUB_TRIB_FCP_BASE>0</SUB_TRIB_FCP_BASE ------> SZB->ZB_FCPBASE

OBSERVACAO: Criar os campos acima mencionados
*/  

//******************************************* Inicio Header ****************************************************//
static function getFCPTOTA()  //ZA_FCPTOTA

	Local nRet := 0
	
	If Type("oXml:_IP_040:_BODY:_FOOTER:_SUB_TRIB_FCP_TOTAL")<>"U"
		nRet := Val(oXml:_IP_040:_BODY:_FOOTER:_SUB_TRIB_FCP_TOTAL:TEXT)
	EndIf
return(nRet)

//******************************************* Fim Header *******************************************************// 

//******************************************* Inicio Itens *******************************************************//
static function getFCPRATE(nItem)

	local xRet := 0
	
	if nItem > 0
		if Type("oXml:_IP_040:_BODY:_FILEITEM["+str(nItem)+"]:_ICMS") <> "U"
			xRet := Val(oXml:_IP_040:_BODY:_FILEITEM[nItem]:_ICMS:_SUB_TRIB_FCP_RATE:TEXT)
		endif
	else
		if Type("oXml:_IP_040:_BODY:_FILEITEM:_ICMS") <> "U"
			xRet := Val(oXml:_IP_040:_BODY:_FILEITEM:_ICMS:_SUB_TRIB_FCP_RATE:TEXT)
		endif
	endif
	
return (xRet)

