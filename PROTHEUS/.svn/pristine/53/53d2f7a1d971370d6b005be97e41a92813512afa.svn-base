#include 'totvs.ch'

/*/{Protheus.doc} DHLAcols

Responsável gerenciar o cliente "Base", o cliente único que vonterá no acols
	
@author Gustavo Luiz
@since 12/08/2016
/*/
user function _dhlAcols;return

CLASS DHLAcols
	
	Data cClienteOficial As String	
	
	METHOD New() CONSTRUCTOR
	Method SetCliOficial()
	Method GetCliOficial()

ENDCLASS

//-----------------------------------------------------------------

/**
* contrutor
**/
METHOD New() CLASS DHLAcols

	::cClienteOficial := ""

Return

/**
* pega o cliente oficial, o que tem que ocorrer para todas as linhas
**/
METHOD GetCliOficial() CLASS DHLAcols
	

Return ::cClienteOficial

/**
* Altera o cliente oficial, o que tem que ocorrer para todas as linhas
**/
METHOD SetCliOficial(cClienteOfic) CLASS DHLAcols

	::cClienteOficial := cClienteOfic

Return