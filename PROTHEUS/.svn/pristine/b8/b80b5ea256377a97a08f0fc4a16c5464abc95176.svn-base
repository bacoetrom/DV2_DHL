#include 'safx.ch'

#DEFINE POS_FIELD 1


/*/{Protheus.doc} DHLSafx08Ag2

Respons‡vel pelas regras e montagem das informacoes para a exportacao
	
@author Thiago Meschiatti
@since 18/07/2017

/*/

user function _08Ag2Safx;return

class DHLSafx08Ag2 from DHLSafx
	
	data  cPrefix  as String
	data  cItem  as String 
	

	method newDHLSafx08Ag2() constructor 
	
	method getSql()
	method getSqlFt()
	method addLine() 
	method getTribIcms(aTypeFlow)
	method getTribIpi(aTax)
	method getAuxTribIcms(aTax)
	method getValorOpIcms(aTax) 
	method getIpiValorOp(aTax) 
	method notFieldRequired()
	
	method setPrefix()
	method getPrefix()
	
	method setItem()
	method getItem()
	
	method getCofins(cField)
	method getPis(cField)

endclass

method setPrefix(cPrefix) class DHLSafx08Ag2
	::cPrefix := cPrefix
return 

method getPrefix() class DHLSafx08Ag2
return ::cPrefix

method setItem(cItem) class DHLSafx08Ag2
	::cItem := cItem
return 

method getItem() class DHLSafx08Ag2
return ::cItem

method newDHLSafx08Ag2() class DHLSafx08Ag2	
	
return

/*/{Protheus.doc} getSql

Instrucao SQL para exportacao
	
@author Daniel Braga
@since 30/10/2014

@return string instrucao sql
/*/
method getSql() class DHLSafx08Ag2


	local cAlias	:= ""
	local cQuery	:= ""
	local cCusSup	:= ::getFieldValue("F3_CLIEFOR")
	local cBranch	:= ::getFieldValue("F3_LOJA")                          
	local cDoc		:= ::getFieldValue("F3_NFISCAL")                            
	local cSer		:= ::getFieldValue("F3_SERIE")                       
	local cType		:= ::getTypeDoc(cDoc, cSer,cCusSup,cBranch)                                                       
	                                            
	cAlias := Iif(cType == "1" ,"SD1" ,"SD2" )
	::cPrefix:= PrefixoCpo(cAlias)
	
	cQuery :=  "select * from "+retSqlName(cAlias)+" where "
	cQuery	+=  ::cPrefix+"_filial= '"+xFilial(cAlias)+"' and "
	cQuery +=  ::cPrefix+"_doc		='"+cDoc+"' and "
	cQuery +=  ::cPrefix+"_serie 	='"+cSer+"' and "
	cQuery +=  ::cPrefix+"_"+Iif(cType == "1" ,"fornece" ,"cliente" )+" = '"+cCusSup+"' and  "
	cQuery +=  ::cPrefix+"_loja = '"+cBranch+"' and "
	cQuery +=  "d_e_l_e_t_= ' ' "
	 
return Upper(cQuery)

/*/{Protheus.doc} getSqlFt

Instrucao SQL para exportacao
	
@author Daniel Braga
@since 30/10/2014

@return string instrucao sql
/*/
method getSqlFt() class DHLSafx08Ag2


	local cAlias	:= ""
	local cQuery	:= ""
	local cCusSup	:= (cSF3_)->(F3_CLIEFOR)
	local cBranch	:= (cSF3_)->(F3_LOJA)                          
	local cDoc		:= (cSF3_)->(F3_NFISCAL)                            
	local cSer		:= (cSF3_)->(F3_SERIE)                       
	local cType		:= ::getTypeDoc(cDoc, cSer,cCusSup,cBranch)                                                       
	                                            
	cAlias := "SFT"
	::cPrefix:= PrefixoCpo(cAlias)
	
	cQuery :=  "select * from "+retSqlName(cAlias)+" where "
	cQuery	+=  ::cPrefix+"_filial= '"+xFilial(cAlias)+"' and "
	cQuery +=  ::cPrefix+"_nfiscal	= '"+cDoc+"' and "
	cQuery +=  ::cPrefix+"_serie 	= '"+cSer+"' and "
	cQuery +=  ::cPrefix+"_cliefor  = '"+cCusSup+"' and  "
	cQuery +=  ::cPrefix+"_loja 	= '"+cBranch+"' and "
	cQuery +=  "d_e_l_e_t_= ' ' "
	cQuery +=  "order by " + ::cPrefix + "_nfiscal, " + ::cPrefix + "_serie, " + ::cPrefix + "_item"
	 
return Upper(cQuery)

/*/{Protheus.doc} addLine

Cria a lina ‡ ser impressa no arquivo txt
	
@author Daniel Braga
@since 30/10/2014

/*/
method addLine(cItenOri, cId , xobj ) class DHLSafx08Ag2
	
	
	local aTax		   	:= {}
	local aInOutFlows  	:= {}
	local aItFlow	   	:= {}
	local aDocImp	   	:= {}
	local aTypeFlow	   	:= {}
	local aElectrPower	:= {}
	local aProduct		:= {}
	local aSupCus		:= {}
	local aUFTaxes		:= {}
	local aImpFCP		:= {}
	local cType			:= ""
	local cCod		   	:= "" 
	local cBranch	   	:= ""
	local cDoc			:= ""
	local cSer			:= ""	
	local cItem			:= ""
	local lFormatZero	:= .f.
	local xdummy
	local xarray 		:= {}
	local npos			:= 0
	local nVFCPIcm		:= 0
	local nVFCPSt		:= 0
	local cCBENEF		:= ""
	local nICMDeson		:= 0
	
	if !empty(::aFields)
	
		cCod 		:= (cSF3_)->(F3_CLIEFOR)
		cBranch 	:= (cSF3_)->(F3_LOJA)
		cDoc		:= (cSF3_)->(F3_NFISCAL)
		cSer    	:= (cSF3_)->(F3_SERIE)
		cItem 		:= (cSFT_)->FT_ITEM //::getFieldValue(::cPrefix+"_ITEM")
		cType		:= (cSF3_)->ENT_sai //::getTypeDoc(cDoc, cSer, cCod, cBranch) 
		
		cIndFisJur	:= Iif( cType =="1",Iif((cSF3_)->(F3_TIPO) $ "DB" ,"2","1" ) , Iif(!(cSF3_)->(F3_TIPO) $ "DB" ,"2","1" )      )
		
		IF lEN( _uftaxes ) = 1
			aUFTAXES := ACLONE( _uftaxes[1] )
		else
			npos := ascan( _UfTaxes , {|Z| Z[4] = cItem } )
			if npos > 0
				aUFTAXES := ACLONE( _uftaxes[npos] )
			else
				//aUFTAXES := ACLONE( _uftaxes[ len(_aUfTaxes) ] ) 
				aUFTAXES := ACLONE( _uftaxes[ len(_UfTaxes) ] ) //Emerson Holanda 27/05/2021 - Correção do erro de variavel invalida _aUfTaxes
			endif
		ENDIF

		aImpFCP := ::getUfTaxes(cType, (cSF3_)->(F3_TIPO), cSer, cDoc, cCod, cBranch, cItem , .f. /*default e .f. todos */ , .t. /* para o retorno ser conforme dados abaixo icm e sol */)
		
		If Len(aImpFCP) > 0
			If aImpFCP[1,1] == "ICM"
				nVFCPIcm := aImpFCP[1,2]
			Elseif aImpFCP[1,1] == "SOL"
				nVFCPSt	 := aImpFCP[1,2]
			EndIf
		EndIf

		::addField(COD_EMPRESA			, alltrim(GetNewPar("ZZ_IDEMPDW", "SOL")))
	    ::addField(COD_ESTAB			, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp())))
	    ::addField(DATA_FISCAL			, IIf(cType == "1",(cSF3_)->(F3_ENTRADA), (cSF3_)->(F3_EMISSAO)))
	    ::addField(MOVTO_E_S			, iif(cType =="1", SAFX_DOCUMENTO_ENTRADA, SAFX_DOCUMENTO_SAIDA))
	    ::addField(NORM_DEV				, (cSF3_)->TIPO ) //::getFieldValue("TIPO") )
	    ::addField(COD_DOCTO			, "NFE")
	    ::addField(IND_FIS_JUR			, (cSF3_)->ZZINDDW ) //Iif(cIndFisJur == "1",::getFieldValue("A2_ZZINDDW",aSupCus), ::getFieldValue("A1_ZZINDDW",aSupCus)))
	    ::addField(COD_FIS_JUR			, alltrim(GetNewPar("ZZ_CDEMPDW", FwCodEmp()))+cCod+cBranch)
	    ::addField(NUM_DOCFIS			, (cSF3_)->(F3_NFISCAL) )
	    ::addField(SERIE_DOCFIS			, (cSF3_)->(F3_SERIE) )
	    ::addField(IND_BEM_PATR			, "N")
	    ::addField(IND_PRODUTO			, ::getProdType((csft_)->b1_tipo ) ) //::getProdType(::getFieldValue("B1_TIPO",aProduct)) )
	    ::addField(COD_PRODUTO			, (cSFT_)->FT_PRODUTO) //::getFieldValue(::cPrefix+"_PRODUTO"))
		::addField(COD_UND_PADRAO		, iif((cType == "1" .and. (csft_)->F1_FORMUL == "S") .or. (cType == "2"),;
										  unidadeMedida(COD_UND_PADRAO[POS_FIELD], cType, aItFlow, self, xobj),;
										  (cSFT_)->B1_UM /*::getFieldValue("B1_UM", aProduct) */ ))
//		::addField(NUM_ITEM				, iif(cType == "1",alltrim(padl(::getItem(),tamsx3("D1_ITEM")[1],'0')),alltrim(cItem))) //iif(DecodSoma1(::getFieldValue(::cPrefix+"_ITEM")) > 99, cValToChar(DecodSoma1(AllTrim(::getFieldValue(::cPrefix+"_ITEM")))), ::getFieldValue(::cPrefix+"_ITEM")))
	    ::addField(NUM_ITEM				, iif(cType == "1", alltrim(padl(::getItem(),tamsx3("D1_ITEM")[1],'0')),;
										  iif ((DecodSoma1(cItem) > 99), AllTrim(cValToChar(DecodSoma1(AllTrim(cItem)))), AllTrim(cItem))))
	    ::addField(COD_ALMOX			, (cSFT_)->B1_LOCPAD)// ", aProduct))
	    ::addField(COD_CUSTO			, Iif(cType == "1", (cSFT_)->D1_CC , (csft_)->D2_CCUSTO )) //Iif(cType == "1", ::getFieldValue("D1_CC", aItFlow) ,::getFieldValue("D2_CCUSTO", aItFlow) ) )
	    ::addField(COD_CFO				, (cSFT_)->FT_CFOP) //:::getFieldValue(::cPrefix+"_CFOP"))


	    ::addField(COD_NATUREZA_OP		, iif(cType == '1' .and. (CSFT_)->F4_BASEICM > 0 , (csft_)->D1_ZZTES , (cSFT_)->FT_NATOPER)) //::getFieldValue(::cPrefix+"_NATOPER")
	    
	    ::addField(QUANTIDADE			, iif((cType == "1" .and. (cSFT_)->F1_FORMUL == "S") .or. (cType == "2"),;
	    								  unidadeMedida(QUANTIDADE[POS_FIELD], cType, aItFlow, self , xobj ),;
	    								  (cSFT_)->FT_QUANT /*::getFieldValue(::cPrefix+"_QUANT") */ ))
		::addField(COD_MEDIDA			, iif((cType == "1" .and. (cSFT_)->F1_FORMUL == "S") .or. (cType == "2"),;
										  unidadeMedida(COD_MEDIDA[POS_FIELD], cType, aItFlow, self , xobj ),;
										  (csft_)->b1_um /* ::getFieldValue("B1_UM", aProduct)*/ ))
	    ::addField(COD_NBM				, (csft_)->b1_posipi) // ::getFieldValue("B1_POSIPI",aProduct) )
		If (cType == "1" .and. (cSFT_)->F1_FORMUL == "S") .or. (cType == "2")
			::addField(VLR_UNIT				, unidadeMedida(VLR_UNIT[POS_FIELD], cType, aItFlow, self ,xobj ))
		Else
			::addField(VLR_UNIT				, (cSFT_)->FT_PRCUNIT) //::getFieldValue(::cPrefix+"_PRCUNIT") 
		EndIf
	    ::addField(VLR_ITEM				, (cSFT_)->FT_TOTAL) // ::getFieldValue(::cPrefix+"_TOTAL"))
		
		// Inicio - ICMS Desonerado 
		If (cType == "2")
			If cFilAnt == AG2_SCJ
				::addField(VLR_ITEM				, (cSFT_)->FT_TOTAL + (cSFT_)->FT_DESCZFR) // ::getFieldValue(::cPrefix+"_TOTAL"))
			Else
				::addField(VLR_ITEM				, (cSFT_)->FT_TOTAL) // ::getFieldValue(::cPrefix+"_TOTAL"))
			EndIf
		Else
			::addField(VLR_ITEM				, (cSFT_)->FT_TOTAL) // ::getFieldValue(::cPrefix+"_TOTAL"))
		EndIf
		// Fim - ICMS Desonerado 
				    
		// Inicio - ICMS Desonerado
		If (cType == "1" .and. (cSFT_)->F1_FORMUL == "S")
			If cFilAnt == AG2_SCJ
				::addField(VLR_DESCONTO			, (cSFT_)->FT_DESCONT - (cSFT_)->(FT_DESCZFR)) // ::getFieldValue(::cPrefix+"_DESCONT"))
			Else
				::addField(VLR_DESCONTO			, (cSFT_)->FT_DESCONT) // ::getFieldValue(::cPrefix+"_DESCONT"))
			EndIf
		Else
			::addField(VLR_DESCONTO			, (cSFT_)->FT_DESCONT) // ::getFieldValue(::cPrefix+"_DESCONT"))
		EndIf
		// Fim - ICMS Desonerado
		
		::addField(COD_SITUACAO_A		, left((cSFT_)->FT_CLASFIS,1)) // left(::getFieldValue(::cPrefix+"_CLASFIS"),1))
	    ::addField(COD_SITUACAO_B		, substr((cSFT_)->FT_CLASFIS,2,2)) // substr(::getFieldValue(::cPrefix+"_CLASFIS"),2,2))
	    ::addField(IND_IPI_INCLUSO		, Iif((csft_)->F4_INCIDE == 'S' , 'S', 'N'))
	    ::addField(NUM_ROMANEIO			, Iif(cType =="2" ,(cSFT_)->D2_CODROM,"" ))  //Iif(cType =="2" ,::getFieldValue("D2_CODROM", aItFlow),"" )) 
	    ::addField(DATA_ROMANEIO		, Iif(cType =="2" ,posicione("NPR",1,xFilial("NPR")+(cSFT_)->D2_CODROM,"NPR_DATA"),"" ))
	    ::addField(PESO_LIQUIDO			, (cSFT_)->FT_PESO)
	    ::addField(VLR_FRETE			, (cSFT_)->FT_FRETE)
	    ::addField(VLR_SEGURO			, (cSFT_)->FT_SEGURO)
	    ::addField(VLR_OUTRAS			, (cSFT_)->FT_DESPESA)
	    
	    ::addField(VLR_ALIQ_ICMS		, Iif((cSFT_)->FT_ALIQICM > 0, (cSFT_)->FT_ALIQICM,; 
	    								  Iif(::getTribIcms(aTypeFlow)== '1' .and. cType =="2" .and. (csft_)->f4_BASEICM > 0,  (csft_)->D2_PICM, ' ')))
	    
	    ::addField(VLR_ICMS				, (csft_)->ft_VALICM , lFormatZero)
	    ::addField(DIF_ALIQ_ICMS		, Iif(cType == "1",((csft_)->ft_ICMSCOM/(csft_)->ft_BASEICM)/100, 0  ))
	    ::addField(VLR_ALIQ_IPI			, (csft_)->FT_ALIQIPI ) //jj(cSFT_)->FT_ALIPIPI") )
	    ::addField(VLR_IPI				, (cSF3_)->(F3_VALIPI) )
	    ::addField(VLR_ALIQ_SUB_ICMS	, iif(((FWUnitBusiness() == DHL_BUSINESSUNIT_PKG) .or. (FWUnitBusiness() == DHL_BUSINESSUNIT_SPL)) , ' ',(csft_)->FT_ALIQSOL))
	    ::addField(VLR_SUBST_ICMS		, iif(((FWUnitBusiness() == DHL_BUSINESSUNIT_PKG) .or. (FWUnitBusiness() == DHL_BUSINESSUNIT_SPL)) , ' ',(csft_)->fT_ICMSRET))
	    ::addField(TRIB_ICMS			, ::getTribIcms(aTypeFlow)) 

		// Inicio - ICMS Desonerado
		If cFilAnt == AG2_SCJ .and. isRCODeson(IIf(cType == "1",(csft_)->ft_NFORI+';'+(csft_)->ft_SERORI+';'+(csft_)->ft_ITEMORI,(csft_)->ft_NFISCAL+';'+(csft_)->ft_SERIE+';'+(csft_)->ft_ITEM))
			//nBase_ := (csft_)->ft_BSICMOR - (csft_)->ft_ICMSRET - (csft_)->ft_DESCZFR
			nBase_ := (csft_)->	ft_VALCONT  - (csft_)->ft_ICMSRET - (csft_)->ft_DESCZFR //Emerson Holanda 11/09/2023
		Else
			if cType == "1" .and. (CSFT_)->F4_BASEICM > 0 .and. ::getTribIcms(aTypeFlow)== '1'
				nBase_ := (csft_)->ft_BASEICM 
			else
				If ::getTribIcms(aTypeFlow) == '1' .and. (CSFT_)->F4_BASEICM > 0
					nBase_ := (csft_)->ft_OUTRICM
				ElseIf ::getTribIcms(aTypeFlow)== '1'
					nBase_ := (csft_)->ft_BASEICM
				ElseIf ::getTribIcms(aTypeFlow)== '2'
					nBase_ := (csft_)->ft_ISENICM	
				Else
					nBase_ := (csft_)->ft_OUTRICM 	
				EndIf
			endif
		EndIf
	    ::addField(BASE_ICMS			, nBase_ )
		// Fim - ICMS Desonerado

		if cType == "1" .and. (csft_)->F4_BASEICM <> 0 .and. ::getTribIcms(aTypeFlow)== '1'
			nBase_ := (csft_)->ft_VALCONT - (csft_)->ft_BASEICM
		else
			nBase_ := Iif((csft_)->F4_BASEICM <> 0,(csft_)->ft_ISENICM , 0 )
		endif

	    ::addField(BASE_REDU_ICMS		, nBase_ )

	    ::addField(TRIB_IPI				, ::getTribIpi(aTax))
	    ::addField(BASE_IPI				, iif(::getTribIpi(aTax)== '1', (csft_)->ft_BASEIPI, iif(::getTribIpi(aTax)== '2', (csft_)->ft_ISENIPI, (csft_)->ft_OUTRIPI)))
	    ::addField(BASE_REDU_IPI		, Iif((csft_)->f4_BASEIPI <> 0,(cSF3_)->(F3_BASEIPI), 0 ))
	    ::addField(BASE_SUB_TRIB_ICMS 	, (csft_)->ft_BASERET)
	    ::addField(VLR_CONTAB_ITEM		, (csft_)->ft_VALCONT)		
		::addField(VLR_OUTROS_IPI		, ' ' ) //jj campo errado . ver no fonte original . obj colocava possivelmente vazio se campo nao existia (cSFT_)->FT_IPIOBS)		    
	    ::addField(VLR_OUTROS1			, Iif(cType == "1" , (csft_)->ft_ICMSCOM,"")) 
	    ::addField(VLR_TOM_SERVICO		, (csft_)->ft_FRETE)   
	    ::addField(VLR_IPI_NDESTAC		, (csft_)->ft_ALIQIPI) 
	    ::addField(TRIB_ICMS_AUX		, ' ') 
	    ::addField(BASE_ICMS_AUX		, ' ') 
 	    ::addField(TRIB_IPI_AUX			, ' ') 
	    ::addField(BASE_IPI_AUX			, ' ')  
 	    ::addField(VLR_BASE_PIS			, ::getPis(VLR_BASE_PIS[POS_FIELD], xobj )  ) 
	    ::addField(VLR_PIS				, ::getPis(VLR_PIS[POS_FIELD], xobj ) )	
	    ::addField(VLR_BASE_COFINS		, ::getCofins(VLR_BASE_COFINS[POS_FIELD] , xobj ) )
	    ::addField(VLR_COFINS			, ::getCofins(VLR_COFINS[POS_FIELD], xobj))	    
	    ::addField(VLR_CUSTO_TRANSF		, ' ') 
	    ::addField(DAT_DI				, ::getFieldValue("CD5_DTDI", aDocImp))
	    ::addField(NUM_DEC_IMP_REF		, ::getFieldValue("CD5_DOCIMP", aDocImp))
	    ::addField(COD_CONTA			, (csft_)->ft_CONTA) 	    
	    ::addField(IND_MOV_FIS			, (csft_)->ft_ESTOQUE)
	    ::addField(NUM_DOCFIS_REF		, (csft_)->ft_NFORI)
	    ::addField(SERIE_DOCFIS_REF		, (csft_)->ft_SERORI)
	    ::addField(VLR_BASE_PIS_ST		, (cSF3_)->(F3_BASEPS3) )
	    ::addField(VLR_ALIQ_PIS_ST		, ' ' ) // campo nao existe na querie (cSF3_)->(F3_ALIQPS3) )
	    ::addField(VLR_PIS_ST			, (cSF3_)->(F3_VALPS3 )  )
	    ::addField(VLR_BASE_COFINS_ST	, (cSF3_)->(F3_BASECF3) )
	    ::addField(VLR_ALIQ_COFINS_ST	, '' ) // campo nao existe na querie (cSF3_)->(F3_ALIQCF3) ) 
	    ::addField(VLR_COFINS_ST		, (cSF3_)->(F3_VALCF3 ) )
	    ::addField(VLR_BASE_CSLL		, iif(cType =="1", ::getFieldValue("F1_BASCSLL", aInOutFlows) , ::getFieldValue("F2_BASCSLL", aInOutFlows)))
	    ::addField(VLR_ALIQ_CSLL		, (csft_)->ft_ALIQCSL)
	    ::addField(VLR_CSLL				, iif(cType =="1", ::getFieldValue("F1_VALCSLL", aInOutFlows) , ::getFieldValue("F2_VALCSLL", aInOutFlows)))
	    ::addField(VLR_ALIQ_PIS			, ::getPis(VLR_ALIQ_PIS[POS_FIELD], xobj )) 
	    ::addField(VLR_ALIQ_COFINS		, ::getCofins(VLR_ALIQ_COFINS[POS_FIELD], xobj))        
	    ::addField(VLR_FECP_ICMS		, Iif((csft_)->ft_VALFECP > 0,(csft_)->ft_VALFECP, nVFCPIcm))//CD2 - ICM
	    ::addField(VLR_FECP_ICMS_ST		, Iif((csft_)->(ft_VFECPST + ft_VFESTRN + ft_VFESTMG + ft_VFESTMT) > 0, (csft_)->(ft_VFECPST + ft_VFESTRN + ft_VFESTMG + ft_VFESTMT),  nVFCPSt )) //CD2 - SOL
	    ::addField(COD_TRIB_IPI			, (csft_)->ft_CTIPI)
	    ::addField(COD_EX_NCM			, substr( (csft_)->b1_ex_ncm /*  ::getFieldValue("B1_EX_NCM", aProduct)*/,1,2))
	    ::addField(COD_EX_IMP			, substr((csft_)->b1_ex_nbm  /* campo estava errado ::getFieldValue("B1_EXNBM", aProduct)*/,1,2))    
	    ::addField(IND_ESPECIF_RECEITA	, ' ' ) //::getFieldValue("FU_TIPOREC",aElectrPower))
	    ::addField(COD_SITUACAO_PIS		, (csft_)->ft_CSTPIS)
		::addField(QTD_BASE_PIS			, ' ')
		::addField(VLR_ALIQ_PIS_R		, ' ')   
		::addField(COD_SITUACAO_COFINS	, (csft_)->ft_CSTCOF)
		::addField(QTD_BASE_COFINS		, ' ')
		::addField(VLR_ALIQ_COFINS_R	, ' ')   
	    ::addField(ITEM_PORT_TARE		, supergetmv("MV_ITTARE")) //::getFieldValue("MV_ITTARE"))
	    ::addField(VLR_FUNRURAL			, Iif(cType =="1",  (csft_)->D1_VALFUN , (csft_)->D2_VALFUN ))	   //::getFieldValue("D1_VALFUN", aItFlow), ::getFieldValue("D2_VALFUN", aItFlow)))	   
		::addField(VLR_PIS_TRIB			, Iif((csft_)->ft_CSTPIS $ "50" ,(csft_)->ft_VALPIS,0)  ) 
	    ::addField(VLR_PIS_EXP			, Iif((csft_)->ft_CSTPIS $ "52" ,(csft_)->ft_VALPIS,0)  ) 
		::addField(VLR_PIS_N_TRIB		, Iif((csft_)->ft_CSTPIS $ "51" ,(csft_)->ft_VALPIS,0)  )     
		::addField(VLR_COFINS_EXP		, Iif((csft_)->ft_CSTPIS $ "52" ,(csft_)->ft_VALPIS,0)  )     
		::addField(VLR_COFINS_TRIB		, Iif((csft_)->ft_CSTPIS $ "50" ,(csft_)->ft_VALPIS,0)  ) 
		::addField(VLR_COFINS_N_TRIB	, Iif((csft_)->ft_CSTPIS $ "51" ,(csft_)->ft_VALPIS,0)  )     
	    ::addField(DAT_LANC_PIS_COFINS	, (cSF3_)->(F3_ENTRADA))
	    ::addField(IND_NATUREZA_FRETE	, (csft_)->ft_INDNTFR)
	    ::addField(COD_NAT_REC			, (csft_)->ft_TNATREC)
	    ::addField(IND_NAT_BASE_CRED	, (csft_)->ft_CODBCC)
	    ::addField(VLR_ACRESCIMO 		, Iif(cType =="1", (csft_)->D1_VALACRS , (csft_)->D2_VALACRS )) //Iif(cType =="1", ::getFieldValue("D1_VALACRS", aItFlow), ::getFieldValue("D2_VALACRS", aItFlow)))
	    ::addField(IND_IPI_NDESTAC_DF	, (csft_)->f4_DESTACA)
	    ::addField(VLR_FCP_UF_DEST		, aUFTaxes[VLR_FCP])
		::addField(VLR_ICMS_UF_DEST		, aUFTaxes[VLR_ICMS_DEST])
		::addField(VLR_ICMS_UF_ORIG		, aUFTaxes[VLR_ICMS_ORIG])
		
		if cType == "2"
			cCBENEF 	:= getCodCBENEF(cType,cSF3_, cSFT_)
			nICMDeson	:= getICMDeson (cType,cSF3_, cSFT_)
		endIf

		::addField(COD_BENEFICIO			,  cCBENEF)

		//Inicio - ICMS Desonerado
		//::addField(VLR_ABAT_NTRIBUTADO		,  nICMDeson)
		::addField(VLR_ABAT_NTRIBUTADO		,  nICMDeson + IIf(cFilAnt == AG2_SCJ, (cSFT_)->FT_DESCZFR,0))
		//Fim - ICMS Desonarado

	   	::setItem(soma1(cItem))
	   	
	   	::notFieldRequired()
	endIf

return 

