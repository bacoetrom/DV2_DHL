#Include 'Totvs.ch'
#Include 'protheus.ch'
#Include 'DHL.ch'

#Define GETF_ONLYSERVER 1

/*/{Protheus.doc} AglImpXML
		@author 	iVan de Oliveira - TotvsIP
		@version 	2.0
		@since 		24-06-2021
/*/
******************************************************************************************************************
User Function AglImpXML(cParam1,cParam2)
	******************************************************************************************************************
	Local  oEnv 	   := IpEnvironmentObject():newIpEnvironmentObject()
	Local _CXML		:= ""
	Local cArquivo	:= ""
	Local cDirectory:= ""
	Local cCFLocacao:= ""
	Local cCFComod  := ""
	local _nI		:= 0

	default cParam1 := "10"
	default cParam2 := "A82AGL008271"
/*
	cParam1:= "10"
	cParam2 := "A82AGL008271"
*/
	Private lJob := !(oEnv:hasMainWindow())

	If lJob
		RPCSetEnv(cParam1,cParam2)
	EndIf

	Private cUnidade   := Alltrim(GetMv("ZZ_CNPJAG"))
	private oSql       := ipSqlObject():newIpSqlObject()
	private lVldEstr   := SuperGetMV("ZZ_VLDESTR",,.F.)
	If lJob
		Private cFolder    := getFolder()
		private oFolder    := DHLDirectoryManager():newDHLDirectoryManager("")
		private oLogImp     := DHLLogManager():newDHLLogManager()
		private oLog	   := DHLLogManager():newDHLLogManager()
		private oEnv 	   := IpEnvironmentObject():newIpEnvironmentObject()
		private oUtils     := IpUtilsObject():newIpUtilsObject()
		private aCompanies := loadCompanies()
		private cLayout    := ""
		private oXml       := nil
		private aFiles     := {}
		private lError     := .F.
	EndIf

	If lJob
		oFolder:setDirectory(cFolder)
		aFiles := oFolder:getFiles()

		FWLogMsg("INFO", , "BusinessObject", funName(), "", "01", "Entrou no JOB", 0, 0, {})
		FWLogMsg("INFO", "LAST", "BusinessObject", funName(), "", "01", "Carregou a empresa " + cEmpAnt + "/" + cFilAnt, 0, 0, {})

		cCFLocacao	:= Alltrim(GetMv("ZZ_CFLOCAG")) //--- CFOP Locacao AGE
		cCFComod	    := Alltrim(GetMv("ZZ_CFCOMAG")) //--- CFOP Comodato AGE

		For _nI := 1 to Len(aFiles)

			// Verificando se o CNPJ é referente MAHLE METAL LEVE S.A.
			_CXML         := aFiles[_nI]
			oXMLUtil		:= ipXmlObject():newIpXmlObject(_CXML)
			//RONI SILVA 		oXMLUtil:doParse()
			oXMLUtil:doParseFile(_cXML)
			if getCnpj(oXMLUtil)

				cDirectory	:= Substr(_CXML,1,Rat("\",_CXML))
				cArquivo	    := Substr(_CXML,Rat("\",_CXML)+1,Len(_CXML))
				cFile         := cArquivo

				GravaHist(_CXML, cDirectory, cArquivo, cCFLocacao, cCFComod)

			Endif

		Next _nI

		FWLogMsg("INFO", "LAST", "BusinessObject", funName(), "", "01", "Processamento concluído!", 0, 0, {})

		RPCClearEnv()
	Else
		If Alltrim(SM0->M0_CGC) == cUnidade

			Tela(@_cXML, @cDirectory, @cArquivo, @cCFLocacao, @cCFComod)

			If !Empty(_cXML) .and. !Empty(cDirectory) .and. !Empty(cArquivo) .and. !Empty(cCFLocacao) .and. !Empty(cCFComod)

				Processa({|| GravaHist(_cXML, cDirectory, cArquivo, cCFLocacao, cCFComod) },"Processando...")

				u_AglImpXML()

			Endif

		Else
			Aviso("CNPJ "+cUnidade,"Rotina específica para filiais de Armazém Geral,",{"OK"})
		Endif
	EndIf

Return Nil

	******************************************************************************************************************
Static Function GravaHist(_CXML, cDirectory, cArquivo, cCFLocacao, cCFComod)
	******************************************************************************************************************
	Local oLog 		:= Nil
	Local cError	:= ""
	Local aPedido	:= {}
	Private oImpNfe	:= Nil
	Private aLogAuto:= {}
	Private lDepositante	:= .f.

	If lJob
		oLog := DHLLogManager():newDHLLogManager()
		oDir := DHLDirectoryManager():newDHLDirectoryManager(cDirectory)

		If oDir:startProcess(_CXML)
			oLog:start(APP_IMPORTADOR_XML, DHL_IMPORTACAO, _CXML)
			OpenSm0()
			oImpNfe	:= TImpNfe():new(cDirectory, cArquivo+".processing", .T.)
			SM0->(dbCloseArea())
			IF LEN(oImpNfe:aCab) > 0
				oLog:success(_CXML)
				oDir:setProcessed(_CXML)
				aPedido:= GrvDados(oImpNfe, cCFLocacao, cCFComod)
				If Len(aPedido) > 0
					geraPedido(1,aPedido,Nil)
				Endif
			else
				setFileLog(" ","fail",funname() + " [Erro ao processar xml de terceiro]")
				oDir:setError(_CXML)
			endif
		Endif
	Else
		ProcRegua(1)

		IncProc()

		oLog := DHLLogManager():newDHLLogManager()
		oDir := DHLDirectoryManager():newDHLDirectoryManager(cDirectory)

		If oDir:startProcess(_CXML)
			oLog:start(APP_IMPORTADOR_XML, DHL_IMPORTACAO, _CXML)
			oImpNfe	:= TImpNfe():new(cDirectory, cArquivo+".processing", .T.)
			IF LEN(oImpNfe:aCab) > 0
				oLog:success(_CXML)
				oDir:setProcessed(_CXML)
				aPedido := GrvDados(oImpNfe, cCFLocacao, cCFComod)
				If Len(aPedido) > 0
					geraPedido(1,aPedido,Nil)
				Endif
			endif
		Endif
	EndIf


Return Nil

	******************************************************************************************************************
Static Function retError(aLogAuto)
	******************************************************************************************************************
	Local cError := ""
	Local nI	 := 0

	For nI:=1 To Len(aLogAuto)
		If Substr(aLogAuto[nI],1,1) $ "A|E|"
			cError += aLogAuto[nI] +CRLF
		Endif
	Next nI

Return (cError)

	******************************************************************************************************************
Static Function GrvDados(oImpNfe, cCFLocacao, cCFComod)
	******************************************************************************************************************
	Local aRetorno 		:= {}
	Local aItens		:= {}
	Local cCliFor		:= ""
	Local cLoja			:= ""
	Local nCont			:= 0
	Local aCliEx    	:= {}
	Local _cNumFornec	:=''

	If lVldEstr .and. TYPE("oImpNfe:Dest:_CNPJ:Text") == "U"
		If TYPE("oImpNfe:Dest:_idEstrangeiro:Text") != "U"
			If oImpNfe:Dest:_idEstrangeiro:Text != ""
				aCliEx := getCliEx(oImpNfe:Dest:_idEstrangeiro:Text)
				If len(aCliEx) > 0
					cCliFor  := aCliEx[1]
					cLoja    := aCliEx[2]
				Else
					If lJob
						_cFunName := "AglImpXML"
						_cMsg     := "Não foi possível identificar o codigo de cliente com ID Estrangeiro:: " + oImpNfe:Dest:_idEstrangeiro:Text
						_cDoc1    := oImpNfe:Dest:_idEstrangeiro:Text
						_cDoc2    := ""
						_cDoc3    := ""
						_cCodMsg  := "01"
						setFileLog(" ","fail",_cMsg)

						FWLogMsg("WARN", "LAST", "BusinessObject", funName(), "", "01", "Não foi possível identificar o codigo de cliente com ID Estrangeiro: " + oImpNfe:Dest:_idEstrangeiro:Text, 0, 0, {})
					Else
						MsgAlert("Não foi possível identificar o codigo de cliente com ID Estrangeiro: " + oImpNfe:Dest:_idEstrangeiro:Text)
					EndIf
					Return aRetorno
				EndIf
			Else
				If lJob
					_cFunName := "AglImpXML"
					_cMsg     := "Tag IdEstrangeiro no XML está vazia.: " + oImpNfe:Dest:_idEstrangeiro:Text
					_cDoc1    := oImpNfe:Dest:_idEstrangeiro:Text
					_cDoc2    := ""
					_cDoc3    := ""
					_cCodMsg  := "02"
					setFileLog(" ","fail",_cMsg)

					FWLogMsg("WARN", "LAST", "BusinessObject", funName(), "", "01", "Tag IdEstrangeiro no XML está vazia.", 0, 0, {})
					Return aRetorno
				Else
					MsgAlert("Tag IdEstrangeiro no XML está vazia.")

					If(__cUserID $ cUser)
						aCodLoja := oDHLLibrary:showChangeCliFor()
						cCliFor  := aCodLoja[1]
						cLoja    := aCodLoja[2]
					Else
						Return aRetorno
					EndIf
				EndIf
			EndIf
		Else
			If lJob
				_cFunName := "AglImpXML"
				_cMsg     := "Tag IdEstrangeiro no XML inexistente."
				_cDoc1    := cFile
				_cDoc2    := ""
				_cDoc3    := ""
				_cCodMsg  := "03"
				setFileLog(" ","fail",_cMsg)

				FWLogMsg("WARN", "LAST", "BusinessObject", funName(), "", "01", "Tag IdEstrangeiro no XML inexistente.", 0, 0, {})
				Return aRetorno
			Else
				MsgAlert("Tag IdEstrangeiro no XML inexistente.")

				If(__cUserID $ cUser)
					aCodLoja := oDHLLibrary:showChangeCliFor()
					cCliFor  := aCodLoja[1]
					cLoja    := aCodLoja[2]
				Else
					Return aRetorno
				EndIf
			EndIf
		EndIf
	Else
		//--- Destinatário:
		If lJob
			If TYPE("oImpNfe:Dest:_CNPJ:Text") != "U"
				SA1->(dbSetOrder(3))
				If SA1->(dbSeek( xFilial("SA1") + Padr(oImpNfe:Dest:_CNPJ:Text,Len(SA1->A1_CGC)) ))
					cCliFor  := SA1->A1_COD
					cLoja    := SA1->A1_LOJA
				Else
					cCliFor  := oImpNfe:aCab[03,2]
					cLoja    := oImpNfe:aCab[04,2]
				Endif
			Else
				_cFunName := "AglImpXML"
				_cMsg     := "Não foi possível identificar a tag CNPJ do Destinatário."
				_cDoc1    := cFile
				_cDoc2    := ""
				_cDoc3    := ""
				_cCodMsg  := "04"
				setFileLog(" ","fail",_cMsg)

				FWLogMsg("WARN", "LAST", "BusinessObject", funName(), "", "01", "Não foi possível identificar a tag CNPJ do Destinatário.", 0, 0, {})
				return aRetorno
			EndIf
		Else
			If TYPE("oImpNfe:Dest:_CNPJ:Text") != "U"
				SA1->(dbSetOrder(3))
				If SA1->(dbSeek( xFilial("SA1") + Padr(oImpNfe:Dest:_CNPJ:Text,Len(SA1->A1_CGC)) ))
					cCliFor  := SA1->A1_COD
					cLoja    := SA1->A1_LOJA
				Else
					msgalert("Destinatário não encontrado! Verifique o cadastro de CLIENTES.")
					return aRetorno
				Endif
			Else
				msgalert("Não foi possível identificar a tag CNPJ do Destinatário.")
				return aRetorno
			EndIf
		EndIf

	EndIf

	SZ8->(dbSetOrder(1))
	If !SZ8->(dbSeek( xFilial("SZ8") + oImpNfe:aCab[01,2] + oImpNfe:aCab[02,2] + cCliFor + cLoja ))

		aItens := oImpNfe:aItens //--- Vetor contendo os itens da nota fiscal

		//--- Cabecalho:
		RecLock("SZ8",.T.)
		SZ8->Z8_FILIAL	:= xFilial("SZ8")
		SZ8->Z8_DOC 	:= oImpNfe:aCab[01,2]
		SZ8->Z8_SERIE   := oImpNfe:aCab[02,2]

		SZ8->Z8_CLIENTE := cCliFor
		SZ8->Z8_LOJA    := cLoja

		SZ8->Z8_EMISSAO := oImpNfe:aCab[05,2] // oImpNfe:aCab[8,2]
		SZ8->Z8_EST		:= oImpNfe:aCab[06,2]
		SZ8->Z8_TIPO	:= oImpNfe:aCab[07,2]
		SZ8->Z8_ESPECIE	:= oImpNfe:aCab[09,2]
		SZ8->Z8_CHVNFE	:= oImpNfe:aCab[10,2]
		SZ8->Z8_TPNF   	:= If(aItens[1,ascan(aItens[1], {|x| x[1] == "D1_ZZCFOP"}),2] $ cCFLocacao,"L","C") //--- Locacal ou Comodato
		SZ8->Z8_USUARIO	:= cUserName
		//Emerson Holanda 21/09/23-- Inclusao de data e hora de importação
		If SZ8->(FieldPos("Z8_DTINCLU")) >0
			SZ8->Z8_DTINCLU	:= dDataBase
		EndIf
		If SZ8->(FieldPos("Z8_HRINCLU")) >0
			SZ8->Z8_HRINCLU	:= Time()
		EndIf

		_cTmp := upper(oImpNfe:infadic:_infcpl:text)
		_nPos := At( 'REMESSA', _cTmp )

		// Se encontrou o texto retirar o número do fornecimento, seguindo a regra que fica por
		// último na string separado por espaço
		if _nPos > 0

			_aNFor:=  strtokarr (substr(_cTmp, _nPos, len(_cTmp)), " ")
			if len(_aNFor) > 1

				_cNumFornec := _aNFor[02]
				SZ8->Z8_ZZDEDOT := _cNumFornec

			Endif

		Endif

		SZ8->Z8_STATUS	:= "I"

		//--- Emitente:
		SA1->(dbSetOrder(3))
		SA1->(dbSeek( xFilial("SA1") + Padr(oImpNfe:Emitente:_CNPJ:Text,Len(SA1->A1_CGC)) ))
		SZ8->Z8_CLIEMIT := SA1->A1_COD
		SZ8->Z8_LOJEMIT := SA1->A1_LOJA
		SZ8->Z8_EMITENT := oImpNfe:Emitente:_xNome:Text
		if Existblock("IsClienteDepositante")
			lDepositante := u_IsClienteDepositante(SA1->A1_COD, SA1->A1_LOJA)
		endif
		SZ8->(MsUnLock())

		//--- Itens:
		For nCont:=1 To Len(aItens)
			SB1->(dbSetOrder(1))
			If SB1->(dbSeek( xFilial("SB1") + Padr(aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_COD"}),2],Len(SB1->B1_COD)) ))
				RecLock("SZ9",.T.)
				SZ9->Z9_FILIAL 		:= xFilial("SZ9")
				SZ9->Z9_DOC			:= SZ8->Z8_DOC
				SZ9->Z9_SERIE		:= SZ8->Z8_SERIE
				SZ9->Z9_CLIENTE     := SZ8->Z8_CLIENTE
				SZ9->Z9_LOJA        := SZ8->Z8_LOJA
				SZ9->Z9_ITEM		:= StrZero(Val(aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_ITEM"}),2]),Len(SZ9->Z9_ITEM))
				SZ9->Z9_COD			:= SB1->B1_COD
				SZ9->Z9_UM			:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_UM"}),2]
				SZ9->Z9_QUANT		:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_QUANT"}),2]
				SZ9->Z9_PRCVEN		:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_VUNIT"}),2]
				SZ9->Z9_TOTAL		:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_TOTAL"}),2]
				SZ9->Z9_CF			:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_ZZCFOP"}),2]
				SZ9->Z9_TP   		:= If(aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_ZZCFOP"}),2] $ cCFLocacao,"L","C") //--- Locacal ou Comodato
				SZ9->Z9_LOTE		:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_LOTECTL"}),2]
				SZ9->Z9_DTVALID		:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_DTVALID"}),2]
				SZ9->Z9_DTFABR		:= aItens[nCont,ascan(aItens[nCont], {|x| x[1] == "D1_ZZDFABR"}),2]
				if !Empty(_cNumFornec)
					SZ9->Z9_ZZDEDOT	:= _cNumFornec
				Endif
				SZ9->(MsUnLock())
			Endif
		Next

		If /* SZ8->Z8_TPNF == "L" .or. */ lDepositante //Gravação de pedido para AGL estava desativado
			aAdd(aRetorno, xFilial("SZ8") + SZ8->Z8_DOC + SZ8->Z8_SERIE + SZ8->Z8_CLIENTE + SZ8->Z8_LOJA )
		Endif
	Else
		If lJob
			_cFunName := "AglImpXML"
			_cMsg     := "Nota já importada"
			_cDoc1    := oImpNfe:aCab[01,2]
			_cDoc2    := oImpNfe:aCab[02,2]
			_cDoc3    := cCliFor
			_cCodMsg  := "05"
			setFileLog(" ","fail",_cMsg)

			FWLogMsg("WARN", "LAST", "BusinessObject", funName(), "", "01", "Nota já importada. Verifique!", 0, 0, {})
			lRetorno := .F.
		Else
			Alert("Nota já importada. Verifique!")
			lRetorno := .F.
		EndIf
	Endif

Return aRetorno

	******************************************************************************************************************
Static Function geraPedido(nOpt, aPedido, oModel)
	******************************************************************************************************************
	Local nOperation:= 0

	If nOpt == 2 //--- Inclusao Manual
		FWFormCommit(oModel)
		nOperation:= oModel:GetOperation()

		If nOperation == 3
			If SZ8->Z8_TPNF == "L" .or. lDepositante
				aAdd(aPedido, xFilial("SZ8") + SZ8->Z8_DOC + SZ8->Z8_SERIE + SZ8->Z8_CLIENTE + SZ8->Z8_LOJA )
			Endif

		ElseIf nOperation == 5
			If SZ8->Z8_TPNF == "L"
				SC5->(dbSetOrder(1))
				SC5->(dbSeek( xFilial("SC5") + SZ8->Z8_PEDIDO ))
				GravaPed(5,nOpt)
			Endif
		Endif
	Endif

	If Len(aPedido) > 0
		SZ8->(dbSetOrder(1))
		If SZ8->(dbSeek( aPedido[1] ))
			SZ9->(dbSetOrder(1))
			If SZ9->(dbSeek( aPedido[1] ))
				GravaPed(3,nOpt)
			Endif
		Endif
	Endif

Return .T.

	******************************************************************************************************************
Static Function GravaPed(nOperacao,nOpt)
	******************************************************************************************************************
	Local aSC5 		:= {}
	Local aSC6 		:= {}
	Local aDetail 	:= {}
	Local cTes		:= ""
	Private lMsErroAuto	:= .F.

	If lDepositante
		//--- Cabecalho Pedido Venda:
		aAdd(aSC5,{"C5_FILIAL" 	, If(nOperacao == 5, SC5->C5_FILIAL , xFilial("SC5"))			,Nil})
		aAdd(aSC5,{"C5_NUM"	  	, If(nOperacao == 5, SC5->C5_NUM 	, getNextSalesOrderNumber()),Nil})
		aAdd(aSC5,{"C5_TIPO"   	, If(nOperacao == 5, SC5->C5_TIPO 	, "N")                      ,Nil})
		aAdd(aSC5,{"C5_CLIENTE"	, If(nOperacao == 5, SC5->C5_CLIENTE, SZ8->Z8_CLIENTE)  		,Nil})
		aAdd(aSC5,{"C5_LOJACLI"	, If(nOperacao == 5, SC5->C5_LOJACLI, SZ8->Z8_LOJA) 	 		,Nil})
		aAdd(aSC5,{"C5_CONDPAG"	, If(nOperacao == 5, SC5->C5_CONDPAG, Alltrim(GetMv("ZZ_CONDINT"))),Nil})
		aAdd(aSC5,{"C5_ZZNFTER"	, If(nOperacao == 5, SC5->C5_ZZNFTER, SZ8->Z8_DOC) 	 			,Nil}) //--- NF Origem
		aAdd(aSC5,{"C5_ZZSETER"	, If(nOperacao == 5, SC5->C5_ZZSETER, SZ8->Z8_SERIE)	 		,Nil}) //--- Série da NF Origem
		aAdd(aSC5,{"C5_ZZCLTER"	, If(nOperacao == 5, SC5->C5_ZZCLTER, SZ8->Z8_CLIENTE)  		,Nil}) //--- Emitente
		aAdd(aSC5,{"C5_ZZLJTER"	, If(nOperacao == 5, SC5->C5_ZZLJTER, SZ8->Z8_LOJA)  			,Nil}) //--- Loja do Emitente
		aAdd(aSC5,{"C5_ZZTPPV"	, If(nOperacao == 5, SC5->C5_ZZTPPV	, REMESSA_CONTA_ORDEM)  	,Nil}) //--- Tipo do Pedido
	Else
		aAdd(aSC5,{"C5_FILIAL" 	, If(nOperacao == 5, SC5->C5_FILIAL , xFilial("SC5"))			,Nil})
		aAdd(aSC5,{"C5_NUM"	  	, If(nOperacao == 5, SC5->C5_NUM 	, getNextSalesOrderNumber()),Nil})
		aAdd(aSC5,{"C5_TIPO"   	, If(nOperacao == 5, SC5->C5_TIPO 	, "N")                      ,Nil})
		aAdd(aSC5,{"C5_CLIENTE"	, If(nOperacao == 5, SC5->C5_CLIENTE, SZ8->Z8_CLIEMIT)  		,Nil})
		aAdd(aSC5,{"C5_LOJACLI"	, If(nOperacao == 5, SC5->C5_LOJACLI, SZ8->Z8_LOJEMIT) 	 		,Nil})
		aAdd(aSC5,{"C5_CONDPAG"	, If(nOperacao == 5, SC5->C5_CONDPAG, Alltrim(GetMv("ZZ_CONDINT"))),Nil})
		aAdd(aSC5,{"C5_ZZNFTER"	, If(nOperacao == 5, SC5->C5_ZZNFTER, SZ8->Z8_DOC) 	 			,Nil}) //--- NF Origem
		aAdd(aSC5,{"C5_ZZSETER"	, If(nOperacao == 5, SC5->C5_ZZSETER, SZ8->Z8_SERIE)	 		,Nil}) //--- Série da NF Origem
		aAdd(aSC5,{"C5_ZZCLTER"	, If(nOperacao == 5, SC5->C5_ZZCLTER, SZ8->Z8_CLIEMIT)  		,Nil}) //--- Emitente
		aAdd(aSC5,{"C5_ZZLJTER"	, If(nOperacao == 5, SC5->C5_ZZLJTER, SZ8->Z8_LOJEMIT)  		,Nil}) //--- Loja do Emitente
	EndIf
	//--- Itens Pedido Venda:
	If nOperacao == 5
		SC6->(dbSetOrder(1))
		SC6->(dbSeek( xFilial("SC6") + SC5->C5_NUM ))
		While SC6->(!Eof()) .and. SC6->C6_FILIAL == SC5->C5_FILIAL .and. SC6->C6_NUM == SC5->C5_NUM
			aDetail := {}
			aAdd(aDetail, {"C6_ITEM"	, SC6->C6_ITEM		, Nil})
			aAdd(aDetail, {"C6_PRODUTO"	, SC6->C6_PRODUTO	, Nil})
			aAdd(aDetail, {"C6_QTDVEN"	, SC6->C6_QTDVEN	, Nil})
			aAdd(aDetail, {"C6_PRCVEN"	, SC6->C6_PRCVEN	, Nil})
			aAdd(aDetail, {"C6_VALOR"	, SC6->C6_VALOR 	, Nil})
			aAdd(aDetail, {"C6_TES"		, SC6->C6_TES		, Nil})
			aAdd(aSC6, aDetail)
			SC6->(dbSkip())
		Enddo
	Else
		If lDepositante
			cTes := u_DHLMaTes(2,, SZ8->Z8_CLIENTE, SZ8->Z8_LOJA, "C",/*SZ9->Z9_COD*/)
		Else
			cTes := Alltrim(GetMv("ZZ_TESNFP4"))
		EndIf
		While SZ9->(!Eof()) .and. SZ9->Z9_FILIAL+SZ9->Z9_DOC+SZ9->Z9_SERIE+SZ9->Z9_CLIENTE+SZ9->Z9_LOJA == SZ8->Z8_FILIAL+SZ8->Z8_DOC+SZ8->Z8_SERIE+SZ8->Z8_CLIENTE+SZ8->Z8_LOJA
			aDetail := {}
			aAdd(aDetail, {"C6_ITEM"	, StrZero(Len(aSC6)+1,Len(SC6->C6_ITEM))			, Nil})
			aAdd(aDetail, {"C6_PRODUTO"	, SZ9->Z9_COD		, Nil})
			aAdd(aDetail, {"C6_QTDVEN"	, SZ9->Z9_QUANT		, Nil})
			aAdd(aDetail, {"C6_PRUNIT"	, SZ9->Z9_PRCVEN	, Nil})
			aAdd(aDetail, {"C6_PRCVEN"	, SZ9->Z9_PRCVEN	, Nil})
			aAdd(aDetail, {"C6_VALOR"	, A410Arred(SZ9->Z9_PRCVEN * SZ9->Z9_QUANT,"C6_VALOR") , Nil})
			aAdd(aDetail, {"C6_TES"		, cTes				, Nil})
			/* If !Empty(SZ9->Z9_LOTE)
				aAdd(aDetail, {"C6_LOTECTL"		, PadR(SZ9->Z9_LOTE, GetSx3Cache("C6_LOTECTL", "X3_TAMANHO"))			, Nil})
			EndIf
			If !Empty(SZ9->Z9_DTVALID)
				aAdd(aDetail, {"C6_DTVALID"		, PadR(SZ9->Z9_DTVALID, GetSx3Cache("C6_DTVALID", "X3_TAMANHO"))				, Nil})
			EndIf */
			// If !Empty(SZ9->Z9_DTFABR)
			// 	aAdd(aDetail, {"C6_DTFABR"		, SZ9->Z9_DTFABR				, Nil})
			// EndIf
			aAdd(aSC6, aDetail)
			SZ9->(dbSkip())
		Enddo
	Endif

	If Len(aSC5) > 0 .and. Len(aSC6) > 0

		lMsErroAuto := .F.
		MsExecAuto({|x,y,z| MATA410(x,y,z)}, aSC5, aSC6, nOperacao)

		If lMsErroAuto
//		    setFileLog(cFile,"fail","Falha ao incluir o pedido de vendas"+CRLF+CRLF+oUtils:getErroAuto())
		ElseIf nOperacao == 3
			RecLock("SZ8",.F.)
			SZ8->Z8_PEDIDO 	:= SC5->C5_NUM
			SZ8->(MsUnLOck())
//		    setFileLog(cFile,"fail","LOCAÇÃO Gerado pedido de venda no. "+SC5->C5_NUM)
//			Conout("***[AglImpXML]*** LOCAÇÃO","Gerado pedido de venda no. "+SC5->C5_NUM)
		ElseIf nOperacao == 5
			RecLock("SZ8",.F.)
			SZ8->Z8_PEDIDO 	:= " "
			SZ8->(MsUnLOck())
//		    setFileLog(cFile,"fail","EXCLUÍDO o pedido de venda no. "+SC5->C5_NUM)
//			Conout("***[AglImpXML]*** EXCLUÍDO o pedido de venda no. "+SC5->C5_NUM)
		EndIf
	Endif

Return Nil

	******************************************************************************************************************
Static Function getNextSalesOrderNumber()
	******************************************************************************************************************
	Local cMaxNumber  := ""
	Local cNextNumber := ""
	Local oSql		  := IpSqlObject():newIpSqlObject()

	oSql:newAlias(" SELECT MAX(C5_NUM) MAXNUMBER "+;
		" FROM %SC5.SQLNAME% "+;
		" WHERE %SC5.XFILIAL% ")

	cMaxNumber := oSql:getValue("MAXNUMBER")

	If Empty(cMaxNumber)
		cNextNumber := StrZero(1, Len(SC5->C5_NUM))
	Else
		cNextNumber := Soma1(cMaxNumber)
	EndIf

	oSql:close()

Return cNextNumber

	******************************************************************************************************************
Static Function Tela(cXML, cDirectory, cArquivo, cCFLocacao, cCFComod)
	******************************************************************************************************************
	Local oFont, oTela, oGrp1, oGet1, oGrp2, oGet2, oGrp3, oGet3, oBtn1, oBtn2
	Local lConfirma := .F.

	cCFLocacao	:= Alltrim(GetMv("ZZ_CFLOCAG")) //--- CFOP Locacao AGE
	cCFComod	:= Alltrim(GetMv("ZZ_CFCOMAG")) //--- CFOP Comodato AGE

	oFont:= TFont():New( "MS Sans Serif",0,-13,,.T.,0,,700,.F.,.F.,,,,,, )
	oTela:= MSDialog():New( 092,232,353,823,"Importa XML Terceiro",,,.F.,,,,,,.T.,,,.T. )

	oGrp1:= TGroup():New( 004,008,028,280,"CFOP Locação (ZZ_CFLOCAG):",oTela,CLR_BLACK,CLR_WHITE,.T.,.F. )
	oGet1:= TGet():New( 012,012,{|u| If(PCount()>0,cCFLocacao:=u,cCFLocacao)},oGrp1,264,010,'',,CLR_BLACK,CLR_WHITE,oFont,,,.T.,"",,,.F.,.F.,,.F.,.F.,"","cCFLocacao",,)
	oGet1:Disable()

	oGrp2:= TGroup():New( 040,008,064,280,"CFOP Comodato (ZZ_CFCOMAG):",oTela,CLR_BLACK,CLR_WHITE,.T.,.F. )
	oGet2:= TGet():New( 048,012,{|u| If(PCount()>0,cCFComod:=u,cCFComod)},oGrp2,264,010,'',,CLR_BLACK,CLR_WHITE,oFont,,,.T.,"",,,.F.,.F.,,.F.,.F.,"","cCFComod",,)
	oGet2:Disable()

	oGrp3:= TGroup():New( 076,008,100,280,"Arquivo XML:",oTela,CLR_BLACK,CLR_WHITE,.T.,.F. )
	oGet3:= TGet():New( 084,012,{|u| If(PCount()>0,cXML:=u,cXML)},oGrp3,264,010,'',,CLR_BLACK,CLR_WHITE,oFont,,,.T.,"",,,.F.,.F.,,.F.,.F.,"","cXML",,)
	oGet3:Disable()

	oBtn1:= TButton():New( 104,050,"Seleciona XML"  ,oTela,{|x| cXML := cGetFile('Arquivos (*.XML) | *.XML',"Selecione o arquivo para importação",0,,.F.,nOr(GETF_ONLYSERVER,GETF_LOCALHARD)), oGet3:Refresh()},060,012,,,,.T.,,"",,,,.F. )
	oBtn1:= TButton():New( 104,200,"OK"     		,oTela,{|x| oTela:End(), lConfirma:=.T.},037,012,,,,.T.,,"",,,,.F. )
	oBtn2:= TButton():New( 104,244,"Cancela"		,oTela,{|x| oTela:End()},037,012,,,,.T.,,"",,,,.F. )

	oTela:Activate(,,,.T.)

	If lConfirma .and. !Empty(cXML)
		cDirectory	:= Substr(cXML,1,Rat("\",cXML))
		cArquivo	:= Substr(cXML,Rat("\",cXML)+1,Len(cXML))

		If !Empty(cCFLocacao)
			PutMv("ZZ_CFLOCAG", cCFLocacao) //--- CFOP Locacao AGE
		Endif

		If !Empty(cCFComod)
			PutMv("ZZ_CFCOMAG",cCFComod) 	//--- CFOP Comodato AGE
		Endif
	Endif

Return Nil

/*
Retorna o codigo do cliente, com base no ID Extrangeiro.
*/

static function getCliEx(cIdEx)
	local aRet := {}
	local oSql	  	  	:= IpSqlObject():newIpSqlObject()
	local cQuery 		:= ""

	cQuery += " SELECT A1_COD, A1_LOJA  "		+CRLF
	cQuery += " 	FROM  " + RETSQLTAB("SA1")	+CRLF
	cQuery += " WHERE D_E_L_E_T_ = ' ' AND A1_FILIAL = '"+xFilial("SA1")+"'   "		+CRLF
	cQuery += " AND A1_PFISICA = '"+cIdEx+"' "  +CRLF

	oSql:newAlias(changeQuery(cQuery))

	if oSql:hasRecords()
		aRet := {oSql:getValue("A1_COD"),oSql:getValue("A1_LOJA")}
	endif

	oSql:Close()
return aRet

static function getFolder()
return AllTrim(oSql:getFieldValue("SZ1","Z1_DIRIMP","Z1_FILIAL = '%SZ1.FILIAL%' AND Z1_CODIGO = '" + APP_AUT + "'"))

static function loadCompanies()

	local aCompanies := {}
	local cCodEmp	 := ""
	local cCodFil	 := ""
	local cAliasSm0  := "QRYSM0"

	OpenSm0()//dbUseArea(.T.,nil,"sigamat.emp",cAliasSm0,.T.,.T.)

	/*
	(cAliasSm0)->(dbGoTop())
	while (cAliasSm0)->(!(Eof()))
		if (cAliasSm0)->M0_CODIGO != "99"
			if !(deleted())
				aAdd(aCompanies,{(cAliasSm0)->M0_CODIGO,(cAliasSm0)->M0_CODFIL,(cAliasSm0)->M0_CGC})
			endif
		endif
		(cAliasSm0)->(dbSkip())
	endDo
	(cAliasSm0)->(dbCloseArea())
	*/

	SM0->(dbGoTop())
	while SM0->(!eof())
		if SM0->M0_CODIGO != "99"
			if SM0->(!deleted())
				aAdd(aCompanies, {SM0->M0_CODIGO, SM0->M0_CODFIL, SM0->M0_CGC})
			endif
		endif
		SM0->(dbSkip())
	endDo

	SM0->(dbCloseArea())

return aCompanies

	***************************************************************
static function setFileLog(cFile,cLogType,cLogText,cTag,cValue)
	***************************************************************

	local cInterface := "IMPORTADOR XML"

	oLog:start(APP_DLX,DHL_IMPORTACAO,cFile)

	if !(Empty(cTag))
		cLogText += CRLF+CRLF+"Tag: "+cTag
	endIf

	if !(Empty(cValue))
		cLogText += CRLF+CRLF+"Valor: "+cValue
	endIf

	if (cLogType == "fail")
		oLog:fail(cInterface, cLogText)
	elseIf (cLogType == "warn")
		oLog:warn(cInterface, cLogText)
	endIf

return

	*********************************
static function getCnpj(oXmlUtil)
	*********************************
	Local _cCnpjEmit:= _cCnpjDest := ''
	Local _cCliSA5 	:= SuperGetMv( "ZZ_SA5XML" , .F. , " " ,  )
	local _lRet		:= .F.

// Outbound – Emitente Mahle Limeira > Importador XML Terceiro
	If !empty(oXmlUtil:getNodeValue("nfeproc:_nfe:_infnfe:_emit:_cnpj:text"))
		_cCnpjEmit	:=oXmlUtil:getNodeValue("nfeproc:_nfe:_infnfe:_emit:_cnpj:text")
	EndIF
// Inbound  – Destinatário Mahle Limeira > Importador XML
	If !empty(oXmlUtil:getNodeValue("nfeproc:_nfe:_infnfe:_dest:_cnpj:text"))
		_cCnpjDest  := oXmlUtil:getNodeValue("nfeproc:_nfe:_infnfe:_dest:_cnpj:text")
	EndIF

// Se encontrou CNPJ, pegar código cliente para verificar se consta parâmetro: ZZ_SA5XML 
	if !Empty(_cCnpjEmit) .or. !Empty(_cCnpjDest)

		// Verificando Outbound
		SA1->(dbSetOrder(3))
		If SA1->(dbSeek( xFilial("SA1") + Padr(_cCnpjEmit,Len(SA1->A1_CGC)) ))
			_lRet := Alltrim(SA1->A1_COD) + Alltrim(SA1->A1_LOJA) $ Alltrim(_cCliSA5)
		EndIF

		// Verificando Inbound
		if !_lRet

			If SA1->(dbSeek( xFilial("SA1") + Padr(_cCnpjDest,Len(SA1->A1_CGC)) ))
				_lRet := Alltrim(SA1->A1_COD) + Alltrim(SA1->A1_LOJA)  $ Alltrim(_cCliSA5)
			Endif

		Endif

	Endif

return _lRet

	*********************************************************************************************************************************************************************
User Function AglDesVTer() //--- Desvinculo chamado no PE SF2520E
	*********************************************************************************************************************************************************************
	Local cQuery := ""

	if !isRepair(SF2->F2_CLIENTE, SF2->F2_LOJA, SF2->F2_TIPO)

		If Select("QRY") <> 0
			QRY->(dbCloseArea())
		Endif

		//--- Desvincula Nota Fiscal
		if SF2->F2_ZZTPNF == RETORNO_SIMBOLICO
			cQuery += " SZ8.Z8_NFRET 	= '" + SF2->F2_DOC + "'"
			cQuery += " AND SZ8.Z8_SERRET 	= '" + SF2->F2_SERIE + "'"
			cQuery += " AND SZ8.Z8_CLIRET 	= '" + SF2->F2_CLIENTE + "'"
			cQuery += " AND SZ8.Z8_LOJRET 	= '" + SF2->F2_LOJA + "'"
		elseif SF2->F2_ZZTPNF == REMESSA_CONTA_ORDEM
			cQuery += " SZ8.Z8_NFRCO 	= '" + SF2->F2_DOC + "'"
			cQuery += " AND SZ8.Z8_SERRCO 	= '" + SF2->F2_SERIE + "'"
			cQuery += " AND SZ8.Z8_CLIRCO 	= '" + SF2->F2_CLIENTE + "'"
			cQuery += " AND SZ8.Z8_LOJRCO 	= '" + SF2->F2_LOJA + "'"
		endif

		If !Empty(cQuery)
			cQuery := "%" + cQuery + "%"

			BeginSql Alias "QRY"
				SELECT SZ8.Z8_DOC, SZ8.Z8_SERIE, SZ8.Z8_CLIENTE, SZ8.Z8_LOJA
				FROM %Table:SZ8% SZ8
				WHERE
					SZ8.Z8_FILIAL = %xFilial:SZ8% AND
					%Exp:cQuery% AND
					SZ8.%NotDel%
				GROUP BY SZ8.Z8_DOC, SZ8.Z8_SERIE, SZ8.Z8_CLIENTE, SZ8.Z8_LOJA
			EndSql

			QRY->(dbGoTop())
			If QRY->(!Eof())
				SZ8->(dbSetOrder(1))
				If SZ8->(dbSeek( xFilial("SZ8") + QRY->Z8_DOC + QRY->Z8_SERIE + QRY->Z8_CLIENTE + QRY->Z8_LOJA ))

					if SF2->F2_ZZTPNF == RETORNO_SIMBOLICO
						RecLock("SZ8",.F.)
						SZ8->Z8_NFRET  := ""
						SZ8->Z8_SERRET := ""
						SZ8->Z8_CLIRET := ""
						SZ8->Z8_LOJRET := ""

						SZ8->(MsUnLock())
					elseif SF2->F2_ZZTPNF == REMESSA_CONTA_ORDEM
						RecLock("SZ8",.F.)
						SZ8->Z8_NFRCO  := ""
						SZ8->Z8_SERRCO := ""
						SZ8->Z8_CLIRCO := ""
						SZ8->Z8_LOJRCO := ""

						SZ8->(MsUnLock())
					Endif
				Endif
			Endif

			If Select("QRY") <> 0
				QRY->(dbCloseArea())
			Endif
		Endif
	Endif

Return Nil


/**
* Verifica se o depositante é do tipo Reparador
**/
static function isRepair(cClieFor,cLoja,cTipo)
	
	local oSqlUtil	:= IpSqlObject():newIpSqlObject()
	local lRet	 	:= .f.
	
	if !(AllTrim(cTipo) $ "D/B")
		oSqlUtil:newTable("SA1", "A1_COD, A1_LOJA, A1_ZZREPAR", "A1_FILIAL = '%SA1.FILIAL%' AND A1_COD = '" + cClieFor + "' AND A1_LOJA = '" + cLoja + "' ")
		if oSqlUtil:hasRecords()
			if oSqlUtil:getValue("A1_ZZREPAR") == "S"
				lRet := .t.
			endIf
		endIf
	else
		oSqlUtil:newTable("SA2", "A2_COD, A2_LOJA, A2_ZZREPAR", "A2_FILIAL = '%SA2.FILIAL%' AND A2_COD = '" + cClieFor + "' AND A2_LOJA = '" + cLoja + "' ")
		if oSqlUtil:hasRecords()
			if oSqlUtil:getValue("A2_ZZREPAR") == "S"
				lRet := .t.
			endIf
		endIf
	endIf
	oSqlUtil:close()
	
return lRet
