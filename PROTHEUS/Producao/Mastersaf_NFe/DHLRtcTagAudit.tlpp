#include "tlpp-core.th"
#include "totvs.ch"

/*/{Protheus.doc} DHLRtcTagAudit
Auditoria de presenca das tags da Reforma Tributaria no XML intermediario
gerado pelo XmlNfeSef (nfesefaz.prw), consumido pelo ProcMsaNFe/ProcRCOMsa.

Controle compensatorio da PREMISSA-01 do Plano_Execucao_NFe_2027_IBS_CBS.md:
o plano assume que o pacote TOTVS entrega as tags das NT 2025.002 v1.53 e
2026.008 v1.01. Como IpXmlObject:getNodeValue devolve "" para no inexistente,
sem erro, a ausencia de uma tag e silenciosa e so apareceria na rejeicao da
SEFAZ. Esta rotina registra em log cada tag esperada que nao veio no XML.

Nao altera o XML nem o TXT: apenas observa e registra.

Os caminhos seguem a regra de conversao documentada em
Dimensionamento_Forks_NFe_2027.md secao 3: no caminho do XML oficial,
det/imposto/<TRIBUTO> vira "tributo", e os niveis se juntam com ":_".

@type  function
@author Pablo Regis
@since 18/11/2026
@param oXmlUtil, object, objeto IpXmlObject com o XML ja parseado
@param cDoc,     character, numero do documento, so para o log
@param cSerie,   character, serie do documento, so para o log
@param cFinNfe,  character, finalidade da NF-e; se vazio, le do proprio XML
@return logical, .T. quando todas as tags esperadas estao presentes
/*/
User Function DHLRtcTagAudit(oXmlUtil, cDoc, cSerie, cFinNfe)

	Local aEsperadas := {}
	Local aAusentes  := {}
	Local cTpNFDeb   := ""
	Local cTpNFCre   := ""
	Local cCenario   := ""
	Local cMsg       := ""
	Local cLista     := ""
	Local nI         := 0
	Local lRet       := .T.
	Local lAtivo     := GetNewPar("ZZ_RTCAUDI", .T.)
	Local dCorte     := SuperGetMv("MV_RTC55", .F., SToD("20260105"))

	Default cDoc    := ""
	Default cSerie  := ""
	Default cFinNfe := ""

	// Fora da vigencia da reforma ou auditoria desligada: nada a fazer
	If !lAtivo .Or. dDataBase < dCorte
		Return .T.
	EndIf

	If ValType(oXmlUtil) != "O"
		FWLogMsg("WARN", , "BusinessObject", FunName(), "", "RTC", ;
			"Auditoria de tags: objeto XML invalido para o documento " + ;
			AllTrim(cDoc) + "/" + AllTrim(cSerie), 0, 0, {})
		Return .F.
	EndIf

	If Empty(cFinNfe)
		cFinNfe := AllTrim(oXmlUtil:getNodeValue("infnfe:_ide:_finNFe:text"))
	EndIf

	cTpNFDeb := AllTrim(oXmlUtil:getNodeValue("infnfe:_ide:_tpNFDebito:text"))
	cTpNFCre := AllTrim(oXmlUtil:getNodeValue("infnfe:_ide:_tpNFCredito:text"))

	aEsperadas := getEsperadas(cFinNfe, cTpNFDeb, cTpNFCre)
	cCenario   := getCenario(cFinNfe, cTpNFDeb, cTpNFCre)
	aAusentes  := getAusentes(oXmlUtil, aEsperadas)

	If Len(aAusentes) > 0
		lRet := .F.
		For nI := 1 To Len(aAusentes)
			If nI > 1
				cLista += ", "
			EndIf
			cLista += aAusentes[nI]
		Next nI

		cMsg := "Auditoria de tags RTC: documento " + AllTrim(cDoc) + "/" + ;
			AllTrim(cSerie) + " (" + cCenario + ") sem as tags esperadas: " + cLista

		FWLogMsg("WARN", , "BusinessObject", FunName(), "", "RTC", cMsg, 0, 0, {})
	Else
		FWLogMsg("INFO", , "BusinessObject", FunName(), "", "RTC", ;
			"Auditoria de tags RTC: documento " + AllTrim(cDoc) + "/" + ;
			AllTrim(cSerie) + " (" + cCenario + ") com todas as " + ;
			cValToChar(Len(aEsperadas)) + " tags esperadas", 0, 0, {})
	EndIf

Return lRet


/*/{Protheus.doc} getEsperadas
Monta a lista de tags esperadas para o cenario, conforme
Inventario_Tags_NFe_2027.md.

Cada elemento e { cTagLog, cCaminho, lNivelItem }, onde lNivelItem indica que
o no fica sob "det" e por isso precisa ser testado tambem com indice [1].

@type  function
@author Pablo Regis
@since 18/11/2026
@param cFinNfe,  character, finalidade da NF-e
@param cTpNFDeb, character, tipo da nota de debito
@param cTpNFCre, character, tipo da nota de credito
@return array, lista de tags esperadas
/*/
Static Function getEsperadas(cFinNfe, cTpNFDeb, cTpNFCre)

	Local aEsp    := {}
	Local cTribIS := GetNewPar("ZZ_TRIBIS", "IS")

	// Exigidas em todos os 11 cenarios
	aAdd(aEsp, {"vUnComLiq" , "infnfe:_det:_prod:_vUnComLiq"  , .T.})
	aAdd(aEsp, {"vProdLiq"  , "infnfe:_det:_prod:_vProdLiq"   , .T.})
	aAdd(aEsp, {"vProdLiqTot", "infnfe:_total:_vProdLiqTot"   , .F.})

	// Debito e credito: o tipo da nota identifica a operacao
	If cFinNfe == "6" .And. !Empty(cTpNFDeb)
		aAdd(aEsp, {"tpNFDebito", "infnfe:_ide:_tpNFDebito", .F.})
	EndIf
	If cFinNfe == "5" .And. !Empty(cTpNFCre)
		aAdd(aEsp, {"tpNFCredito", "infnfe:_ide:_tpNFCredito", .F.})
	EndIf

	// DFe referenciado: devolucao, credito 06 e debitos 03, 04 e 07
	// INICIO Pablo Regis 21/11/2026 - matriz de referenciamento do anexo 4 (NT v1.53),
	// restrita ao escopo do FDD IM04: credito 01/03/04 e debito 02/03/04/06.
	// Por item e obrigatorio apenas no debito 03 e 04. No credito 01/03/04 e no
	// debito 02 e 06 e PROIBIDO - informar gera rejeicao 1039/1042.
	If cFinNfe == "6" .And. cTpNFDeb $ "03|04"
		aAdd(aEsp, {"DFeReferenciado", "infnfe:_det:_DFeReferenciado", .T.})
		aAdd(aEsp, {"chaveAcesso", "infnfe:_det:_DFeReferenciado:_chaveAcesso", .T.})
	EndIf
	// FIM Pablo Regis 21/11/2026

	// Debito 03: ajuste de competencia no lugar do gIBSCBS
	If cFinNfe == "6" .And. cTpNFDeb == "03"
		aAdd(aEsp, {"gAjusteCompet", "infnfe:_det:_imposto:_tributo:_gAjusteCompet", .T.})
	EndIf

	// Debito 07: estorno de credito no lugar do gIBSCBS
	// FORA DE ESCOPO FDD IM04 - debito 07 - Pablo Regis 21/11/2026
	If .F. .And. cFinNfe == "6" .And. cTpNFDeb == "07"
		aAdd(aEsp, {"gEstornoCred", "infnfe:_det:_imposto:_tributo:_gEstornoCred", .T.})
	EndIf

	// Debito 06: ICMS previsto de pagamento antecipado
	If cFinNfe == "6" .And. cTpNFDeb == "06"
		aAdd(aEsp, {"ICMSPrevistoPagtoAntecip", ;
			"infnfe:_det:_imposto:_tributo:_ICMSPrevistoPagtoAntecip", .T.})
		aAdd(aEsp, {"vICMSPrevisto", ;
			"infnfe:_det:_imposto:_tributo:_ICMSPrevistoPagtoAntecip:_vICMSPrevisto", .T.})
	EndIf

	// IBSCBS e seus totais: todos os cenarios menos os debitos 03 e 07
	// Pablo Regis 21/11/2026 - 07 fora do escopo IM04; so o debito 03 dispensa o gIBSCBS
	If !(cFinNfe == "6" .And. cTpNFDeb == "03")
		aAdd(aEsp, {"gIBSCBS", "infnfe:_det:_imposto:_tributo:_gIBSCBS", .T.})
		aAdd(aEsp, {"IBSCBSTot", "infnfe:_total:_IBSCBSTot", .F.})
	EndIf

	// Imposto Seletivo: o codigo do tributo vem de parametro, ver
	// Dimensionamento_Forks_NFe_2027.md secao 3.3
	If !Empty(cTribIS)
		aAdd(aEsp, {"ISTot", "infnfe:_total:_ISTot", .F.})
	EndIf

Return aEsp


/*/{Protheus.doc} getAusentes
Testa cada tag esperada no XML e devolve os nomes das que nao existem.

Para no de nivel item, testa o caminho sem indice e com [1], porque o
IpXmlObject devolve objeto quando ha um unico item e array quando ha varios.

@type  function
@author Pablo Regis
@since 18/11/2026
@param oXmlUtil,  object, objeto IpXmlObject
@param aEsperadas, array, lista produzida por getEsperadas
@return array, nomes das tags ausentes
/*/
Static Function getAusentes(oXmlUtil, aEsperadas)

	Local aAusentes := {}
	Local cCaminho  := ""
	Local cIndexado := ""
	Local lExiste   := .F.
	Local nI        := 0

	For nI := 1 To Len(aEsperadas)

		cCaminho := aEsperadas[nI][2]
		lExiste  := oXmlUtil:existNode(cCaminho)

		If !lExiste .And. aEsperadas[nI][3]
			cIndexado := StrTran(cCaminho, "infnfe:_det:", "infnfe:_det[1]:")
			lExiste   := oXmlUtil:existNode(cIndexado)
		EndIf

		If !lExiste
			aAdd(aAusentes, aEsperadas[nI][1])
		EndIf

	Next nI

Return aAusentes


/*/{Protheus.doc} getCenario
Devolve o rotulo do cenario, para o log, conforme a numeracao dos 11
exemplos de Inventario_Tags_NFe_2027.md.

@type  function
@author Pablo Regis
@since 18/11/2026
@param cFinNfe,  character, finalidade da NF-e
@param cTpNFDeb, character, tipo da nota de debito
@param cTpNFCre, character, tipo da nota de credito
@return character, rotulo do cenario
/*/
Static Function getCenario(cFinNfe, cTpNFDeb, cTpNFCre)

	Local cRet := "finNFe=" + cFinNfe

	Do Case
		Case cFinNfe == "1"
			cRet := "1 venda"
		Case cFinNfe == "2"
			cRet := "5 complementar"
		Case cFinNfe == "3"
			cRet := "6 ajuste"
		Case cFinNfe == "4"
			cRet := "4 devolucao"
		Case cFinNfe == "5"
			cRet := "credito " + cTpNFCre
		Case cFinNfe == "6"
			cRet := "debito " + cTpNFDeb
	EndCase

Return cRet
